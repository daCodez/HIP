{
  "manifest_version": 3,
  "name": "HIP Browser Protection",
  "description": "Human Interactive Protocol website and link trust checks.",
  "version": "0.1.34",
  "action": {
    "default_title": "Open HIP side panel"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/riskBadgeRenderer.js",
        "src/safetyPageRouter.js",
        "src/browserPrivacyGuards.js",
        "src/browserScanAssessment.js",
        "src/formalScoring.js",
        "src/contentMessageContracts.js",
        "src/xrayRules.js",
        "src/xrayRenderer.js",
        "src/xrayController.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.guardwithhip.com/*",
    "https://guardwithhip.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
  },
  "icons": {
    "16": "assets/icons/hip-16.svg",
    "32": "assets/icons/hip-32.svg",
    "48": "assets/icons/hip-48.svg",
    "128": "assets/icons/hip-128.svg"
  }
}
