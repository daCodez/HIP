@page "/admin/review"
@page "/admin/review/{ReviewItemId}"
@attribute [Authorize(Policy = AdminPolicies.CanViewReviews)]
@rendermode InteractiveServer
@inject IReviewQueueService ReviewQueueService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment HostEnvironment

<PageTitle>HIP Review Queue</PageTitle>

<main class="admin-rule-page">
    <section class="admin-rule-header">
        <p class="eyebrow">Admin MVP</p>
        <h1>Review Queue</h1>
        <p>Review suspicious findings, generated rules, false positives, safety reports, and risky admin decisions using privacy-safe summaries only.</p>
        @if (HostEnvironment.IsDevelopment())
        {
            <AuthorizeView Policy="@AdminPolicies.CanDecideReviews">
                <Authorized>
                    <button type="button" @onclick="CreateSample">Create Sample Review</button>
                </Authorized>
            </AuthorizeView>
        }
    </section>

    @if (_message is not null)
    {
        <p class="admin-message" role="status">@_message</p>
    }

    @if (_selected is not null)
    {
        <section class="rule-builder-panel">
            <h2>Review Detail</h2>
            <dl class="lookup-details">
                <dt>ID</dt><dd>@_selected.ReviewItemId</dd>
                <dt>Type</dt><dd>@_selected.ReviewType</dd>
                <dt>Target</dt><dd>@_selected.TargetType: @_selected.TargetId</dd>
                <dt>Status</dt><dd>@_selected.Status</dd>
                <dt>Reason Summary</dt><dd>@_selected.Summary</dd>
                <dt>Evidence Summary</dt><dd>@_selected.EvidenceSummary</dd>
                <dt>Decision</dt><dd>@_selected.Decision @_selected.DecisionReason</dd>
            </dl>
        </section>
    }

    <section class="rule-builder-panel">
        <h2>Open Reviews</h2>
        <table class="admin-rule-table">
            <thead>
                <tr><th>Type</th><th>Target</th><th>Risk</th><th>Priority</th><th>Status</th><th>Created</th><th>Recommended Action</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.ReviewType</td>
                        <td>@item.TargetType: @item.TargetId</td>
                        <td>@item.RiskLevel</td>
                        <td>@item.Priority</td>
                        <td>@item.Status</td>
                        <td>@item.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                        <td>@item.RecommendedAction</td>
                        <td>
                            <AuthorizeView Policy="@AdminPolicies.CanDecideReviews">
                                <Authorized>
                                    <button type="button" @onclick="() => Approve(item.ReviewItemId)">Approve</button>
                                    <button type="button" @onclick="() => Reject(item.ReviewItemId)">Reject</button>
                                    <button type="button" @onclick="() => MoreInfo(item.ReviewItemId)">More Info</button>
                                </Authorized>
                                <NotAuthorized><span>View only</span></NotAuthorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</main>

@code {
    [Parameter]
    public string? ReviewItemId { get; set; }

    private IReadOnlyCollection<ReviewItem> _items = [];
    private ReviewItem? _selected;
    private string? _message;

    protected override void OnInitialized() => Refresh();

    protected override void OnParametersSet() => Refresh();

    private void Refresh()
    {
        _items = ReviewQueueService.List();
        _selected = string.IsNullOrWhiteSpace(ReviewItemId) ? null : ReviewQueueService.Get(ReviewItemId);
    }

    private Task CreateSample() =>
        RunAuthorizedMutationAsync(actor => ReviewQueueService.Create(new ReviewItem(
            "",
            ReviewType.RiskyDomain,
            TargetType.Domain,
            "suspicious-example.com",
            "Review repeated suspicious domain findings",
            "Multiple privacy-safe findings indicate shortened URL abuse.",
            RiskStatus.HighRisk,
            ReviewStatus.Submitted,
            ReviewPriority.High,
            DateTimeOffset.UtcNow,
            DateTimeOffset.UtcNow,
            actor,
            null,
            "self-healing",
            "URL hashes and domain risk reason only.",
            new Dictionary<string, string> { ["urlHash"] = "sha256:sample", ["evidenceType"] = "anonymized-finding" },
            "Keep generated rule in watch mode pending approval.",
            null,
            null)),
            developmentOnly: true);

    private Task Approve(string id) =>
        RunAuthorizedMutationAsync(actor => ReviewQueueService.Approve(
            id,
            actor,
            "Reviewed evidence summary and approved recommended action."));

    private Task Reject(string id) =>
        RunAuthorizedMutationAsync(actor => ReviewQueueService.Reject(
            id,
            actor,
            "Evidence is insufficient for this action."));

    private Task MoreInfo(string id) =>
        RunAuthorizedMutationAsync(actor => ReviewQueueService.RequestMoreInfo(
            id,
            actor,
            "Need more privacy-safe evidence before decision."));

    /// <summary>
    /// Reauthorizes the current circuit immediately before a direct review mutation.
    /// </summary>
    private async Task RunAuthorizedMutationAsync(
        Func<string, ReviewItem> mutation,
        bool developmentOnly = false)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var result = await HipAdminPageAccess.ExecuteAuthorizedAsync(
            authenticationState.User,
            AuthorizationService,
            HostEnvironment,
            AdminPolicies.CanDecideReviews,
            mutation,
            developmentOnly);
        if (!result.Succeeded)
        {
            _message = HipAdminPageAccess.AccessUnavailableMessage;
            return;
        }

        _message = null;
        Refresh();
    }
}
