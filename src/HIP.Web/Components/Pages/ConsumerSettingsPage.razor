@page "/consumer/settings"
@page "/consumer/alerts"
@attribute [Authorize(Policy = ConsumerPolicies.CanUseConsumerPortal)]
@rendermode InteractiveServer
@inject IConsumerPortalService ConsumerPortalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

<PageTitle>HIP Consumer Settings</PageTitle>

<main class="admin-rule-page">
    <section class="admin-rule-header">
        <div>
            <p class="eyebrow">Consumer Portal</p>
            <h1>Alert Settings</h1>
            <p>Encrypted owner-scoped alert settings for connected clients. They do not collect message contents.</p>
        </div>
    </section>

    <section class="rule-builder-panel">
        <label><input type="checkbox" @bind="_enablePopupAlerts" /> Enable popup alerts</label>
        <label><input type="checkbox" @bind="_enablePrivateWarnings" /> Enable private warnings</label>
        <label><input type="checkbox" @bind="_enableSafetyPageRouting" /> Enable safety page routing</label>
        <label>
            Scan mode
            <select @bind="_scanMode">
                <option>Quiet</option>
                <option>Normal</option>
                <option>Strict</option>
                <option>Paranoid</option>
            </select>
        </label>
        <button class="primary-button" @onclick="SaveAsync" disabled="@(_accessError is not null)">Save Settings</button>
        @if (_accessError is not null)
        {
            <p class="admin-message" role="alert">@_accessError</p>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="admin-message">@_message</p>
        }
    </section>
</main>

@code {
    private bool _enablePopupAlerts = true;
    private bool _enablePrivateWarnings = true;
    private bool _enableSafetyPageRouting = true;
    private string _scanMode = "Normal";
    private string _message = string.Empty;
    private string? _accessError;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var access = await HipConsumerPageAccess.ExecuteAsync(
            authenticationState.User,
            consumerId => ConsumerPortalService.GetSettingsAsync(consumerId, CancellationToken.None));
        if (!access.Succeeded || access.Value is null)
        {
            _accessError = HipConsumerPageAccess.AccessUnavailableMessage;
            return;
        }

        Apply(access.Value);
    }

    private async Task SaveAsync()
    {
        _message = string.Empty;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
            authenticationState.User,
            AuthorizationService,
            ConsumerPolicies.CanUseConsumerPortal,
            consumerId => ConsumerPortalService.SaveSettingsAsync(
                consumerId,
                new ConsumerSettings(
                    _enablePopupAlerts,
                    _enablePrivateWarnings,
                    _enableSafetyPageRouting,
                    _scanMode),
                CancellationToken.None));
        if (!access.Succeeded || access.Value is null)
        {
            _accessError = HipConsumerPageAccess.AccessUnavailableMessage;
            return;
        }

        _accessError = null;
        var result = access.Value;
        _message = result.Message;
        if (result.Settings is not null)
        {
            Apply(result.Settings);
        }
    }

    private void Apply(ConsumerSettings settings)
    {
        _enablePopupAlerts = settings.EnablePopupAlerts;
        _enablePrivateWarnings = settings.EnablePrivateWarnings;
        _enableSafetyPageRouting = settings.EnableSafetyPageRouting;
        _scanMode = settings.ScanMode;
    }
}
