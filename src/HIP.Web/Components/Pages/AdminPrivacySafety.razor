@page "/admin/privacy"

@attribute [Authorize(Policy = AdminPolicies.CanViewAdminDashboard)]

<PageTitle>HIP Privacy & Safety</PageTitle>

<section class="hip-page-heading compact">
    <div>
        <h1>Privacy & Safety</h1>
        <p>How HIP handles data, and how users stay in control.</p>
    </div>
</section>

<section class="hip-privacy-callout">
    <strong>HIP is built privacy-first</strong>
    <p>HIP scans metadata and risk patterns, not the contents of personal conversations. HIP must never train AI models on private messages by default.</p>
</section>

<section class="hip-two-column">
    <article class="hip-panel padded">
        <h2>What HIP Collects</h2>
        <ul class="hip-check-list">
            <li>Message risk scores, not full message text</li>
            <li>Sender reputation signals</li>
            <li>Link scan results</li>
            <li>Platform connection metadata</li>
            <li>Rule trigger counts</li>
            <li>Privacy-safe scan history</li>
        </ul>
    </article>

    <article class="hip-panel padded">
        <h2>What HIP Never Collects</h2>
        <ul class="hip-x-list">
            <li>Full private message content</li>
            <li>Contacts list</li>
            <li>Login credentials</li>
            <li>Payment information</li>
            <li>Private keys or signatures</li>
            <li>Location data</li>
        </ul>
    </article>
</section>

<section class="hip-panel padded narrow">
    <div class="hip-panel-heading flush">
        <div>
            <h2>Local-Only Mode</h2>
            <p>Process scans locally without sending data to HIP servers. Requires a future HIP desktop client.</p>
        </div>
        <span class="hip-toggle disabled"></span>
    </div>
</section>

<section class="hip-panel padded narrow">
    <h2>Data Retention</h2>
    <p>Normal risky findings target roughly 90 days of retention. Confirmed dangerous patterns can be retained longer. User-linked or private data should use the shortest practical retention period.</p>
</section>

<section class="hip-panel padded" aria-labelledby="compliance-readiness-heading">
    <div class="hip-panel-heading flush">
        <div>
            <h2 id="compliance-readiness-heading">Compliance Readiness</h2>
            <p>Implementation evidence for operator review. These indicators are not legal advice, an attestation, or a certification.</p>
        </div>
        <span class="hip-status warning">Not certified</span>
    </div>

    <div class="hip-table-wrap">
        <table class="hip-data-table">
            <caption>Framework readiness based on HIP's implemented privacy, security, and audit controls.</caption>
            <thead>
                <tr><th scope="col">Framework</th><th scope="col">Current position</th><th scope="col">Evidence focus</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">PIPEDA</th><td>Readiness support</td><td>Data minimization, purpose limits, retention, access control, and audit records</td></tr>
                <tr><th scope="row">ISO/IEC 27001:2022</th><td>Not certified</td><td>Security controls and evidence can support a future independent assessment</td></tr>
                <tr><th scope="row">HIPAA</th><td>Applicability depends on deployment and data use</td><td>No claim is made that a deployment handles protected health information compliantly</td></tr>
                <tr><th scope="row">OWASP ASVS 5.0</th><td>Engineering reference</td><td>Application-security requirements guide implementation and testing; no formal verification claim</td></tr>
            </tbody>
        </table>
    </div>
</section>
