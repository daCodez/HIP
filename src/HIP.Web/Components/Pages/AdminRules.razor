@page "/admin/rules"
@page "/admin/rules/new"
@page "/admin/rules/{RuleId}"
@attribute [Authorize(Policy = AdminPolicies.CanManageRules)]
@rendermode InteractiveServer
@inject IRuleJsonService RuleJsonService
@inject IAdminRuleService AdminRuleService
@inject IRuleRepository RuleRepository
@inject IAdminSiteSafetyRuleRepository SiteSafetyRuleRepository
@inject AdminSiteSafetyRuleService SiteSafetyRuleService
@inject IRuleSimulationResultRepository SimulationRepository
@inject RuleApprovalWorkflowService ApprovalWorkflowService
@inject RuleDeploymentService DeploymentService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JavaScript

<PageTitle>HIP Admin Rule Builder</PageTitle>

<main class="admin-rule-page">
    <section class="admin-rule-header">
        <p class="eyebrow">Trust operations</p>
        <h1>Admin Rule Builder</h1>
        <p>Create simple HIP rules, inspect live JSON, run simulation, and save rules. This route is protected by the rule-management admin policy.</p>
    </section>

    <section class="rule-builder-grid">
        <div class="rule-builder-panel">
            <h2>Simple Rule Form</h2>
            <label>Name <input @bind="_form.Name" @bind:after="SyncJsonFromForm" /></label>
            <label>Description <textarea @bind="_form.Description" @bind:after="SyncJsonFromForm"></textarea></label>

            <div class="form-row">
                <label><input type="checkbox" @bind="_form.Enabled" @bind:after="SyncJsonFromForm" /> Enabled</label>
                <label><input type="checkbox" @bind="_form.RequiresApproval" @bind:after="SyncJsonFromForm" /> Requires approval</label>
                <label><input type="checkbox" @bind="_form.SimulationRequired" @bind:after="SyncJsonFromForm" /> Simulation required</label>
            </div>

            <div class="form-row">
                <label>Mode
                    <select @bind="_form.Mode" @bind:after="SyncJsonFromForm">
                        @foreach (var mode in RuleBuilderFormModel.SupportedModes)
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </label>
                <label>Severity
                    <select @bind="_form.Severity" @bind:after="SyncJsonFromForm">
                        @foreach (var severity in RuleBuilderFormModel.MvpSeverities)
                        {
                            <option value="@severity">@severity</option>
                        }
                    </select>
                </label>
            </div>

            <h3>IF / AND Conditions</h3>
            @foreach (var condition in _form.Conditions)
            {
                <div class="condition-row">
                    <select @bind="condition.Field" @bind:after="SyncJsonFromForm">
                        @foreach (var field in SupportedRuleFields.Values)
                        {
                            <option value="@field">@field</option>
                        }
                    </select>
                    <select @bind="condition.Operator" @bind:after="SyncJsonFromForm">
                        @foreach (var ruleOperator in Enum.GetValues<RuleOperator>())
                        {
                            <option value="@ruleOperator">@ruleOperator</option>
                        }
                    </select>
                    <input @bind="condition.Value" @bind:after="SyncJsonFromForm" aria-label="Condition value" />
                    <button type="button" @onclick="() => RemoveCondition(condition)">Remove</button>
                </div>
            }
            <button type="button" @onclick="AddCondition">Add Condition</button>

            <h3>THEN Actions</h3>
            @foreach (var action in _form.Actions)
            {
                <div class="condition-row">
                    <select @bind="action.Type" @bind:after="SyncJsonFromForm">
                        @foreach (var actionType in RuleBuilderFormModel.MvpActions)
                        {
                            <option value="@actionType">@actionType</option>
                        }
                    </select>
                    <input @bind="action.Value" @bind:after="SyncJsonFromForm" aria-label="Action value" />
                    <button type="button" @onclick="() => RemoveAction(action)">Remove</button>
                </div>
            }
            <button type="button" @onclick="AddAction">Add Action</button>
        </div>

        <div class="rule-builder-panel">
            <h2>Live JSON Preview</h2>
            @if (_advancedMode)
            {
                <textarea class="json-editor" @bind="_json"></textarea>
                @if (_jsonError is not null)
                {
                    <p class="lookup-error">@_jsonError</p>
                }
            }
            else
            {
                <pre class="json-preview">@_json</pre>
            }

            <div class="button-row">
                <button type="button" @onclick="SaveRule">Save Rule</button>
                <button type="button" @onclick="RunSimulation">Run Simulation</button>
                <button type="button" @onclick="EnableRule">Enable Rule</button>
                <button type="button" @onclick="DisableRule">Disable Rule</button>
                <button type="button" @onclick="ValidateJson">Validate JSON</button>
                <button type="button" @onclick="CopyJsonAsync">Copy JSON</button>
                <button type="button" @onclick="EditJson">Edit JSON</button>
                <button type="button" @onclick="RestoreFormView">Restore Form View</button>
            </div>

            @if (_message is not null)
            {
                <p class="admin-message">@_message</p>
            }
        </div>
    </section>

    <section class="rule-builder-panel">
        <h2>Approval and Deployment</h2>
        <p>A saved rule version needs a persisted passing simulation before approval. Approvers must be independent of the creator. High-impact rules require two approvers and start in watch mode; critical rules also require a tested rollback and manual deployment authorization.</p>

        <label>Transition reason
            <input @bind="_transitionReason" maxlength="500" placeholder="Explain the security decision" />
        </label>

        <div class="button-row">
            <button type="button" @onclick="RequestApprovalAsync" disabled="@(_simulation is null || !_simulation.Passed)">Request Approval</button>
            <button type="button" @onclick="ApproveAsync" disabled="@(_workflow is null || _workflow.Approvals.Count >= _workflow.RequiredApprovalCount)">Approve Version</button>
            <button type="button" @onclick="CompleteRollbackTestAsync" disabled="@(_workflow?.RollbackTestRequired != true || _workflow.RollbackTestCompleted)">Record Rollback Test</button>
            <button type="button" @onclick="AuthorizeManualDeploymentAsync" disabled="@(_workflow?.ManualDeploymentRequired != true || _workflow.ManualDeploymentAuthorized)">Authorize Manual Deployment</button>
            <button type="button" @onclick="ActivateAsync" disabled="@(_workflow is null || !RuleApprovalWorkflowService.CanActivate(_workflow))">Activate Approved Version</button>
            <button type="button" @onclick="PromoteAsync" disabled="@(_deployment?.Status != RuleDeploymentStatus.Watch)">Promote Watch to Active</button>
            <button type="button" @onclick="RollbackAsync" disabled="@(_deployment?.RollbackAvailable != true)">Rollback</button>
        </div>

        @if (_workflow is null)
        {
            <p>No approval workflow is selected in this session.</p>
        }
        else
        {
            <div class="simulation-grid">
                <span>Rule version: <strong>@_workflow.RuleVersion</strong></span>
                <span>Impact: <strong>@_workflow.ImpactLevel</strong></span>
                <span>Approvals: <strong>@_workflow.Approvals.Count / @_workflow.RequiredApprovalCount</strong></span>
                <span>Status: <strong>@_workflow.Status</strong></span>
                <span>Rollback test: <strong>@(_workflow.RollbackTestRequired ? (_workflow.RollbackTestCompleted ? "Complete" : "Required") : "Not required")</strong></span>
                <span>Manual deployment: <strong>@(_workflow.ManualDeploymentRequired ? (_workflow.ManualDeploymentAuthorized ? "Authorized" : "Required") : "Not required")</strong></span>
            </div>
        }

        @if (_deployment is not null)
        {
            <div class="simulation-grid">
                <span>Deployed version: <strong>@(_deployment.ActiveRule?.Version.ToString() ?? "Disabled")</strong></span>
                <span>Deployment state: <strong>@_deployment.Status</strong></span>
                <span>Rollback target: <strong>@(_deployment.RollbackRule?.Version.ToString() ?? (_deployment.UseDisabledRollback ? "Disabled" : "None"))</strong></span>
                <span>State version: <strong>@_deployment.Version</strong></span>
            </div>
        }
    </section>

    <section class="rule-builder-panel">
        <h2>Simulation Results</h2>
        @if (_simulation is null)
        {
            <p>No simulation run yet.</p>
        }
        else
        {
            <div class="simulation-grid">
                <span>Passed: <strong>@_simulation.Passed</strong></span>
                <span>Total: <strong>@_simulation.TotalTestCases</strong></span>
                <span>Passed count: <strong>@_simulation.PassedCount</strong></span>
                <span>Failed count: <strong>@_simulation.FailedCount</strong></span>
                <span>Detection rate: <strong>@_simulation.DetectionRate</strong></span>
                <span>False positive risk: <strong>@_simulation.FalsePositiveRisk</strong></span>
                <span>False negative risk: <strong>@_simulation.FalseNegativeRisk</strong></span>
                <span>Speed impact: <strong>@_simulation.SpeedImpact</strong></span>
                <span>Privacy impact: <strong>@_simulation.PrivacyImpact</strong></span>
                <span>Confidence: <strong>@_simulation.ConfidenceScore</strong></span>
                <span>Recommended action: <strong>@_simulation.RecommendedAction</strong></span>
                <span>Recommended mode: <strong>@_simulation.RecommendedMode</strong></span>
            </div>

            @foreach (var failed in _simulation.CaseResults.Where(result => !result.Passed))
            {
                <p class="lookup-error">@failed.Name: @failed.FailureReason</p>
            }
        }
    </section>

    <section class="rule-builder-panel">
        <h2>Site Safety Rule Simulation</h2>
        <p>Run stored Site Safety rules against a privacy-safe sample input. Simulation reports what would happen without changing live scores.</p>
        @if (_siteSafetyRules.Count == 0)
        {
            <p>No admin-managed Site Safety rules are saved yet.</p>
        }
        else
        {
            <div class="form-row">
                <label>Rule
                    <select @bind="_selectedSiteSafetyRuleId">
                        @foreach (var rule in _siteSafetyRules)
                        {
                            <option value="@rule.RuleId">@rule.Name (@rule.Status / @rule.Mode)</option>
                        }
                    </select>
                </label>
                <button type="button" @onclick="RunSiteSafetySimulation">Run Privacy-Safe Sample</button>
            </div>

            @if (_siteSafetySimulationMessage is not null)
            {
                <p class="admin-message">@_siteSafetySimulationMessage</p>
            }

            @if (_siteSafetySimulation is not null)
            {
                <div class="simulation-grid">
                    <span>Rule matched: <strong>@_siteSafetySimulation.Matched</strong></span>
                    <span>Risk score impact: <strong>@_siteSafetySimulation.RiskScoreImpact</strong></span>
                    <span>Trust score impact: <strong>@_siteSafetySimulation.TrustScoreImpact</strong></span>
                    <span>Status impact: <strong>@(_siteSafetySimulation.StatusImpact?.ToString() ?? "None")</strong></span>
                    <span>Confidence impact: <strong>@_siteSafetySimulation.ConfidenceImpact</strong></span>
                    <span>Approval required: <strong>@_siteSafetySimulation.ApprovalRequired</strong></span>
                    <span>Admin review: <strong>@_siteSafetySimulation.AdminReviewWouldBeTriggered</strong></span>
                    <span>Recommended mode: <strong>@_siteSafetySimulation.RecommendedMode</strong></span>
                </div>

                <p>@_siteSafetySimulation.Recommendation</p>

                <div class="rule-builder-grid compact">
                    <div>
                        <h3>Matched Conditions</h3>
                        @if (_siteSafetySimulation.MatchedConditions.Count == 0)
                        {
                            <p>No conditions matched.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var condition in _siteSafetySimulation.MatchedConditions)
                                {
                                    <li>@condition</li>
                                }
                            </ul>
                        }
                    </div>
                    <div>
                        <h3>Failed Conditions</h3>
                        @if (_siteSafetySimulation.FailedConditions.Count == 0)
                        {
                            <p>No conditions failed.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var condition in _siteSafetySimulation.FailedConditions)
                                {
                                    <li>@condition</li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="rule-builder-grid compact">
                    <div>
                        <h3>Reasons Added</h3>
                        @if (_siteSafetySimulation.ReasonsAdded.Count == 0)
                        {
                            <p>No reasons would be added.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var reason in _siteSafetySimulation.ReasonsAdded)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div>
                        <h3>Warnings Added</h3>
                        @if (_siteSafetySimulation.WarningsAdded.Count == 0)
                        {
                            <p>No warnings would be added.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var warning in _siteSafetySimulation.WarningsAdded)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <section class="rule-builder-panel">
        <h2>Saved Rules</h2>
        @if (_savedRules.Count == 0)
        {
            <p>No saved rules yet.</p>
        }
        else
        {
            <table class="admin-rule-table">
                <thead>
                    <tr><th>Name</th><th>Enabled</th><th>Mode</th><th>Severity</th><th>Confidence</th><th>Approval</th><th>Simulation</th><th>Version</th><th>History</th></tr>
                </thead>
                <tbody>
                    @foreach (var rule in _savedRules)
                    {
                        <tr>
                            <td>@rule.Name</td>
                            <td>@rule.Enabled</td>
                            <td>@rule.Mode</td>
                            <td>@rule.Severity</td>
                            <td>@rule.ConfidenceScore</td>
                            <td>@rule.RequiresApproval / @rule.ApprovalStatus</td>
                            <td>@rule.SimulationRequired</td>
                            <td>@rule.Version</td>
                            <td><button type="button" @onclick="() => LoadVersionHistoryAsync(rule.RuleId)">View versions</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="rule-builder-panel">
        <h2>Version History</h2>
        @if (_versionHistory.Count == 0)
        {
            <p>Select a saved rule to inspect its immutable version history.</p>
        }
        else
        {
            <table class="admin-rule-table">
                <thead><tr><th>Version</th><th>Mode</th><th>Severity</th><th>Approval</th><th>Inspect</th></tr></thead>
                <tbody>
                    @foreach (var version in _versionHistory)
                    {
                        <tr>
                            <td>@version.Version</td>
                            <td>@version.Mode</td>
                            <td>@version.Severity</td>
                            <td>@version.ApprovalStatus</td>
                            <td><button type="button" @onclick="() => InspectVersion(version)">View JSON</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_inspectedVersion is not null)
        {
            <h3>@_inspectedVersion.Name version @_inspectedVersion.Version</h3>
            <pre class="json-preview">@RuleJsonService.ToJson(_inspectedVersion)</pre>
            <p>Historical versions are read-only. Use the deployment rollback control above to perform an authorized rollback.</p>
        }
    </section>
</main>

@code {
    [Parameter]
    public string? RuleId { get; set; }

    private readonly RuleBuilderFormModel _form = RuleBuilderFormModel.Default();
    private string _json = string.Empty;
    private string? _jsonError;
    private string? _message;
    private bool _advancedMode;
    private RuleSimulationResult? _simulation;
    private IReadOnlyCollection<TrustRule> _savedRules = [];
    private IReadOnlyCollection<AdminSiteSafetyRule> _siteSafetyRules = [];
    private string? _selectedSiteSafetyRuleId;
    private string? _siteSafetySimulationMessage;
    private AdminSiteSafetyRuleSimulationResult? _siteSafetySimulation;
    private RuleApprovalWorkflowState? _workflow;
    private RuleDeploymentState? _deployment;
    private string _transitionReason = string.Empty;
    private IReadOnlyCollection<TrustRule> _versionHistory = [];
    private TrustRule? _inspectedVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadRouteRuleAsync();
        SyncJsonFromForm();
        _savedRules = await AdminRuleService.ListAsync(CancellationToken.None);
        await LoadSiteSafetyRulesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadRouteRuleAsync();
        SyncJsonFromForm();
    }

    private void AddCondition()
    {
        _form.Conditions.Add(new RuleConditionInput());
        SyncJsonFromForm();
    }

    private void RemoveCondition(RuleConditionInput condition)
    {
        _form.Conditions.Remove(condition);
        SyncJsonFromForm();
    }

    private void AddAction()
    {
        _form.Actions.Add(new RuleActionInput());
        SyncJsonFromForm();
    }

    private void RemoveAction(RuleActionInput action)
    {
        _form.Actions.Remove(action);
        SyncJsonFromForm();
    }

    private async Task SaveRule()
    {
        if (!TryGetRule(out var rule))
        {
            return;
        }

        try
        {
            var actor = await RequireRecentActorAsync();
            if (actor is null)
            {
                return;
            }

            var saved = await AdminRuleService.SaveAsync(rule, actor, CancellationToken.None);
            _form.Load(saved);
            _simulation = null;
            _workflow = null;
            _deployment = await DeploymentService.GetAsync(saved.RuleId, CancellationToken.None);
            _savedRules = await AdminRuleService.ListAsync(CancellationToken.None);
            await LoadVersionHistoryAsync(saved.RuleId);
            SyncJsonFromForm();
            _message = $"Rule version {saved.Version} saved. Run a new simulation before requesting approval.";
        }
        catch (FluentValidation.ValidationException ex)
        {
            _message = string.Join(" ", ex.Errors.Select(error => error.ErrorMessage));
        }
    }

    /// <summary>
    /// Reauthorizes the active circuit and resolves the server-authenticated HIP actor for persistence.
    /// </summary>
    private async Task<string?> RequireRecentActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var managementAuthorization = await AuthorizationService.AuthorizeAsync(
            authenticationState.User,
            null,
            AdminPolicies.CanManageRules);
        var recentAuthorization = await AuthorizationService.AuthorizeAsync(
            authenticationState.User,
            null,
            AdminPolicies.RecentPrivilegedAuthentication);
        if (!managementAuthorization.Succeeded || !recentAuthorization.Succeeded)
        {
            _message = "Sign in again before saving security-sensitive rule changes.";
            return null;
        }

        var actor = authenticationState.User.FindFirst(HipAuthenticationClaimTypes.ActorId)?.Value;
        if (string.IsNullOrWhiteSpace(actor) && HostEnvironment.IsDevelopment())
        {
            actor = authenticationState.User.Identity?.Name;
        }

        if (string.IsNullOrWhiteSpace(actor))
        {
            _message = "The authenticated HIP actor identity is unavailable.";
            return null;
        }

        return actor;
    }

    private async Task RunSimulation()
    {
        if (!TryGetRule(out var rule))
        {
            return;
        }

        _simulation = AdminRuleService.Simulate(rule, null);
        await SimulationRepository.SaveAsync(_simulation.SimulationId, _simulation, CancellationToken.None);
        _message = _simulation.Passed
            ? "Passing simulation persisted for this exact rule snapshot."
            : "Simulation failed. Resolve failed cases before requesting approval.";
    }

    /// <summary>
    /// Loads stored admin-managed Site Safety rules for the simulation UX panel.
    /// </summary>
    private async Task LoadSiteSafetyRulesAsync()
    {
        _siteSafetyRules = await SiteSafetyRuleRepository.ListAsync(CancellationToken.None);
        _selectedSiteSafetyRuleId ??= _siteSafetyRules.FirstOrDefault()?.RuleId;
    }

    /// <summary>
    /// Runs the selected Site Safety rule against privacy-safe sample facts without mutating live scoring.
    /// </summary>
    private async Task RunSiteSafetySimulation()
    {
        if (string.IsNullOrWhiteSpace(_selectedSiteSafetyRuleId))
        {
            _siteSafetySimulationMessage = "Select a Site Safety rule before running simulation.";
            return;
        }

        var rule = await SiteSafetyRuleRepository.GetByIdAsync(_selectedSiteSafetyRuleId, CancellationToken.None);
        if (rule is null)
        {
            _siteSafetySimulationMessage = "The selected Site Safety rule was not found.";
            return;
        }

        _siteSafetySimulation = SiteSafetyRuleService.Simulate(rule, PrivacySafeSampleInput());
        _siteSafetySimulationMessage = "Simulation completed without changing live scoring.";
    }

    /// <summary>
    /// Creates privacy-safe sample inputs for admin rule testing without page text, form values, or external calls.
    /// </summary>
    private static AdminSiteSafetyRuleSimulationInput PrivacySafeSampleInput() =>
        new(
            Url: "https://sample-rule.example/login",
            Domain: "sample-rule.example",
            Tld: "example",
            HasHttps: true,
            RedirectCount: 1,
            ShortenedLinkCount: 1,
            ObfuscatedLinkCount: 0,
            ExecutableDownloadCount: 1,
            HasLoginForm: true,
            HasPasswordField: true,
            MatchedRiskTerms: ["CrackedSoftware", "DisableAntivirus"],
            TrustDataAvailable: false);

    private void EnableRule()
    {
        _form.Enabled = true;
        _form.Mode = RuleMode.Active;
        SyncJsonFromForm();
    }

    private void DisableRule()
    {
        _form.Enabled = false;
        _form.Mode = RuleMode.Disabled;
        SyncJsonFromForm();
    }

    private async Task CopyJsonAsync()
    {
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", _json);
        _message = "Rule JSON copied.";
    }

    private void ValidateJson()
    {
        _ = TryGetRule(out _);
        _message = _jsonError is null ? "Rule JSON is valid." : null;
    }

    private void EditJson()
    {
        _advancedMode = true;
        _message = null;
    }

    private void RestoreFormView()
    {
        if (RuleJsonService.TryParse(_json, out var rule, out var errors) && rule is not null)
        {
            _form.Load(rule);
            _jsonError = null;
            _advancedMode = false;
            SyncJsonFromForm();
            return;
        }

        _jsonError = string.Join(" ", errors);
    }

    private bool TryGetRule(out TrustRule rule)
    {
        if (_advancedMode)
        {
            if (RuleJsonService.TryParse(_json, out var parsed, out var errors) && parsed is not null)
            {
                rule = parsed;
                _jsonError = null;
                return true;
            }

            _jsonError = string.Join(" ", errors);
            rule = _form.ToRule();
            return false;
        }

        rule = _form.ToRule();
        var validation = RuleJsonService.Validate(rule);
        if (validation.IsValid)
        {
            _jsonError = null;
            return true;
        }

        _jsonError = string.Join(" ", validation.Errors.Select(error => error.ErrorMessage));
        return false;
    }

    private void SyncJsonFromForm()
    {
        if (!_advancedMode)
        {
            _json = RuleJsonService.ToJson(_form.ToRule());
        }
    }

    private async Task LoadRouteRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(RuleId) || RuleId.Equals("new", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var existing = await RuleRepository.GetByIdAsync(RuleId, CancellationToken.None);
        if (existing is not null)
        {
            _form.Load(existing);
            _deployment = await DeploymentService.GetAsync(existing.RuleId, CancellationToken.None);
            await LoadVersionHistoryAsync(existing.RuleId);
        }
    }

    private async Task LoadVersionHistoryAsync(string ruleId)
    {
        _versionHistory = await RuleRepository.ListVersionsAsync(ruleId, CancellationToken.None);
        _inspectedVersion = _versionHistory.FirstOrDefault();
    }

    private void InspectVersion(TrustRule version) => _inspectedVersion = version;

    private async Task RequestApprovalAsync()
    {
        if (_simulation is null || !_simulation.Passed)
        {
            _message = "Run and pass a simulation before requesting approval.";
            return;
        }

        await RunWorkflowMutationAsync(async actor =>
        {
            var rule = await RuleRepository.GetByIdAsync(_simulation.RuleId, CancellationToken.None) ??
                       throw new InvalidOperationException("Save the simulated rule version before requesting approval.");
            _workflow = await ApprovalWorkflowService.RequestAsync(rule, _simulation.SimulationId, actor, CancellationToken.None);
            _message = $"Approval workflow created for rule version {_workflow.RuleVersion}.";
        });
    }

    private Task ApproveAsync() => RunWorkflowMutationAsync(async actor =>
    {
        _workflow = await ApprovalWorkflowService.ApproveAsync(RequiredWorkflowId(), actor, CancellationToken.None);
        _message = "Independent approval recorded.";
    });

    private Task CompleteRollbackTestAsync() => RunWorkflowMutationAsync(async actor =>
    {
        _workflow = await ApprovalWorkflowService.CompleteRollbackTestAsync(
            RequiredWorkflowId(), actor, RequiredTransitionReason(), CancellationToken.None);
        _message = "Rollback test recorded.";
    });

    private Task AuthorizeManualDeploymentAsync() => RunWorkflowMutationAsync(async actor =>
    {
        _workflow = await ApprovalWorkflowService.AuthorizeManualDeploymentAsync(
            RequiredWorkflowId(), actor, RequiredTransitionReason(), CancellationToken.None);
        _message = "Manual deployment authorized.";
    });

    private Task ActivateAsync() => RunWorkflowMutationAsync(async actor =>
    {
        _deployment = await DeploymentService.ActivateAsync(
            RequiredWorkflowId(), actor, RequiredTransitionReason(), CancellationToken.None);
        _message = $"Rule version {_deployment.ActiveRule?.Version} deployed in {_deployment.Status} mode.";
    });

    private Task PromoteAsync() => RunWorkflowMutationAsync(async actor =>
    {
        var deployment = _deployment ?? throw new InvalidOperationException("No deployment is selected.");
        _deployment = await DeploymentService.PromoteAsync(
            deployment.RuleId, deployment.Version, actor, RequiredTransitionReason(), CancellationToken.None);
        _message = "Watch-mode rule promoted to active enforcement.";
    });

    private Task RollbackAsync() => RunWorkflowMutationAsync(async actor =>
    {
        var deployment = _deployment ?? throw new InvalidOperationException("No deployment is selected.");
        _deployment = await DeploymentService.RollbackAsync(
            deployment.RuleId, deployment.Version, actor, RequiredTransitionReason(), CancellationToken.None);
        _message = $"Rule deployment rolled back to {_deployment.Status}.";
    });

    private async Task RunWorkflowMutationAsync(Func<string, Task> mutation)
    {
        try
        {
            var actor = await RequireRecentActorAsync();
            if (actor is null)
            {
                return;
            }

            await mutation(actor);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _message = exception.Message;
        }
    }

    private string RequiredWorkflowId() =>
        _workflow?.WorkflowId ?? throw new InvalidOperationException("No approval workflow is selected.");

    private string RequiredTransitionReason()
    {
        if (string.IsNullOrWhiteSpace(_transitionReason))
        {
            throw new ArgumentException("A transition reason is required.");
        }

        return _transitionReason.Trim();
    }

}
