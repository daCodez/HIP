@page "/consumer/devices"
@attribute [Authorize(Policy = ConsumerPolicies.CanUseConsumerPortal)]
@rendermode InteractiveServer
@using HIP.Application.Devices
@using HIP.Domain.Devices

<PageTitle>Devices | HIP Consumer Portal</PageTitle>

<main class="consumer-devices-page" aria-busy="@_isLoading">
    <section class="hip-page-heading devices-heading">
        <div>
            <span class="hip-eyebrow">Consumer portal · device security</span>
            <h1>Devices</h1>
            <p>Register this browser with a private key that stays on this device, then revoke the registration whenever you need to.</p>
        </div>
        <span class="device-key-note">Private key stays in this browser</span>
    </section>

    @if (_isLoading)
    {
        <section class="devices-loading" aria-label="Loading devices">
            <div></div><div></div><div></div>
        </section>
    }
    else if (_accessError is not null)
    {
        <section class="hip-panel padded devices-error" role="alert">
            <h2>Device registrations unavailable</h2>
            <p>@_accessError</p>
            <button type="button" class="hip-secondary-action" @onclick="LoadDevicesAsync">Retry</button>
        </section>
    }
    else
    {
        <section class="device-summary-grid" aria-label="Device summary">
            <article class="device-summary-card active">
                <span>Active devices</span><strong>@ActiveDeviceCount</strong>
                <p>Proof-of-possession registrations currently active for this consumer account.</p>
            </article>
            <article class="device-summary-card revoked">
                <span>Revoked devices</span><strong>@RevokedDeviceCount</strong>
                <p>Terminal records retained so old keys cannot be registered again.</p>
            </article>
            <article class="device-summary-card assurance">
                <span>Registration proof</span><strong>P-256</strong>
                <p>Proof confirms private-key possession. It does not prove a device is safe.</p>
            </article>
        </section>

        <section class="hip-panel padded device-registration-panel">
            <div class="device-registration-copy">
                <span class="device-section-label">Register this browser</span>
                <h2>Create a device identity</h2>
                <p>HIP creates a non-exportable private key in this browser profile and sends only the public key to the server.</p>
            </div>
            <div class="device-registration-form">
                <label for="device-friendly-name">Device name</label>
                <input id="device-friendly-name"
                       maxlength="64"
                       autocomplete="off"
                       @bind="_friendlyName"
                       disabled="@_isBusy"
                       placeholder="For example, Home laptop" />
                <button type="button"
                        class="hip-primary-action"
                        @onclick="RegisterAsync"
                        disabled="@RegistrationDisabled">
                    @(_isRegistering ? "Registering…" : "Register this browser")
                </button>
                @if (AtDeviceLimit)
                {
                    <small>Revoke an active device before registering another one.</small>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="device-message @(_statusIsError ? "error" : "success")"
                 role="@(_statusIsError ? "alert" : "status")"
                 aria-live="polite">@_statusMessage</div>
        }

        <section class="hip-panel padded device-inventory">
            <div class="device-inventory-heading">
                <div>
                    <span class="device-section-label">Account-owned inventory</span>
                    <h2>Your registered devices</h2>
                    <p>Only devices bound to the signed-in consumer account are shown.</p>
                </div>
                <button type="button" class="hip-secondary-action" @onclick="LoadDevicesAsync" disabled="@_isBusy">Refresh</button>
            </div>

            @if (_devices.Count == 0)
            {
                <div class="device-empty" role="status">
                    <h3>No devices registered</h3>
                    <p>Use “Register this browser” above to create your first proof-of-possession key.</p>
                </div>
            }
            else
            {
                <div class="device-table-wrap">
                    <p class="device-activity-note">Recorded activity currently starts at registration and does not prove later device use.</p>
                    <table class="hip-data-table device-table">
                        <thead><tr><th>Device</th><th>Proof</th><th>Status</th><th>Registered</th><th>Recorded activity</th><th>Registration</th></tr></thead>
                        <tbody>
                        @foreach (var device in _devices)
                        {
                            <tr>
                                <td><div class="device-name"><strong>@device.FriendlyName</strong><small>@PlatformLabel(device.PlatformType) · @device.ClientVersion</small></div></td>
                                <td><div class="device-proof"><span>@TrustLabel(device.TrustState)</span><code title="@device.PublicKeyFingerprint">@ShortFingerprint(device.PublicKeyFingerprint)</code></div></td>
                                <td><span class="device-status @StatusTone(device.RevocationState)">@StatusLabel(device.RevocationState)</span></td>
                                <td>@FormatDate(device.RegisteredAtUtc)</td>
                                <td>@FormatDate(device.LastSeenAtUtc)</td>
                                <td>
                                    @if (device.RevocationState == DeviceRevocationState.Active)
                                    {
                                        @if (_confirmingDeviceId == device.DeviceId)
                                        {
                                            <div class="device-confirm-actions" role="group" aria-label="Confirm revocation for @device.FriendlyName">
                                                <button type="button" class="device-danger-action" @onclick="() => RevokeAsync(device)" disabled="@_isBusy">Confirm revoke</button>
                                                <button type="button" class="device-cancel-action" @onclick="CancelRevoke" disabled="@_isBusy">Keep device</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="device-revoke-action" @onclick="() => BeginRevoke(device.DeviceId)" disabled="@_isBusy">Revoke</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="device-revoked-at">@FormatRevokedDate(device.RevokedAtUtc)</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>
