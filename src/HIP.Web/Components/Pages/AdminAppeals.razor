@page "/admin/appeals"
@page "/admin/appeals/{AppealId}"
@attribute [Authorize(Policy = AdminPolicies.CanViewAppeals)]
@rendermode InteractiveServer
@inject IAppealService AppealService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment HostEnvironment

<PageTitle>HIP Appeals</PageTitle>

<main class="admin-rule-page">
    <section class="admin-rule-header">
        <p class="eyebrow">Admin MVP</p>
        <h1>Appeals</h1>
        <p>Review privacy-safe appeals for domains, senders, device keys, organizations, and content patterns.</p>
        @if (HostEnvironment.IsDevelopment())
        {
            <AuthorizeView Policy="@AdminPolicies.CanDecideAppeals">
                <Authorized>
                    <button type="button" @onclick="CreateSample">Create Sample Appeal</button>
                </Authorized>
            </AuthorizeView>
        }
    </section>

    @if (_message is not null)
    {
        <p class="admin-message" role="status">@_message</p>
    }

    @if (_selected is not null)
    {
        <section class="rule-builder-panel">
            <h2>Appeal Detail</h2>
            <dl class="lookup-details">
                <dt>ID</dt><dd>@_selected.AppealId</dd>
                <dt>Target</dt><dd>@_selected.TargetType: @_selected.TargetId</dd>
                <dt>Status</dt><dd>@_selected.Status</dd>
                <dt>Reason</dt><dd>@_selected.Reason</dd>
                <dt>Decision</dt><dd>@_selected.Decision @_selected.DecisionReason</dd>
            </dl>
        </section>
    }

    <section class="rule-builder-panel">
        <h2>Appeal Requests</h2>
        <table class="admin-rule-table">
            <thead>
                <tr><th>Target</th><th>Reason</th><th>Status</th><th>Submitted</th><th>Decision</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var appeal in _appeals)
                {
                    <tr>
                        <td>@appeal.TargetType: @appeal.TargetId</td>
                        <td>@appeal.Reason</td>
                        <td>@appeal.Status</td>
                        <td>@appeal.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                        <td>@appeal.Decision @appeal.DecisionReason</td>
                        <td>
                            <AuthorizeView Policy="@AdminPolicies.CanDecideAppeals">
                                <Authorized>
                                    <button type="button" @onclick="() => Approve(appeal.AppealId)">Approve</button>
                                    <button type="button" @onclick="() => Reject(appeal.AppealId)">Reject</button>
                                    <button type="button" @onclick="() => MoreInfo(appeal.AppealId)">More Info</button>
                                </Authorized>
                                <NotAuthorized><span>View only</span></NotAuthorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</main>

@code {
    [Parameter]
    public string? AppealId { get; set; }

    private IReadOnlyCollection<AppealRequest> _appeals = [];
    private AppealRequest? _selected;
    private string? _message;

    protected override void OnInitialized() => Refresh();

    protected override void OnParametersSet() => Refresh();

    private void Refresh()
    {
        _appeals = AppealService.List();
        _selected = string.IsNullOrWhiteSpace(AppealId) ? null : AppealService.Get(AppealId);
    }

    private Task CreateSample() =>
        RunAuthorizedMutationAsync(_ => AppealService.Submit(new AppealRequest(
            "",
            TargetType.Domain,
            "appeal-example.com",
            "sha256:submitter",
            "The domain has remediated the reported redirect issue.",
            AppealStatus.Submitted,
            DateTimeOffset.UtcNow,
            DateTimeOffset.UtcNow,
            null,
            null,
            null,
            new Dictionary<string, string> { ["evidenceSummary"] = "public DNS and redirect fix notes" })),
            developmentOnly: true);

    private Task Approve(string id) =>
        RunAuthorizedMutationAsync(actor => AppealService.Approve(
            id,
            actor,
            "Appeal accepted based on privacy-safe evidence."));

    private Task Reject(string id) =>
        RunAuthorizedMutationAsync(actor => AppealService.Reject(
            id,
            actor,
            "Risk evidence remains valid."));

    private Task MoreInfo(string id) =>
        RunAuthorizedMutationAsync(actor => AppealService.RequestMoreInfo(
            id,
            actor,
            "Need more public remediation evidence."));

    /// <summary>
    /// Reauthorizes the current circuit immediately before a direct appeal mutation.
    /// </summary>
    private async Task RunAuthorizedMutationAsync(
        Func<string, AppealRequest> mutation,
        bool developmentOnly = false)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var result = await HipAdminPageAccess.ExecuteAuthorizedAsync(
            authenticationState.User,
            AuthorizationService,
            HostEnvironment,
            AdminPolicies.CanDecideAppeals,
            mutation,
            developmentOnly);
        if (!result.Succeeded)
        {
            _message = HipAdminPageAccess.AccessUnavailableMessage;
            return;
        }

        _message = null;
        Refresh();
    }
}
