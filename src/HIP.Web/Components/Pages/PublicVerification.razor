@page "/verification"
@page "/verify"
@attribute [AllowAnonymous]
@layout MarketingLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Domain Verification and Trust Badges | HIP</PageTitle>
<HeadContent>
  <meta name="description" content="Prove you control your domain, resolve what HIP found, and earn a trust badge through verification and human review — not by registering." />
  <meta property="og:title" content="Domain Verification and Trust Badges | HIP" />
  <meta property="og:description" content="Prove you control your domain, resolve what HIP found, and earn a trust badge through verification and human review — not by registering." />
</HeadContent>

<main style="max-width:1240px;margin:0 auto;padding:clamp(56px,6vw,80px) clamp(16px,3vw,32px) 110px">
  <div style="max-width:680px;margin-bottom:60px">
    <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:16px">FOR WEBSITE OWNERS</div>
    <h1 style="font-size:clamp(36px,4.6vw,52px);line-height:1.06;letter-spacing:-.03em;font-weight:800;margin:0 0 18px;text-wrap:balance">Prove it once, then keep it honest.</h1>
    <p style="font-size:19px;line-height:1.6;color:var(--muted);margin:0;text-wrap:pretty">Verification connects a domain to the people who run it. A verification record says the findings were resolved on a specific date — and expires so it cannot go stale.</p>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-bottom:72px">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--action);margin-bottom:14px">STEP 01</div>
      <h3 style="font-size:17px;font-weight:700;margin:0 0 9px">Register the domain</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">Create an account and add the domain you manage. A first scan runs immediately.</p>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--action);margin-bottom:14px">STEP 02</div>
      <h3 style="font-size:17px;font-weight:700;margin:0 0 9px">Prove control</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">Publish the TXT record HIP gives you. Nothing else is installed on your site.</p>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--action);margin-bottom:14px">STEP 03</div>
      <h3 style="font-size:17px;font-weight:700;margin:0 0 9px">Resolve findings</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">Work the list, re-scan, and appeal anything you believe is wrong.</p>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--action);margin-bottom:14px">STEP 04</div>
      <h3 style="font-size:17px;font-weight:700;margin:0 0 9px">Earn the trust badge</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">A reviewer checks the evidence. If it is granted, you can embed the badge.</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;margin-bottom:72px">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:34px">
      <h2 style="font-size:24px;font-weight:700;margin:0 0 14px;letter-spacing:-.02em">The DNS proof</h2>
      <p style="font-size:15.5px;line-height:1.65;color:var(--muted);margin:0 0 20px">One TXT record, unique to your domain and account. Remove it and verification lapses.</p>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.9;overflow:auto">
        <div><span style="color:var(--muted)">host&nbsp;&nbsp;</span>_hip.yourdomain.com</div>
        <div><span style="color:var(--muted)">type&nbsp;&nbsp;</span>TXT</div>
        <div><span style="color:var(--muted)">value&nbsp;</span><span style="color:var(--action)">hip-verify=8f2c41d9e0b7a6</span></div>
      </div>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:34px">
      <h2 style="font-size:24px;font-weight:700;margin:0 0 14px;letter-spacing:-.02em">Appeals &amp; manual review</h2>
      <p style="font-size:15.5px;line-height:1.65;color:var(--muted);margin:0 0 20px">If a rule misreads your site, contest it. Reviewers see the same evidence you do.</p>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;align-items:center;gap:12px;padding:13px 15px;background:var(--bg);border:1px solid var(--border);border-radius:11px"><span style="padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(245,158,11,.14);color:var(--warn)">OPEN</span><span style="font-size:14.5px;color:var(--text);flex:1">Urgency wording — checkout page</span><span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted)">2d</span></div>
        <div style="display:flex;align-items:center;gap:12px;padding:13px 15px;background:var(--bg);border:1px solid var(--border);border-radius:11px"><span style="padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(31,111,235,.14);color:var(--blue)">IN REVIEW</span><span style="font-size:14.5px;color:var(--text);flex:1">Third-party script attribution</span><span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted)">6h</span></div>
        <div style="display:flex;align-items:center;gap:12px;padding:13px 15px;background:var(--bg);border:1px solid var(--border);border-radius:11px"><span style="padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.14);color:var(--ok)">UPHELD</span><span style="font-size:14.5px;color:var(--text);flex:1">Rule updated for all domains</span><span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted)">3w</span></div>
      </div>
    </div>
  </div>

  <div style="text-align:center;padding:clamp(38px,5vw,56px) clamp(20px,3vw,32px);background:var(--surface);border:1px solid var(--border);border-radius:22px">
    <h2 style="font-size:clamp(26px,3vw,34px);line-height:1.12;letter-spacing:-.025em;font-weight:800;margin:0 0 14px">Start with a scan.</h2>
    <p style="font-size:17px;color:var(--muted);margin:0 auto 28px;max-width:460px">Verification only makes sense once you know what is there.</p>
    <button @onclick="GoScan" style="padding:13px 24px;background:var(--action);color:var(--action-ink);border:0;border-radius:10px;font-size:15.5px;font-weight:700;cursor:pointer" data-h="h-bright">Check my domain</button>
  </div>
</main>

@code {
    private void GoScan() => Nav.NavigateTo("/#scan");
}
