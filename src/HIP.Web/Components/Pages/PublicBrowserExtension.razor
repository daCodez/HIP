@page "/browser-extension"
@attribute [AllowAnonymous]
@layout MarketingLayout
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>HIP Browser Extension: Status, Warnings &amp; X-ray Preview</PageTitle>
<HeadContent>
  <meta name="description" content="Preview the HIP browser extension's toolbar status, warnings and local X-ray behavior, with clear privacy and availability notes." />
  <meta property="og:title" content="HIP Browser Extension: Status, Warnings &amp; X-ray Preview" />
  <meta property="og:description" content="See what the HIP extension checks locally, when backend evidence is used, and which pages are supported." />
  <meta property="og:url" content="https://guardwithhip.com/browser-extension" />
  <meta property="og:image" content="https://guardwithhip.com/images/public/marketing/og-image.png" />
  <link rel="canonical" href="https://guardwithhip.com/browser-extension" />
</HeadContent>

<main>
  <header style="max-width:900px;margin:0 auto;padding:clamp(56px,7vw,92px) clamp(16px,3vw,32px) 0">
    <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:14px">DEVELOPMENT PREVIEW</div>
    <h1 style="font-size:clamp(38px,5vw,58px);line-height:1.05;letter-spacing:-.03em;margin:0 0 18px">HIP, where you browse.</h1>
    <p style="font-size:19px;line-height:1.65;color:var(--muted);margin:0">The extension is in development. This simulator demonstrates intended toolbar states and warnings; it does not claim a live store release.</p>
  </header>

  <section data-register-scope>
    <div style="max-width:1240px;margin:34px auto 0;padding:0 clamp(16px,3vw,32px);display:flex;justify-content:flex-end">
      <button data-register-toggle type="button" style="padding:8px 12px;border:1px solid var(--border);background:var(--surface);border-radius:9px;color:var(--muted);font:600 12.5px inherit;cursor:pointer"><span data-register-label>Plain language</span></button>
    </div>
    <ExtensionSimulator />
    <section style="max-width:1240px;margin:0 auto;padding:0 clamp(16px,3vw,32px) 70px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px">
      <article style="padding:24px;border:1px solid var(--border);border-radius:16px;background:var(--surface)"><h2 style="font-size:20px">Local X-ray</h2><p data-register-copy data-plain="Looks at the page in your browser and connects warnings to visible elements." data-technical="Runs bounded DOM inspection in the active tab; page structure stays local unless a full lookup is explicitly requested." style="color:var(--muted);line-height:1.6">Looks at the page in your browser and connects warnings to visible elements.</p><button @onclick="RunXray" style="padding:11px 16px;border:1px solid var(--action);background:transparent;color:var(--action);border-radius:9px;font-weight:700;cursor:pointer">Try the local demo</button></article>
      <article style="padding:24px;border:1px solid var(--border);border-radius:16px;background:var(--surface)"><h2 style="font-size:20px">Backend evidence</h2><p data-register-copy data-plain="A full HIP lookup is separate and may add domain, certificate and reputation evidence." data-technical="Network-backed evidence is requested separately; unavailable stages remain unavailable rather than being inferred clean." style="color:var(--muted);line-height:1.6">A full HIP lookup is separate and may add domain, certificate and reputation evidence.</p></article>
      <article style="padding:24px;border:1px solid var(--border);border-radius:16px;background:var(--surface)"><h2 style="font-size:20px">Supported pages</h2><p style="color:var(--muted);line-height:1.6">Ordinary HTTP and HTTPS pages are the target. Browser settings, extension pages, local files and protected store pages cannot be inspected.</p></article>
    </section>
  </section>

  <section style="max-width:900px;margin:0 auto;padding:0 clamp(16px,3vw,32px) 90px;text-align:center">
    <h2>Follow the real implementation.</h2>
    <p style="color:var(--muted);line-height:1.65">Until a reviewed store build is published, the repository is the source of truth for status, code and developer installation instructions.</p>
    <a href="https://github.com/daCodez/HIP/tree/master/clients/browser-extension" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:12px 18px;background:var(--action);color:var(--action-ink);border-radius:10px;font-weight:700;text-decoration:none">View extension source</a>
  </section>
</main>

@code {
  private async Task RunXray() => await JS.InvokeVoidAsync("hip.xray");
}
