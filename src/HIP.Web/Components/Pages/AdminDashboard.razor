@page "/"
@page "/admin"
@attribute [Authorize(Policy = AdminPolicies.CanViewAdminDashboard)]
@rendermode InteractiveServer
@inject IAdminDashboardService DashboardService

<PageTitle>HIP Admin Overview</PageTitle>

<main class="admin-rule-page hip-dashboard overview-command">
    <header class="editorial-topbar">
        <div class="editorial-topbar-title">
            <b>Operations dashboard</b>
            <small>Human Interactive Protocol</small>
        </div>
        @if (_summary is not null)
        {
            <span class="system-status @SystemStatusTone"><i></i>@SystemStatusLabel</span>
            <time datetime="@_summary.GeneratedAtUtc.ToString("O")">Updated @_summary.GeneratedAtUtc.UtcDateTime.ToString("HH:mm") UTC</time>
        }
        <button class="editorial-theme-button" type="button" data-hip-theme-toggle aria-label="Switch to light mode">Light mode</button>
        <button class="editorial-refresh-button" type="button" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "Refresh")</button>
    </header>

    @if (_error is not null)
    {
        <div class="overview-state danger" role="alert"><b>Overview unavailable</b><span>@_error</span></div>
    }
    else if (_summary is null)
    {
        <div class="overview-state" aria-busy="true">Loading HIP security signals…</div>
    }
    else
    {
        <header class="editorial-intro">
            <div>
                <p class="kicker">Today's protection posture</p>
                <h1>@DashboardHeading</h1>
            </div>
            <p>@DashboardSummary</p>
            <small class="intro-meta"><span>@HipWebBuildInfo.DashboardDisplayVersion</span><span>Snapshot @_summary.GeneratedAtUtc.UtcDateTime.ToString("u")</span><span>@DashboardDataSourceLabel</span></small>
        </header>

        <section class="editorial-hero" aria-label="HIP protection summary">
            <article class="trust-panel">
                <div class="editorial-score" aria-label="@ProtectionScoreAriaLabel">
                    <div class="editorial-score-line">
                        <strong>@ProtectionScoreText</strong><span>/100</span>
                    </div>
                    <b>@ProtectionStatus</b>
                </div>
                <div class="trust-copy">
                    <p class="kicker">@ProtectionKicker</p>
                    <h2>@ProtectionHeading</h2>
                    <p>@ProtectionExplanation</p>
                    @if (_summary.HasScanData)
                    {
                        <div class="trust-distribution" aria-label="@OutcomeDistributionLabel">
                            <i class="trusted" style="@SegmentStyle(TrustedPercent)"></i>
                            <i class="caution" style="@SegmentStyle(CautionPercent)"></i>
                            <i class="risk" style="@SegmentStyle(RiskPercent)"></i>
                        </div>
                        <footer class="trust-legend">
                            <span><i class="trusted"></i><b>@TrustedPercent%</b> Trusted</span>
                            <span><i class="caution"></i><b>@CautionPercent%</b> Caution</span>
                            <span><i class="risk"></i><b>@RiskPercent%</b> Risk</span>
                        </footer>
                    }
                    else if (HasClientObservedScore)
                    {
                        <div class="trust-distribution" aria-label="@ClientOutcomeDistributionLabel">
                            <i class="trusted" style="@SegmentStyle(ClientTrustedPercent)"></i>
                            <i class="caution" style="@SegmentStyle(ClientCautionPercent)"></i>
                            <i class="risk" style="@SegmentStyle(ClientRiskPercent)"></i>
                        </div>
                        <footer class="trust-legend">
                            <span><i class="trusted"></i><b>@ClientTrustedPercent%</b> Trusted</span>
                            <span><i class="caution"></i><b>@ClientCautionPercent%</b> Caution</span>
                            <span><i class="risk"></i><b>@ClientRiskPercent%</b> Risk</span>
                        </footer>
                    }
                </div>
            </article>

            <aside class="priority-case">
                @if (PriorityThreat is not null)
                {
                    <header><span class="severity @PrioritySeverityTone">@PriorityThreat.Severity</span><small>@Relative(PriorityThreat.CreatedAtUtc)</small></header>
                    <h2>@PriorityThreat.ReasonSummary</h2>
                    <p class="priority-domain">@PriorityThreat.Domain</p>
                    <div class="priority-facts">
                        <span>Final HIP score<b>@(PriorityThreat.FinalHipScore?.ToString() ?? "—")</b></span>
                        <span>Evidence source<b>@PriorityThreat.Source</b></span>
                    </div>
                    <a class="review-case" href="@ThreatLink(PriorityThreat)">Review case</a>
                }
                else
                {
                    <header><span class="severity clear">Clear</span><small>Current snapshot</small></header>
                    <h2>No active priority case.</h2>
                    <p class="priority-domain">Connected evidence contains no recent high-risk case.</p>
                    <div class="priority-facts">
                        <span>High-risk scans<b>@HighRiskCount</b></span>
                        <span>Critical scans<b>@CriticalCount</b></span>
                    </div>
                    <a class="review-case" href="/review">Open review queue</a>
                }
            </aside>
        </section>

        <section class="editorial-metrics" aria-label="Current operational metrics">
            @if (_summary.HasScanData)
            {
                @Metric("scansToday", "Scans today", "Stored authoritative scans received today")
                @Metric("suspiciousResults", "Threats identified", "Suspicious or caution results")
                @Metric("activeRules", "Active rules", "Rules currently enforcing behavior")
                @Metric("domainsScanned", "Domains scanned", "Distinct domains with authoritative scans")
            }
            else if (ClientTelemetryCount > 0)
            {
                @Metric("clientTelemetryObservations", "Client observations", "Stored privacy-safe telemetry; not authoritative")
                @Metric("clientTelemetryDomains", "Observed domains", "Distinct client-observed domains")
                @Metric("clientTelemetryAverageScore", "Observed score", "Informational only; not an authoritative HIP score")
                @Metric("latestClientTelemetry", "Latest observation", "Minutes since client telemetry was stored")
            }
            else
            {
                @Metric("scansToday", "Scans today", "Stored scans received today")
                @Metric("suspiciousResults", "Threats identified", "Suspicious or caution results")
                @Metric("activeRules", "Active rules", "Rules currently enforcing behavior")
                @Metric("domainsScanned", "Domains scanned", "Distinct domains with stored scans")
            }
        </section>

        <section class="editorial-lower">
            <article class="outcomes-panel">
                <header class="section-heading">
                    <div><p class="kicker">Evidence mix</p><h2>Protection outcomes by day</h2><p>Daily volume and classification from stored browser scan summaries.</p></div>
                    <div class="range-tabs" aria-label="Chart date range">
                        @foreach (var days in new[] { 7, 30, 90 })
                        {
                            <button class="@(days == _rangeDays ? "active" : null)" @onclick="() => _rangeDays = days">@days days</button>
                        }
                    </div>
                </header>
                <div class="chart-legend" aria-label="Chart legend"><span><i class="trusted"></i>Trusted</span><span><i class="caution"></i>Caution</span><span><i class="risk"></i>Risk</span></div>
                @if (RangeScans.Count == 0)
                {
                    @Empty("No scans in this period", "Activity will appear after HIP receives stored browser scans.")
                }
                else
                {
                    <div class="outcome-chart" aria-label="Protection outcomes across seven time buckets">
                        @foreach (var bucket in DailyOutcomes)
                        {
                            <div class="outcome-day" tabindex="0" role="img" aria-label="@BucketAriaLabel(bucket)">
                                <span class="chart-tooltip"><b>@bucket.Label · @bucket.Total.ToString("N0") scans</b><small>@bucket.Trusted trusted · @bucket.Caution caution · @bucket.Risk risk</small></span>
                                <div class="outcome-stack" style="@VolumeStyle(bucket.Total)">
                                    <i class="trusted" style="@SegmentStyle(BucketPercent(bucket.Trusted, bucket.Classified))"></i>
                                    <i class="caution" style="@SegmentStyle(BucketPercent(bucket.Caution, bucket.Classified))"></i>
                                    <i class="risk" style="@SegmentStyle(BucketPercent(bucket.Risk, bucket.Classified))"></i>
                                </div>
                                <span class="outcome-date">@bucket.Label</span>
                            </div>
                        }
                    </div>
                    <p class="chart-note">Bar height shows stored scan volume. Color segments show the share classified as trusted, caution, or risk.</p>
                }
            </article>

            <aside class="judgments-panel">
                <p class="kicker">Decisions, not data</p>
                <h2>@JudgmentHeading</h2>
                <p>Ordered by operator impact.</p>
                @JudgmentRow("Uncertain scans", "Provider evidence requires review", "pendingReviewItems", "/review")
                @JudgmentRow("Rule approvals", "Generated candidates await approval", "selfHealingCandidates", "/self-healing")
                @JudgmentRow("Appeals", "Submitted cases await a decision", "pendingAppeals", "/appeals")
            </aside>
        </section>

        <section class="overview-panel evidence-table" aria-labelledby="recent-scans-heading">
            <header><div><p class="kicker">Stored evidence</p><h2 id="recent-scans-heading">Recent scans</h2></div><a href="/reputation">View all</a></header>
            @if (_summary.RecentScans.Count == 0)
            {
                @Empty("No authoritative scans yet", ClientTelemetryCount > 0 ? $"HIP stored {ClientTelemetryCount} privacy-safe client {Pluralize(ClientTelemetryCount, "observation", "observations")}; they remain non-authoritative until verified evidence is available." : "Run the browser extension to submit privacy-safe telemetry. HIP will keep it separate from authoritative trust evidence.")
            }
            else
            {
                <div class="hip-table-wrap">
                    <table class="hip-data-table">
                        <thead><tr><th>Domain</th><th>Status</th><th>Domain trust</th><th>Page trust</th><th>Content safety</th><th>Final score</th><th>Confidence</th><th>Last checked</th></tr></thead>
                        <tbody>
                            @foreach (var scan in _summary.RecentScans.Take(10))
                            {
                                <tr><td><a href="@ScanLink(scan)">@scan.Domain</a></td><td>@scan.Status</td><td>@Score(scan.DomainTrustScore)</td><td>@Score(scan.PageTrustScore)</td><td>@Score(scan.ContentRiskScore)</td><td><strong>@scan.Score</strong></td><td>@scan.ConfidenceLevel</td><td>@Relative(scan.LastCheckedUtc)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="editorial-details" aria-label="Supporting operational evidence">
            <article class="overview-panel"><header><div><p class="kicker">Domain identity</p><h2>Website verification</h2></div><a href="/identity/websites">Manage</a></header>@RuleRow("Registered domains", "registeredWebsiteIdentities") @RuleRow("Control verified", "verifiedWebsiteIdentities") @RuleRow("Awaiting verification", "pendingWebsiteIdentities") @RuleRow("Inactive verifications", "inactiveWebsiteIdentities")<small class="data-note">Verification confirms control of a domain. It does not certify that the site is safe or compliant.</small></article>
            <article class="overview-panel"><header><div><p class="kicker">Certificate authority</p><h2>Domain Trust Certificates</h2></div><a href="/certificates">Manage</a></header>@RuleRow("Current certificates", "domainCertificatesTotal") @RuleRow("Active", "domainCertificatesActive") @RuleRow("Expiring in 30 days", "domainCertificatesExpiringSoon") @RuleRow("Suspended", "domainCertificatesSuspended") @RuleRow("Revoked", "domainCertificatesRevoked") @RuleRow("Expired", "domainCertificatesExpired") @RuleRow("Registered level", "domainCertificatesRegistered") @RuleRow("Verified level", "domainCertificatesVerified") @RuleRow("Monitored level", "domainCertificatesMonitored") @RuleRow("Pending enrollments", "domainCertificateEnrollmentsPending")<small class="data-note">Certificate status and level are shown separately from site risk. A valid certificate does not automatically mean a site is safe.</small></article>
            <article class="overview-panel"><header><div><p class="kicker">Priority response</p><h2>Recent threat cases</h2></div><a href="/review">Review all</a></header>@if (_summary.RecentThreats.Count == 0) { @Empty("No active threats", "No high-risk evidence is present in connected data.") } else { @foreach (var threat in _summary.RecentThreats.Take(4)) { <a class="threat-card" href="@ThreatLink(threat)"><span class="risk-dot"></span><div><b>@threat.Domain</b><small>@threat.ReasonSummary</small><em>@threat.Severity · @threat.Source · @Relative(threat.CreatedAtUtc)</em></div><strong>@(threat.FinalHipScore?.ToString() ?? "—")</strong></a> } }</article>
            <article class="overview-panel"><p class="kicker">Stored evidence</p><h2>Top risk categories</h2>@RiskBar("Suspicious links", "suspiciousLinksFound") @RiskBar("Dangerous links", "dangerousLinksFound") @RiskBar("Risk findings", "riskyFindings") @RiskBar("Feedback spikes", "suspiciousFeedbackSpikes")</article>
            <article class="overview-panel"><p class="kicker">Infrastructure</p><h2>Provider health</h2>@Health("HIP API", _summary.ApiHealth, "Dashboard request completed") @Health("Optional data sources", UnavailableSourceCount == 0 ? "Available" : "Degraded", UnavailableSourceCount == 0 ? "All dashboard dependencies answered" : $"{UnavailableSourceCount} source(s) unavailable") @Health("External providers", Card("externalProviderErrors")?.Status ?? "Unavailable", Card("externalProviderErrors")?.IsPlaceholder == true ? "No provider evidence" : "Evidence received") @Health("Browser scanner", _summary.HasScanData ? "Evidence" : ClientTelemetryCount > 0 ? "Telemetry" : "Waiting", _summary.HasScanData ? _summary.DataSource : ClientTelemetryCount > 0 ? $"{ClientTelemetryCount} non-authoritative client observations stored" : _summary.DataSource)</article>
            <article class="overview-panel"><p class="kicker">Detection logic</p><h2>Rule performance</h2>@RuleRow("Active rules", "activeRules") @RuleRow("Simulation rules", "simulationRules") @RuleRow("Watch-only rules", "watchOnlyRules") @RuleRow("Awaiting approval", "selfHealingCandidates")<small class="data-note">Trigger and false-positive metrics are not yet exposed by the dashboard service.</small></article>
            <article class="overview-panel activity-panel"><p class="kicker">Audit stream</p><h2>System activity</h2>@if (_summary.RecentActivity.Count == 0) { @Empty("No recent activity", "Events will appear as HIP records system changes.") } else { <div class="activity-timeline">@foreach (var activity in _summary.RecentActivity.Take(6)) { <div><i></i><span><b>@activity.ActivityType</b><small>@activity.Summary</small><em>@Relative(activity.CreatedAtUtc)</em></span></div> }</div> }</article>
        </section>
    }
</main>

@code {
    private AdminDashboardSummary? _summary;
    private string? _error;
    private bool _loading;
    private int _rangeDays = 7;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        try { _summary = await DashboardService.GetSummaryAsync(CancellationToken.None); }
        catch { _error = "HIP could not load the privacy-safe dashboard summary. Try again."; }
        finally { _loading = false; }
    }

    private AdminDashboardCard? Card(string key) => _summary?.Cards.FirstOrDefault(card => card.Key == key);

    private RenderFragment Metric(string key, string label, string description) => builder =>
    {
        var card = Card(key);
        var value = card is null || card.IsPlaceholder ? "—" : card.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
        builder.OpenElement(0, "article"); builder.AddAttribute(1, "class", "editorial-metric");
        builder.OpenElement(2, "span"); builder.AddContent(3, label); builder.CloseElement();
        builder.OpenElement(4, "strong"); builder.AddContent(5, value); builder.CloseElement();
        builder.OpenElement(6, "small"); builder.AddContent(7, card is null || card.IsPlaceholder ? card?.Status ?? "Unavailable" : description); builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment JudgmentRow(string label, string description, string key, string href) => builder =>
    {
        var card = Card(key);
        var value = card is null || card.IsPlaceholder ? "—" : card.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        builder.OpenElement(0, "a"); builder.AddAttribute(1, "class", "judgment-row"); builder.AddAttribute(2, "href", href);
        builder.OpenElement(3, "strong"); builder.AddContent(4, value); builder.CloseElement();
        builder.OpenElement(5, "span"); builder.OpenElement(6, "b"); builder.AddContent(7, label); builder.CloseElement(); builder.OpenElement(8, "small"); builder.AddContent(9, card is null || card.IsPlaceholder ? card?.Status ?? "Unavailable" : description); builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(10, "em"); builder.AddContent(11, "Review"); builder.CloseElement(); builder.CloseElement();
    };

    private RenderFragment Empty(string title, string text) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "visual-empty"); builder.OpenElement(2, "b"); builder.AddContent(3, title); builder.CloseElement(); builder.OpenElement(4, "span"); builder.AddContent(5, text); builder.CloseElement(); builder.CloseElement();
    };

    private RenderFragment RiskBar(string label, string key) => builder =>
    {
        var card = Card(key); var value = card is null || card.IsPlaceholder ? "—" : card.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); var width = card is null || card.IsPlaceholder ? 0 : Math.Min(100, card.Value * 10);
        builder.AddMarkupContent(0, $"<div class='risk-bar'><span>{label}<b>{value}</b></span><i style='--w:{width}'></i></div>");
    };

    private RenderFragment Health(string name, string status, string note) => builder => builder.AddMarkupContent(0, $"<div class='health-row'><i class='{HealthTone(status)}'></i><span><b>{name}</b><small>{note}</small></span><strong>{status}</strong></div>");
    private RenderFragment RuleRow(string label, string key) => builder => { var card = Card(key); builder.AddMarkupContent(0, $"<div class='rule-row'><span>{label}</span><b>{(card is null || card.IsPlaceholder ? "—" : card.Value)}</b></div>"); };

    private int UnavailableSourceCount => _summary?.Sources.Count(source => !source.IsAvailable) ?? 0;
    private IReadOnlyList<AdminRecentScanItem> RangeScans => _summary?.RecentScans.Where(scan => scan.LastCheckedUtc >= DateTimeOffset.UtcNow.AddDays(-_rangeDays)).ToArray() ?? [];
    private int Count(params string[] values) => RangeScans.Count(scan => values.Any(value => scan.Status.Contains(value, StringComparison.OrdinalIgnoreCase)));
    private int SafeCount => Count("Trusted", "Safe", "Clean");
    private int CautionCount => Count("Limited", "Unknown", "Caution");
    private int HighRiskCount => Count("Suspicious", "HighRisk");
    private int CriticalCount => Count("Dangerous", "Critical");
    private int ClassifiedCount => SafeCount + CautionCount + HighRiskCount + CriticalCount;
    private int TrustedPercent => OutcomePercent(SafeCount, ClassifiedCount);
    private int CautionPercent => OutcomePercent(CautionCount, ClassifiedCount);
    private int RiskPercent => OutcomePercent(HighRiskCount + CriticalCount, ClassifiedCount);
    private int ProtectionScore => Math.Clamp(Card("averageHipScore")?.Value ?? 0, 0, 100);
    private int ClientTelemetryCount => CountCard("clientTelemetryObservations");
    private int ClientObservedScore => Math.Clamp(Card("clientTelemetryAverageScore")?.Value ?? 0, 0, 100);
    private bool HasClientObservedScore => ClientTelemetryCount > 0 && Card("clientTelemetryAverageScore")?.IsPlaceholder == false;
    private int ClientTrustedCount => CountCard("clientTelemetryTrustedResults");
    private int ClientCautionCount => CountCard("clientTelemetryCautionResults");
    private int ClientRiskCount => CountCard("clientTelemetryRiskResults");
    private int ClientClassifiedCount => ClientTrustedCount + ClientCautionCount + ClientRiskCount;
    private int ClientTrustedPercent => OutcomePercent(ClientTrustedCount, ClientClassifiedCount);
    private int ClientCautionPercent => OutcomePercent(ClientCautionCount, ClientClassifiedCount);
    private int ClientRiskPercent => OutcomePercent(ClientRiskCount, ClientClassifiedCount);
    private string ProtectionScoreText => (_summary?.HasScanData == true ? ProtectionScore : HasClientObservedScore ? ClientObservedScore : (int?)null)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—";
    private string ProtectionScoreAriaLabel => _summary?.HasScanData == true ? $"Authoritative protection score {ProtectionScore} out of 100" : HasClientObservedScore ? $"Client-observed score {ClientObservedScore} out of 100; not authoritative" : "Protection score unavailable";
    private int JudgmentCount => CountCard("pendingReviewItems") + CountCard("selfHealingCandidates") + CountCard("pendingAppeals");
    private AdminRecentThreatItem? PriorityThreat => _summary?.RecentThreats.FirstOrDefault();
    private int MaxBucketTotal => Math.Max(1, DailyOutcomes.Max(bucket => bucket.Total));

    private string ProtectionLabel => ProtectionScore >= 85 ? "Protected" : ProtectionScore >= 60 ? "Caution" : ProtectionScore >= 30 ? "High risk" : "Critical";
    private string ProtectionKicker => _summary?.HasScanData == true ? "Current domain protection" : HasClientObservedScore ? "Client-observed HIP signal" : "Current domain protection";
    private string ProtectionStatus => _summary?.HasScanData != true ? HasClientObservedScore ? "Client-observed · not verified" : "Awaiting evidence" : JudgmentCount > 0 ? "Protection pending review" : ProtectionLabel;
    private string ProtectionHeading => _summary?.HasScanData != true ? HasClientObservedScore ? "Observed score available, verification pending." : "Protection needs evidence." : JudgmentCount > 0 ? "Strong evidence, incomplete judgment." : "Current evidence is fully reviewed.";
    private string ProtectionExplanation => _summary?.HasScanData == true ? JudgmentCount > 0 ? $"{JudgmentCount} {Pluralize(JudgmentCount, "decision", "decisions")} require review before protection status can be confirmed." : $"Based on the latest authoritative scan for {CountCard("domainsScanned")} monitored {Pluralize(CountCard("domainsScanned"), "domain", "domains")}." : ClientTelemetryCount > 0 ? $"HIP stored {ClientTelemetryCount} privacy-safe client {Pluralize(ClientTelemetryCount, "observation", "observations")}. They are visible below but cannot become an authoritative score without verified evidence." : "HIP needs stored scan evidence before it can calculate protection.";
    private string DashboardHeading => _summary?.HasScanData != true
        ? ClientTelemetryCount > 0 ? "Client telemetry is arriving." : "Trust needs evidence."
        : ProtectionScore < 85 || JudgmentCount > 0 ? "Trust needs attention." : "Trust is operating normally.";
    private string DashboardSummary => ProtectionExplanation;
    private string DashboardDataSourceLabel => _summary?.DataSource switch
    {
        "BrowserPluginScanResults" => "Authoritative scan data",
        "ClientTelemetryOnly" => "Client telemetry only",
        _ => "No authoritative scan data"
    };
    private string JudgmentHeading => JudgmentCount == 0 ? "No judgments remain." : $"{JudgmentCount} {Pluralize(JudgmentCount, "judgment", "judgments")} remain.";
    private string OutcomeDistributionLabel => $"{TrustedPercent}% trusted, {CautionPercent}% caution, {RiskPercent}% risk";
    private string ClientOutcomeDistributionLabel => $"Client-observed distribution: {ClientTrustedPercent}% trusted, {ClientCautionPercent}% caution, {ClientRiskPercent}% risk; not authoritative";
    private string SystemStatusLabel => UnavailableSourceCount == 0 ? "Systems operational" : $"{UnavailableSourceCount} sources degraded";
    private string SystemStatusTone => UnavailableSourceCount == 0 ? "operational" : "degraded";
    private string PrioritySeverityTone => SeverityTone(PriorityThreat?.Severity);

    private IReadOnlyList<DailyOutcome> DailyOutcomes
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow); var firstDay = today.AddDays(-(_rangeDays - 1));
            return Enumerable.Range(0, 7).Select(index =>
            {
                var startOffset = (int)Math.Floor(index * _rangeDays / 7d); var endOffset = (int)Math.Floor((index + 1) * _rangeDays / 7d); var start = firstDay.AddDays(startOffset); var end = firstDay.AddDays(Math.Max(startOffset + 1, endOffset));
                var scans = RangeScans.Where(scan => { var date = DateOnly.FromDateTime(scan.LastCheckedUtc.UtcDateTime); return date >= start && date < end; }).ToArray();
                var trusted = CountStatuses(scans, "Trusted", "Safe"); var caution = CountStatuses(scans, "Limited", "Unknown", "Caution"); var risk = CountStatuses(scans, "Suspicious", "HighRisk", "Dangerous", "Critical");
                var label = _rangeDays == 7 ? start.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture) : $"{start.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)}–{end.AddDays(-1).ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)}";
                return new DailyOutcome(label, trusted, caution, risk, scans.Length);
            }).ToArray();
        }
    }

    private int CountCard(string key) { var card = Card(key); return card is null || card.IsPlaceholder ? 0 : card.Value; }
    private static int CountStatuses(IEnumerable<AdminRecentScanItem> scans, params string[] values) => scans.Count(scan => values.Any(value => scan.Status.Contains(value, StringComparison.OrdinalIgnoreCase)));
    private static int OutcomePercent(int value, int total) => total == 0 ? 0 : (int)Math.Round(value * 100d / total);
    private static int BucketPercent(int value, int total) => total == 0 ? 0 : Math.Max(3, (int)Math.Round(value * 100d / total));
    private int VolumePercent(int total) => total == 0 ? 0 : Math.Max(10, (int)Math.Round(total * 100d / MaxBucketTotal));
    private static string SegmentStyle(int percent) => $"--segment:{percent}";
    private string VolumeStyle(int total) => $"--volume:{VolumePercent(total)}";
    private static string BucketAriaLabel(DailyOutcome bucket) => $"{bucket.Label}: {bucket.Total} scans, {bucket.Trusted} trusted, {bucket.Caution} caution, {bucket.Risk} risk";
    private static string Pluralize(int value, string singular, string plural) => value == 1 ? singular : plural;
    private static string SeverityTone(string? severity) => severity?.ToLowerInvariant() switch { "critical" => "critical", "dangerous" or "high" or "highrisk" or "high risk" => "danger", "caution" or "warning" => "caution", _ => "neutral" };
    private static string HealthTone(string status) => status.ToLowerInvariant() switch { "healthy" or "online" or "available" or "evidence" => "healthy", "waiting" or "degraded" or "partial" => "waiting", _ => "unavailable" };
    private static string Relative(DateTimeOffset value) { var age = DateTimeOffset.UtcNow - value; return age.TotalMinutes < 60 ? $"{Math.Max(1, (int)age.TotalMinutes)}m ago" : age.TotalHours < 24 ? $"{(int)age.TotalHours}h ago" : $"{(int)age.TotalDays}d ago"; }
    private static string ThreatLink(AdminRecentThreatItem threat) => string.IsNullOrWhiteSpace(threat.RelatedScanId) ? "/review" : $"/scans/{Uri.EscapeDataString(threat.RelatedScanId)}";
    private static string ScanLink(AdminRecentScanItem scan) => $"/scans/{Uri.EscapeDataString(scan.ScanResultId)}";
    private static string Score(int? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—";
    private sealed record DailyOutcome(string Label, int Trusted, int Caution, int Risk, int Total) { public int Classified => Trusted + Caution + Risk; }
}
