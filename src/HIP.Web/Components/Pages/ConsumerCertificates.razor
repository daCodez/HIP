@page "/consumer/certificates"
@attribute [Authorize(Policy = ConsumerPolicies.CanUseConsumerPortal)]
@rendermode InteractiveServer
@using HIP.Application.Certificates
@using HIP.Domain.Certificates
@using System.Text.Json
@using System.Security.Claims
@inject IDomainCertificateOwnerQuery CertificateQuery
@inject IDomainCertificateEnrollmentService EnrollmentService
@inject IDomainCertificateApplicationService ApplicationService
@inject IDomainCertificateProvisioningService ProvisioningService
@inject IDomainCertificateMonitoringService MonitoringService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IJSRuntime JavaScript
@inject NavigationManager NavigationManager
@inject HipPortalLinks PortalLinks
@inject ILogger<ConsumerCertificates> Logger

<PageTitle>HIP Domain Certificates</PageTitle>

<main class="admin-rule-page owner-certificate-page">
    <section class="admin-rule-header">
        <div>
            <p class="eyebrow">Domain owner portal</p>

            <h1>Domain certificates</h1>
            <p>Track verified control, certificate eligibility, and current signed certificate status for domains connected to this account.</p>
        </div>
    </section>
    <section class="trust-growth-panel" aria-labelledby="trust-growth-heading">
        <h2 id="trust-growth-heading">How HIP trust strengthens</h2>
        <ul>
            <li><strong>Identity is separate:</strong> DNS, website, and identity checks can earn an identity-verified badge, but never prove the site is safe.</li>
            <li><strong>Monitoring is evidence:</strong> starting it runs an immediate HIP-owned check and schedules a new check every 24 hours.</li>
            <li><strong>Scores follow evidence:</strong> current authenticated identity, reputation, TLS, and safety evidence can strengthen trust; risk findings lower or block it.</li>
            <li><strong>Missing evidence is not a low score:</strong> HIP withholds the public number until coverage is sufficient.</li>
        </ul>
    </section>

    <section class="domain-enrollment-panel" aria-labelledby="start-verification-heading">
        <h2 id="start-verification-heading">Start verification</h2>
        <p>Adding a domain starts control verification. It does not issue a certificate or trusted badge.</p>
        <form @onsubmit="StartVerificationAsync" @onsubmit:preventDefault>
            <label>
                Public domain
                <input @bind="_domain" autocomplete="url" maxlength="253" placeholder="example.com" required
                       disabled="@(_loading || _starting)" />
            </label>
            <label>
                Public display name
                <input @bind="_displayName" maxlength="200" required disabled="@(_loading || _starting)" />
            </label>
            <button class="btn btn-primary" type="submit" disabled="@(_loading || _starting)">
                @(_loading ? "Loading…" : _starting ? "Starting…" : "Start verification")
            </button>
        </form>
        @if (_enrollmentError is not null)
        {
            <p class="admin-error" role="alert">@_enrollmentError</p>
        }
        else if (_enrollmentMessage is not null)
        {
            <p class="admin-message" role="status">@_enrollmentMessage</p>
        }

    </section>

    @if (_accessError is not null)
    {
        <p class="admin-error" role="alert">@_accessError</p>
    }
    else if (_loading)
    {
        <p class="admin-message" role="status">Loading your domain certificate progress…</p>
    }
    else if (_items.Count == 0)
    {
        <section class="domain-certificate-empty" aria-labelledby="empty-certificates-heading">
            <h2 id="empty-certificates-heading">No domain enrollments yet</h2>
            <p>Add a domain to begin control verification. Registration alone never creates a trusted HIP badge.</p>
        </section>
    }
    else
    {
        @if (_certificateActionError is not null)
        {
            <p class="admin-error" role="alert">@_certificateActionError</p>
        }
        else if (_certificateActionMessage is not null)
        {
            <p class="admin-message" role="status">@_certificateActionMessage</p>
        }
        @foreach (var item in _items)
        {
            <article class="domain-certificate-card @StatusClass(item)" aria-labelledby="@HeadingId(item)">
                <header>
                    <div>
                        <p class="eyebrow">HIP Domain Trust Certificate</p>
                        <h2 id="@HeadingId(item)">@item.Domain</h2>
                    </div>
                    <span class="owner-certificate-status">@CertificateStatus(item)</span>
                </header>

                <section class="owner-certificate-facts" aria-label="Current certificate facts">
                    <article><span>Domain ownership</span><strong>@OwnershipStatus(item)</strong></article>
                    <article><span>Certificate status</span><strong>@CertificateStatus(item)</strong></article>
                    <article><span>Application status</span><strong>@item.ApplicationStatus</strong></article>
                    <article><span>Badge level</span><strong>@(item.BadgeLevel?.ToString() ?? "Not issued")</strong></article>
                    <article><span>Current HIP score</span><strong>@(item.CurrentScore?.ToString() ?? "Not available")</strong></article>
                    <article><span>Monitoring status</span><strong>@MonitoringStatus(item)</strong></article>
                    <article><span>Certificate expiration</span><strong>@FormatDate(item.ExpiresAtUtc)</strong></article>
                    <article><span>Last successful verification</span><strong>@FormatDate(item.LastVerificationAtUtc ?? item.WebsiteVerifiedAtUtc ?? item.DnsVerifiedAtUtc)</strong></article>
                    <article><span>Unresolved requirements</span><strong>@item.UnresolvedCriticalFindings critical</strong></article>
                </section>

                @if (item.CertificateStatus == DomainCertificateStatus.Active && item.CertificateId is not null)
                {
                    <section class="badge-installation" aria-labelledby="@BadgeInstallationHeadingId(item)">
                        <h3 id="@BadgeInstallationHeadingId(item)">Install live badge</h3>
                        <p>Copy this exact code into the public page for <strong>@item.Domain</strong>. The badge stays bound to the current signed certificate and live HIP status.</p>
                        <pre><code>@BadgeEmbedCode(item.Domain)</code></pre>
                        <p class="badge-installation-notice">@BadgeInstallationNotice()</p>
                        <div class="badge-installation-actions">
                            <button class="btn btn-primary" type="button" @onclick="() => CopyBadgeEmbedAsync(item.Domain)">Copy badge code</button>
                            <a class="btn" href="@BadgeApiUrl(item.Domain)" target="_blank" rel="noopener noreferrer">Check live badge data</a>
                        </div>
                    </section>
                }

                <section class="verification-progress" aria-labelledby="@ProgressHeadingId(item)">
                    <h3 id="@ProgressHeadingId(item)">Verification progress</h3>
                    <p class="verification-progress-help">
                        A checkmark means complete. The highlighted numbered step is the next action.
                    </p>
                    <ol>
                        @ProgressStep("Domain added", "Add domain", true, item, 0)
                        @ProgressStep("DNS verified", "Check DNS", item.DnsVerifiedAtUtc is not null, item, 1)
                        @ProgressStep("Website verified", "Verify website", item.WebsiteVerifiedAtUtc is not null, item, 2)
                        @ProgressStep("Identity completed", "Complete identity", item.IdentityCompletedAtUtc is not null, item, 3)
                        @ProgressStep("Application submitted", "Submit application", item.ApplicationSubmittedAtUtc is not null, item, 4)
                        @ProgressStep("Application approved", "Await application decision", item.ApplicationStatus == DomainCertificateApplicationStatus.Approved, item, 5)
                        @ProgressStep("Security review completed", "Await security review", item.SecurityReviewCompletedAtUtc is not null, item, 6)
                        @ProgressStep("Certificate issued", "Await certificate", item.CertificateId is not null, item, 7)
                        @ProgressStep("Monitoring active", "Start monitoring", item.EnrollmentStatus == DomainEnrollmentStatus.Monitored, item, 8)
                    </ol>
                </section>

                @if (item.EnrollmentStatus == DomainEnrollmentStatus.PendingSecurityReview && item.IdentityCompletedAtUtc is null)
                {
                    <section class="certificate-identity-panel" aria-labelledby="@IdentityHeadingId(item)">
                        <h3 id="@IdentityHeadingId(item)">Identity details</h3>
                        <p>Only fields marked for public display can appear on the public certificate. HIP stores only a one-way marker for the private security contact.</p>
                        <form @onsubmit="() => CompleteIdentityProfileAsync(item)" @onsubmit:preventDefault>
                            <label>Public display name<input @bind="_identityDisplayName" maxlength="200" required /></label>
                            <label>Organization name<input @bind="_identityOrganizationName" maxlength="200" /></label>
                            <label>Public contact URL<input @bind="_identityPublicContact" type="url" maxlength="320" placeholder="https://example.com/contact" /></label>
                            <label>Private security email<input @bind="_identitySecurityContact" type="email" maxlength="320" required autocomplete="email" /></label>
                            <label>Country or region<input @bind="_identityCountry" maxlength="100" /></label>
                            <label class="certificate-privacy-choice"><input @bind="_publishOrganization" type="checkbox" /> Show organization on the public certificate</label>
                            <label class="certificate-privacy-choice"><input @bind="_publishCountry" type="checkbox" /> Show country or region on the public certificate</label>
                            <button class="btn btn-primary" type="submit" disabled="@_savingIdentity">@(_savingIdentity ? "Saving…" : "Save identity details")</button>
                        </form>
                    </section>
                }

                <footer class="owner-certificate-actions">
                    @if (item.EnrollmentStatus == DomainEnrollmentStatus.PendingOwnership && item.DnsVerifiedAtUtc is null)
                    {
                        @if (_dnsChallenges.TryGetValue(item.Domain, out var dnsChallenge) &&
                             dnsChallenge.Status == DomainCertificateDnsChallengeStatus.Available &&
                             dnsChallenge.ChallengeToken is not null)
                        {
                            <div class="dns-challenge">
                                <h4>Current DNS TXT record</h4>
                                <p>Use this exact current value. Replace any earlier HIP verification value for this domain.</p>
                                <dl>
                                    <div><dt>Name</dt><dd><code>_hip.@item.Domain</code></dd></div>
                                    <div><dt>Value</dt><dd><code>hip-site-verification=@dnsChallenge.ChallengeToken</code></dd></div>
                                    <div><dt>Expires</dt><dd>@FormatDate(dnsChallenge.ChallengeExpiresAtUtc)</dd></div>
                                </dl>
                                <button class="btn" type="button"
                                        @onclick="() => CopyDnsRecordAsync(item.Domain, dnsChallenge.ChallengeToken)">
                                    Copy current DNS record
                                </button>
                            </div>
                            <button class="btn btn-primary" type="button" disabled="@(_checkingEnrollmentId is not null)"
                                    @onclick="() => CheckDnsAsync(item)">
                                @(_checkingEnrollmentId == item.EnrollmentId ? "Checking…" : "Check DNS")
                            </button>
                        }
                        else if (dnsChallenge?.Status == DomainCertificateDnsChallengeStatus.Expired)
                        {
                            <p class="admin-error" role="status">This DNS challenge expired. Start verification again to receive a replacement value.</p>
                        }
                        else
                        {
                            <p class="admin-error" role="status">HIP no longer has a current DNS value for this pending enrollment.</p>
                            <button class="btn btn-primary" type="button"
                                    disabled="@(_replacingDnsEnrollmentId is not null)"
                                    @onclick="() => GenerateReplacementDnsChallengeAsync(item)">
                                @(_replacingDnsEnrollmentId == item.EnrollmentId ? "Generating…" : "Generate replacement DNS value")
                            </button>
                        }
                    }
                    @if (item.EnrollmentStatus == DomainEnrollmentStatus.OwnershipVerified &&
                         item.DnsVerifiedAtUtc is not null &&
                         item.WebsiteVerifiedAtUtc is null)
                    {
                        <button class="btn btn-primary" type="button" disabled="@(_preparingWebsiteEnrollmentId is not null)"
                                @onclick="() => PrepareWebsiteVerificationAsync(item)">
                            @(_preparingWebsiteEnrollmentId == item.EnrollmentId ? "Preparing…" : "Prepare website file")
                        </button>
                        @if (_websiteEnrollmentId == item.EnrollmentId && _websiteDocumentJson is not null)
                        {
                            <div class="website-verification-instructions">
                                <p>Download this public challenge file and publish it at <code>https://@item.Domain/.well-known/hip.json</code>.</p>
                                <a class="btn" href="@WebsiteDocumentDownloadUrl()" download="hip.json">Download hip.json</a>
                            </div>
                        }
                        <button class="btn btn-primary" type="button" disabled="@(_checkingWebsiteEnrollmentId is not null)"
                                @onclick="() => CheckWebsiteAsync(item)">
                            @(_checkingWebsiteEnrollmentId == item.EnrollmentId ? "Verifying…" : "Verify website")
                        </button>
                    }
                    @if (item.IdentityCompletedAtUtc is not null && item.CertificateId is null &&
                         item.ApplicationStatus is DomainCertificateApplicationStatus.Draft or DomainCertificateApplicationStatus.ChangesRequested)
                    {
                        <section class="certificate-application-attestation" aria-label="Certificate application declarations">
                            <h3>Submit certificate application</h3>
                            <p>HIP binds these declarations to your authenticated account, verified domain, identity profile, policy version, and an integrity digest.</p>
                            <label class="certificate-privacy-choice"><input @bind="_authorityConfirmed" type="checkbox" /> @DomainCertificateApplicantAttestation.AuthorityStatement</label>
                            <label class="certificate-privacy-choice"><input @bind="_accuracyConfirmed" type="checkbox" /> @DomainCertificateApplicantAttestation.AccuracyStatement</label>
                            <button class="btn btn-primary" type="button"
                                    disabled="@(_submittingApplication || !_authorityConfirmed || !_accuracyConfirmed)"
                                    @onclick="() => SubmitApplicationAsync(item)">
                                @(_submittingApplication ? "Submitting…" : "Submit application")
                            </button>
                        </section>
                    }
                    else if (item.ApplicationStatus == DomainCertificateApplicationStatus.Submitted)
                    {
                        <p class="admin-message" role="status">Application submitted. After an authorized HIP reviewer approves it, you can run HIP's security review. Eligible reviews issue the signed certificate automatically.</p>
                    }
                    else if (item.ApplicationStatus == DomainCertificateApplicationStatus.Denied)
                    {
                        <p class="admin-error" role="alert">This application was denied. Contact HIP support before submitting new evidence.</p>
                    }
                    @if (item.IdentityCompletedAtUtc is not null && item.CertificateId is null &&
                         item.ApplicationStatus == DomainCertificateApplicationStatus.Approved &&
                         item.EnrollmentStatus is DomainEnrollmentStatus.PendingSecurityReview or DomainEnrollmentStatus.Verified)
                    {
                        <button class="btn btn-primary" type="button" disabled="@(_reviewingEnrollmentId is not null)"
                                @onclick="() => ReviewAndIssueAsync(item)">
                            @(_reviewingEnrollmentId == item.EnrollmentId ? "Reviewing and issuing…" : "Run security review and issue certificate")
                        </button>
                    }
                    @if (item.CertificateId is not null)
                    {
                        <a class="btn btn-primary" href="@PortalLinks.Public($"/certificate/{Uri.EscapeDataString(item.CertificateId)}")" data-enhance-nav="false">View public certificate</a>
                    }
                    @if (item.CertificateId is not null && item.CertificateStatus == DomainCertificateStatus.Active)
                    {
                        <button class="btn btn-primary" type="button" disabled="@(_monitoringEnrollmentId is not null)"
                                @onclick="() => StartMonitoringAsync(item)">
                            @(_monitoringEnrollmentId == item.EnrollmentId
                                ? "Checking monitoring evidence…"
                                : item.MonitoringEnabledAtUtc is null ? "Start monitoring" : "Refresh monitoring evidence")
                        </button>
                    }
                    <span>Verification and lifecycle actions appear only when the stored state permits them.</span>
                </footer>
            </article>
        }
    }
</main>

@code {
    private IReadOnlyList<OwnerDomainCertificateSummary> _items = [];
    private bool _loading = true;
    private string? _accessError;

    private string _domain = string.Empty;
    private string _displayName = string.Empty;
    private bool _starting;
    private string? _enrollmentMessage;
    private string? _enrollmentError;
    private DomainCertificateEnrollmentStartResult? _challenge;
    private IReadOnlyDictionary<string, DomainCertificateDnsChallengeResult> _dnsChallenges =
        new Dictionary<string, DomainCertificateDnsChallengeResult>(StringComparer.Ordinal);
    private string? _replacingDnsEnrollmentId;
    private string? _checkingEnrollmentId;
    private string? _reviewingEnrollmentId;
    private string? _monitoringEnrollmentId;
    private string? _preparingWebsiteEnrollmentId;
    private string? _checkingWebsiteEnrollmentId;
    private string? _websiteEnrollmentId;
    private string? _websiteDocumentJson;
    private string? _certificateActionMessage;
    private string? _certificateActionError;
    private string _identityDisplayName = string.Empty;
    private string _identityOrganizationName = string.Empty;
    private string _identityPublicContact = string.Empty;
    private string _identitySecurityContact = string.Empty;
    private string _identityCountry = string.Empty;
    private bool _publishOrganization;
    private bool _publishCountry;
    private bool _savingIdentity;
    private bool _submittingApplication;
    private bool _authorityConfirmed;
    private bool _accuracyConfirmed;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _loading = true;
        _accessError = null;
        var access = await HipConsumerPageAccess.ExecuteAsync(
            authenticationState.User,
            consumerId => CertificateQuery.ListForOwnerAsync(
                consumerId,
                offset: 0,
                limit: 50,
                CancellationToken.None));
        if (!access.Succeeded)
        {
            _accessError = HipConsumerPageAccess.AccessUnavailableMessage;
        }
        else
        {
            _items = access.Value ?? [];
            await LoadDnsChallengesAsync(authenticationState.User);
        }

        _loading = false;
    }

    /// <summary>Reloads publishable DNS challenges only for pending enrollments owned by this account.</summary>
    private async Task LoadDnsChallengesAsync(ClaimsPrincipal principal)
    {
        var pendingDomains = _items
            .Where(item => item.EnrollmentStatus == DomainEnrollmentStatus.PendingOwnership &&
                           item.DnsVerifiedAtUtc is null)
            .Select(item => item.Domain)
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        if (pendingDomains.Length == 0)
        {
            _dnsChallenges = new Dictionary<string, DomainCertificateDnsChallengeResult>(StringComparer.Ordinal);
            return;
        }

        var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
            principal,
            AuthorizationService,
            ConsumerPolicies.CanUseConsumerPortal,
            consumerId => LoadDnsChallengesForOwnerAsync(
                consumerId,
                WebsiteOwnerActorId(principal, consumerId),
                pendingDomains));
        _dnsChallenges = access.Succeeded && access.Value is not null
            ? access.Value
            : new Dictionary<string, DomainCertificateDnsChallengeResult>(StringComparer.Ordinal);
    }

    /// <summary>Loads each owner-bound challenge without exposing it through the public certificate query.</summary>
    private async Task<IReadOnlyDictionary<string, DomainCertificateDnsChallengeResult>> LoadDnsChallengesForOwnerAsync(
        string consumerId,
        string websiteOwnerActorId,
        IReadOnlyCollection<string> domains)
    {
        var challenges = new Dictionary<string, DomainCertificateDnsChallengeResult>(StringComparer.Ordinal);
        foreach (var domain in domains)
        {
            challenges[domain] = await EnrollmentService.GetCurrentDnsChallengeAsync(
                consumerId,
                websiteOwnerActorId,
                domain,
                CancellationToken.None);
        }

        return challenges;
    }

    private async Task StartVerificationAsync()
    {
        _starting = true;
        _enrollmentError = null;
        _enrollmentMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.StartAsync(
                    consumerId,
                    WebsiteOwnerActorId(authenticationState.User, consumerId),
                    new DomainCertificateEnrollmentStartRequest(
                        _domain,
                        _displayName,
                        VerificationMethod.DnsTxt),
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _enrollmentError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            _challenge = access.Value;
            if (_challenge.Status is DomainCertificateEnrollmentStartStatus.Started or
                DomainCertificateEnrollmentStartStatus.Existing)
            {
                _enrollmentMessage = "Enrollment saved. Add the DNS record below, then return to check verification.";
                await LoadAsync();
            }
            else
            {
                _enrollmentError = _challenge.Status switch
                {
                    DomainCertificateEnrollmentStartStatus.InvalidRequest =>
                        "Enter a valid public domain and display name.",
                    DomainCertificateEnrollmentStartStatus.Conflict =>
                        "This domain is linked to a different HIP account. Sign in with that account or use domain ownership recovery.",
                    DomainCertificateEnrollmentStartStatus.IdentityKeyUnavailable =>
                        "New domain verification is temporarily unavailable while HIP's managed production identity-key service is being configured. Existing certificate information was not changed.",
                    DomainCertificateEnrollmentStartStatus.PersistenceUnavailable =>
                        "HIP could not save this enrollment right now. The existing domain identity was not changed; retry in a moment.",
                    _ => "HIP could not start this enrollment right now."
                };
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "HIP could not start the authenticated domain verification enrollment.");
            _enrollmentError = "HIP could not start this enrollment right now. No domain identity was changed.";
        }
        finally
        {
            _starting = false;
        }
    }

    /// <summary>Creates a replacement only after the owner explicitly requests one.</summary>
    private async Task GenerateReplacementDnsChallengeAsync(OwnerDomainCertificateSummary item)
    {
        _replacingDnsEnrollmentId = item.EnrollmentId;
        _enrollmentError = null;
        _enrollmentMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.StartAsync(
                    consumerId,
                    WebsiteOwnerActorId(authenticationState.User, consumerId),
                    new DomainCertificateEnrollmentStartRequest(
                        item.Domain,
                        item.Domain,
                        VerificationMethod.DnsTxt),
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _enrollmentError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            var result = access.Value;
            if (result.Status is not (
                    DomainCertificateEnrollmentStartStatus.Started or
                    DomainCertificateEnrollmentStartStatus.Existing) ||
                result.ChallengeToken is null ||
                result.ChallengeExpiresAtUtc is null)
            {
                _enrollmentError = result.Status switch
                {
                    DomainCertificateEnrollmentStartStatus.Conflict =>
                        "HIP could not replace this DNS value because the domain ownership binding changed.",
                    DomainCertificateEnrollmentStartStatus.IdentityKeyUnavailable =>
                        "HIP's managed production identity-key service is not available. The current DNS value was not changed.",
                    _ => "HIP could not generate a replacement DNS value right now."
                };
                return;
            }

            var challenges = new Dictionary<string, DomainCertificateDnsChallengeResult>(
                _dnsChallenges.Count + 1,
                StringComparer.Ordinal);
            foreach (var challenge in _dnsChallenges)
            {
                challenges[challenge.Key] = challenge.Value;
            }
            challenges[item.Domain] = new DomainCertificateDnsChallengeResult(
                DomainCertificateDnsChallengeStatus.Available,
                item.Domain,
                result.ChallengeToken,
                result.ChallengeExpiresAtUtc);
            _dnsChallenges = challenges;
            _enrollmentMessage = "Replacement DNS value generated. Copy it below and replace the earlier TXT value.";
        }
        finally
        {
            _replacingDnsEnrollmentId = null;
        }
    }
    /// <summary>Copies only the current owner-authorized DNS challenge shown on this page.</summary>
    private async Task CopyDnsRecordAsync(string domain, string challengeToken)
    {
        var record = $"_hip.{domain} TXT \"hip-site-verification={challengeToken}\"";
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", record);
        _enrollmentMessage = "Current DNS record copied.";
    }

    private async Task CheckDnsAsync(OwnerDomainCertificateSummary item)
    {
        _checkingEnrollmentId = item.EnrollmentId;
        _enrollmentError = null;
        _enrollmentMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.CheckDnsAsync(
                    consumerId,
                    WebsiteOwnerActorId(authenticationState.User, consumerId),
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _enrollmentError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateDnsCheckStatus.Verified)
            {
                _enrollmentMessage = "DNS domain control verified. HIP recorded the ownership transition.";
                await LoadAsync();
            }
            else if (access.Value.Status == DomainCertificateDnsCheckStatus.Pending)
            {
                _enrollmentMessage = "HIP did not find the matching DNS record yet. DNS propagation can take time.";
            }
            else
            {
                _enrollmentError = "HIP could not verify this DNS record right now. The stored challenge was not changed.";
            }
        }
        finally
        {
            _checkingEnrollmentId = null;
        }
    }
    private async Task PrepareWebsiteVerificationAsync(OwnerDomainCertificateSummary item)
    {
        _preparingWebsiteEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.PrepareWebsiteVerificationAsync(
                    consumerId,
                    WebsiteOwnerActorId(authenticationState.User, consumerId),
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateWebsitePrepareStatus.Ready && access.Value.Document is not null)
            {
                _websiteEnrollmentId = item.EnrollmentId;
                _websiteDocumentJson = JsonSerializer.Serialize(
                    access.Value.Document,
                    new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });
                _certificateActionMessage = "Website challenge ready. Publish the downloaded file, then check the website.";
            }
            else
            {
                _certificateActionError = access.Value.Status == DomainCertificateWebsitePrepareStatus.NotReady
                    ? "Complete DNS verification before preparing the website challenge."
                    : "HIP could not prepare the website challenge right now.";
            }
        }
        finally
        {
            _preparingWebsiteEnrollmentId = null;
        }
    }

    private async Task CheckWebsiteAsync(OwnerDomainCertificateSummary item)
    {
        _checkingWebsiteEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.CheckWebsiteAsync(
                    consumerId,
                    WebsiteOwnerActorId(authenticationState.User, consumerId),
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateWebsiteCheckStatus.Verified)
            {
                _certificateActionMessage = "HTTPS website control verified. HIP moved this enrollment to security review.";
                _websiteEnrollmentId = null;
                _websiteDocumentJson = null;
                await LoadAsync();
            }
            else if (access.Value.Status == DomainCertificateWebsiteCheckStatus.Pending)
            {
                _certificateActionMessage = "HIP did not find the matching challenge file yet. Confirm the fixed HTTPS path and try again.";
            }
            else
            {
                _certificateActionError = "HIP could not verify the website right now. The enrollment was not advanced.";
            }
        }
        finally
        {
            _checkingWebsiteEnrollmentId = null;
        }
    }

    private async Task CompleteIdentityProfileAsync(OwnerDomainCertificateSummary item)
    {
        _savingIdentity = true;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.CompleteIdentityProfileAsync(
                    consumerId,
                    item.Domain,
                    new DomainCertificateIdentityProfileRequest(
                        _identityDisplayName, _identityOrganizationName, _identityPublicContact,
                        _identitySecurityContact, _identityCountry, _publishOrganization, _publishCountry),
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }
            if (access.Value.Status is DomainCertificateIdentityProfileStatus.Completed or DomainCertificateIdentityProfileStatus.Existing)
            {
                _certificateActionMessage = "Identity details saved. HIP can now evaluate stored security evidence.";
                _identitySecurityContact = string.Empty;
                await LoadAsync();
            }
            else
            {
                _certificateActionError = access.Value.Status == DomainCertificateIdentityProfileStatus.InvalidRequest
                    ? "Check the identity fields and use an HTTPS public contact URL."
                    : "HIP could not save the identity details right now.";
            }
        }
        finally
        {
            _savingIdentity = false;
        }
    }

    private async Task SubmitApplicationAsync(OwnerDomainCertificateSummary item)
    {
        _submittingApplication = true;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => ApplicationService.SubmitAsync(
                    consumerId,
                    item.Domain,
                    _authorityConfirmed,
                    _accuracyConfirmed,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status is DomainCertificateApplicationSubmissionStatus.Submitted or
                DomainCertificateApplicationSubmissionStatus.Existing)
            {
                _certificateActionMessage = "Application submitted with an authenticated attestation digest.";
                _authorityConfirmed = false;
                _accuracyConfirmed = false;
                await LoadAsync();
            }
            else
            {
                _certificateActionError = access.Value.Status == DomainCertificateApplicationSubmissionStatus.NotReady
                    ? "Complete domain, website, and identity verification before submitting."
                    : "HIP could not submit this application right now.";
            }
        }
        finally
        {
            _submittingApplication = false;
        }
    }

    private async Task StartMonitoringAsync(OwnerDomainCertificateSummary item)
    {
        _monitoringEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var contactVerified = string.Equals(
                authenticationState.User.FindFirst(HipAuthenticationClaimTypes.AccountContactVerified)?.Value,
                "true",
                StringComparison.Ordinal);
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => MonitoringService.StartAsync(
                    consumerId,
                    item.Domain,
                    contactVerified,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            _certificateActionMessage = access.Value.Status switch
            {
                DomainCertificateMonitoringStartStatus.Activated =>
                    $"Monitoring is active. HIP stored fresh authoritative evidence with a score of {access.Value.CurrentScore}/100.",
                DomainCertificateMonitoringStartStatus.EnabledPendingEvidence when access.Value.CurrentScore is not null =>
                    $"Monitoring is enabled. The current authenticated evidence score is {access.Value.CurrentScore}/100; HIP will keep checking for the 70-point monitored threshold.",
                DomainCertificateMonitoringStartStatus.EnabledPendingEvidence =>
                    "Monitoring is enabled. HIP will retry the authoritative check when evidence providers are available.",
                DomainCertificateMonitoringStartStatus.Existing =>
                    "Monitoring was already enabled for this domain.",
                _ => null
            };
            _certificateActionError = access.Value.Status switch
            {
                DomainCertificateMonitoringStartStatus.NotFound =>
                    "HIP could not find an enrollment for this account and domain.",
                DomainCertificateMonitoringStartStatus.NotReady =>
                    "Monitoring requires an active verified certificate and completed ownership and identity checks.",
                DomainCertificateMonitoringStartStatus.Conflict =>
                    "The certificate changed while monitoring was being enabled. HIP did not overwrite the newer state.",
                DomainCertificateMonitoringStartStatus.Unavailable =>
                    "HIP could not save monitoring state right now. No monitoring claim was issued.",
                _ => null
            };
            await LoadAsync();
        }
        finally
        {
            _monitoringEnrollmentId = null;
        }
    }
    private async Task ReviewAndIssueAsync(OwnerDomainCertificateSummary item)
    {
        _reviewingEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var contactVerified = string.Equals(
                authenticationState.User.FindFirst(HIP.Web.Security.HipAuthenticationClaimTypes.AccountContactVerified)?.Value,
                "true",
                StringComparison.Ordinal);
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => ProvisioningService.ReviewAndIssueAsync(
                    consumerId,
                    item.Domain,
                    contactVerified,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            _certificateActionMessage = access.Value.Status switch
            {
                DomainCertificateProvisioningStatus.Issued or DomainCertificateProvisioningStatus.Existing =>
                    "Security review passed and the signed HIP certificate is available.",
                DomainCertificateProvisioningStatus.ReviewRequired =>
                    "HIP stored the scan, but an authorized reviewer must decide this case.",
                DomainCertificateProvisioningStatus.Ineligible =>
                    "HIP stored the scan. One or more certificate requirements still need attention.",
                _ => null
            };
            _certificateActionError = access.Value.Status switch
            {
                DomainCertificateProvisioningStatus.NotFound =>
                    "HIP could not find the current domain enrollment for this account.",
                DomainCertificateProvisioningStatus.NotReady =>
                    "This application is not ready for security review. Complete every required verification and approval step.",
                DomainCertificateProvisioningStatus.ScanUnavailable =>
                    "HIP could not complete the security scan. No trust assertion was issued; retry when scanning is available.",
                DomainCertificateProvisioningStatus.PersistenceUnavailable =>
                    "HIP could not store the security review. No trust assertion was issued; retry when storage is available.",
                DomainCertificateProvisioningStatus.Conflict =>
                    "The certificate application changed while HIP was reviewing it. The latest state was loaded; review it and retry.",
                DomainCertificateProvisioningStatus.IssuanceUnavailable =>
                    "The security review passed, but HIP could not sign and store the certificate. The approved review is saved and issuance can be retried.",
                _ => null
            };
            await LoadAsync();
        }
        finally
        {
            _reviewingEnrollmentId = null;
        }
    }

    /// <summary>Uses the authenticated actor for website ownership while retaining consumer account storage scope.</summary>
    private static string WebsiteOwnerActorId(ClaimsPrincipal principal, string consumerId) =>
        principal.FindFirst(HipAuthenticationClaimTypes.ActorId)?.Value is { Length: > 0 } actorId
            ? actorId
            : consumerId;

    /// <summary>Copies an environment-correct, domain-bound badge embed without account data.</summary>
    private async Task CopyBadgeEmbedAsync(string domain)
    {
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", BadgeEmbedCode(domain));
        _certificateActionMessage = "Badge code copied. Publish it on the exact verified hostname.";
    }

    private string BadgeEmbedCode(string domain) =>
        $"<div data-hip-badge=\"{domain}\"></div>{Environment.NewLine}" +
        $"<script src=\"{BadgeScriptUrl(domain)}\" async></script>";

    private string BadgeApiUrl(string domain) =>
        $"{HipWebOrigin()}/api/v1/badge/{Uri.EscapeDataString(domain)}";

    private string BadgeScriptUrl(string domain) =>
        $"{BadgeApiUrl(domain)}/script";

    private string BadgeInstallationNotice()
    {
        var origin = new Uri(HipWebOrigin(), UriKind.Absolute);
        return origin.IsLoopback
            ? "This code currently uses a local HIP address. It works only in this browser while HIP is running on this computer. Publish a public HTTPS HIP origin before showing the badge to visitors."
            : "The badge retrieves only public certificate and trust status. It does not receive page text, form values, cookies, or visitor identity.";
    }

    private string HipWebOrigin()
    {
        var currentOrigin = NavigationManager.BaseUri.TrimEnd('/');
        return new Uri(currentOrigin, UriKind.Absolute).IsLoopback
            ? currentOrigin
            : PortalLinks.Public("/").TrimEnd('/');
    }

    private string WebsiteDocumentDownloadUrl() =>
        $"data:application/hip+json;charset=utf-8,{Uri.EscapeDataString(_websiteDocumentJson ?? string.Empty)}";

    /// <summary>
    /// Uses action wording until a step is complete so numbered steps never imply success.
    /// </summary>
    private static RenderFragment ProgressStep(
        string completedLabel,
        string incompleteLabel,
        bool complete,
        OwnerDomainCertificateSummary item,
        int index) => builder =>
    {
        var state = complete ? "complete" : IsFailed(item) ? "failed" : IsCurrent(item, index) ? "current" : "pending";
        var label = complete ? completedLabel : incompleteLabel;
        builder.OpenElement(0, "li");

        builder.AddAttribute(1, "class", $"progress-step progress-{state}");
        builder.AddAttribute(2, "aria-label", $"{label}: {state}");
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.AddContent(5, complete ? "✓" : index + 1);
        builder.CloseElement();
        builder.AddContent(6, label);
        builder.CloseElement();
    };

    private static bool IsCurrent(OwnerDomainCertificateSummary item, int index)
    {
        var completed = new[]
        {
            true,
            item.DnsVerifiedAtUtc is not null,
            item.WebsiteVerifiedAtUtc is not null,
            item.IdentityCompletedAtUtc is not null,
            item.ApplicationSubmittedAtUtc is not null,
            item.ApplicationStatus == DomainCertificateApplicationStatus.Approved,
            item.SecurityReviewCompletedAtUtc is not null,
            item.CertificateId is not null,
            item.EnrollmentStatus == DomainEnrollmentStatus.Monitored
        };
        return index >= 0 &&
               index < completed.Length &&
               !completed[index] &&
               Array.FindIndex(completed, value => !value) == index;
    }

    private static bool IsFailed(OwnerDomainCertificateSummary item) =>
        item.EnrollmentStatus is DomainEnrollmentStatus.Suspended or DomainEnrollmentStatus.Revoked ||
        item.CertificateStatus is DomainCertificateStatus.Suspended or DomainCertificateStatus.Revoked;

    private static string StatusClass(OwnerDomainCertificateSummary item) => IsFailed(item)
        ? "domain-certificate-critical"
        : item.CertificateStatus == DomainCertificateStatus.Active
            ? "domain-certificate-active"
            : item.EnrollmentStatus is DomainEnrollmentStatus.PendingOwnership or DomainEnrollmentStatus.PendingSecurityReview
                ? "domain-certificate-caution"
                : "domain-certificate-inactive";

    private static string OwnershipStatus(OwnerDomainCertificateSummary item)
    {
        if (item.DnsVerifiedAtUtc is not null || item.WebsiteVerifiedAtUtc is not null)
        {
            return "Verified";
        }

        return item.EnrollmentStatus switch
        {
            DomainEnrollmentStatus.Draft => "Not started",
            DomainEnrollmentStatus.PendingOwnership => "Verification pending",
            DomainEnrollmentStatus.OwnershipVerified or
            DomainEnrollmentStatus.PendingSecurityReview or
            DomainEnrollmentStatus.Verified or
            DomainEnrollmentStatus.Monitored => "Verified",
            DomainEnrollmentStatus.Suspended => "Verification suspended",
            DomainEnrollmentStatus.Revoked => "Verification revoked",
            _ => "Not verified"
        };
    }

    private static string CertificateStatus(OwnerDomainCertificateSummary item) =>
        item.CertificateStatus?.ToString() ?? "Not issued";

    private static string MonitoringStatus(OwnerDomainCertificateSummary item) =>
        item.EnrollmentStatus == DomainEnrollmentStatus.Monitored
            ? $"Active · last checked {FormatDate(item.LastMonitoringAtUtc)}"
            : item.MonitoringEnabledAtUtc is not null
                ? $"Enabled · gathering evidence · next check {FormatDate(item.MonitoringNextCheckAtUtc)}"
                : "Not active";

    private static string FormatDate(DateTimeOffset? timestamp) => timestamp?.ToString("u") ?? "Not available";
    private static string IdentityHeadingId(OwnerDomainCertificateSummary item) => $"identity-{SafeId(item.EnrollmentId)}";

    private static string HeadingId(OwnerDomainCertificateSummary item) => $"certificate-{SafeId(item.EnrollmentId)}";
    private static string ProgressHeadingId(OwnerDomainCertificateSummary item) => $"progress-{SafeId(item.EnrollmentId)}";
    private static string BadgeInstallationHeadingId(OwnerDomainCertificateSummary item) => $"badge-installation-{SafeId(item.EnrollmentId)}";
    private static string SafeId(string value) => string.Concat(value.Select(character => char.IsLetterOrDigit(character) ? character : '-'));
}
