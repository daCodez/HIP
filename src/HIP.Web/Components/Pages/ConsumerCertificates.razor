@page "/consumer/certificates"
@attribute [Authorize(Policy = ConsumerPolicies.CanUseConsumerPortal)]
@rendermode InteractiveServer
@using HIP.Application.Certificates
@using HIP.Domain.Certificates
@using System.Text.Json
@inject IDomainCertificateOwnerQuery CertificateQuery
@inject IDomainCertificateEnrollmentService EnrollmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IJSRuntime JavaScript

<PageTitle>HIP Domain Certificates</PageTitle>

<main class="admin-rule-page owner-certificate-page">
    <section class="admin-rule-header">
        <div>
            <p class="eyebrow">Domain owner portal</p>

            <h1>Domain certificates</h1>
            <p>Track verified control, certificate eligibility, and current signed certificate status for domains connected to this account.</p>
        </div>
    </section>
    <section class="domain-enrollment-panel" aria-labelledby="start-verification-heading">
        <h2 id="start-verification-heading">Start verification</h2>
        <p>Adding a domain starts control verification. It does not issue a certificate or trusted badge.</p>
        <form @onsubmit="StartVerificationAsync" @onsubmit:preventDefault>
            <label>
                Public domain
                <input @bind="_domain" autocomplete="url" maxlength="253" placeholder="example.com" required />
            </label>
            <label>
                Public display name
                <input @bind="_displayName" maxlength="200" required />
            </label>
            <button class="btn btn-primary" type="submit" disabled="@_starting">
                @(_starting ? "Starting…" : "Start verification")
            </button>
        </form>
        @if (_enrollmentError is not null)
        {
            <p class="admin-error" role="alert">@_enrollmentError</p>
        }
        else if (_enrollmentMessage is not null)
        {
            <p class="admin-message" role="status">@_enrollmentMessage</p>
        }
        @if (_challenge is not null && _challenge.ChallengeToken is not null)
        {
            <div class="dns-challenge">
                <h3>Add this DNS TXT record</h3>
                <dl>
                    <div><dt>Name</dt><dd><code>_hip.@_challenge.Domain</code></dd></div>
                    <div><dt>Value</dt><dd><code>hip-site-verification=@_challenge.ChallengeToken</code></dd></div>
                    <div><dt>Expires</dt><dd>@FormatDate(_challenge.ChallengeExpiresAtUtc)</dd></div>
                </dl>
                <button class="btn" type="button" @onclick="CopyDnsRecordAsync">Copy DNS record</button>
            </div>
        }
    </section>

    @if (_accessError is not null)
    {
        <p class="admin-error" role="alert">@_accessError</p>
    }
    else if (_loading)
    {
        <p class="admin-message" role="status">Loading your domain certificate progress…</p>
    }
    else if (_items.Count == 0)
    {
        <section class="domain-certificate-empty" aria-labelledby="empty-certificates-heading">
            <h2 id="empty-certificates-heading">No domain enrollments yet</h2>
            <p>Add a domain to begin control verification. Registration alone never creates a trusted HIP badge.</p>
        </section>
    }
    else
    {
        @if (_certificateActionError is not null)
        {
            <p class="admin-error" role="alert">@_certificateActionError</p>
        }
        else if (_certificateActionMessage is not null)
        {
            <p class="admin-message" role="status">@_certificateActionMessage</p>
        }
        @foreach (var item in _items)
        {
            <article class="domain-certificate-card @StatusClass(item)" aria-labelledby="@HeadingId(item)">
                <header>
                    <div>
                        <p class="eyebrow">HIP Domain Trust Certificate</p>
                        <h2 id="@HeadingId(item)">@item.Domain</h2>
                    </div>
                    <span class="owner-certificate-status">@CertificateStatus(item)</span>
                </header>

                <section class="owner-certificate-facts" aria-label="Current certificate facts">
                    <article><span>Domain ownership</span><strong>@OwnershipStatus(item)</strong></article>
                    <article><span>Certificate status</span><strong>@CertificateStatus(item)</strong></article>
                    <article><span>Badge level</span><strong>@(item.BadgeLevel?.ToString() ?? "Not issued")</strong></article>
                    <article><span>Current HIP score</span><strong>@(item.CurrentScore?.ToString() ?? "Not available")</strong></article>
                    <article><span>Monitoring status</span><strong>@MonitoringStatus(item)</strong></article>
                    <article><span>Certificate expiration</span><strong>@FormatDate(item.ExpiresAtUtc)</strong></article>
                    <article><span>Last successful verification</span><strong>@FormatDate(item.LastVerificationAtUtc ?? item.WebsiteVerifiedAtUtc ?? item.DnsVerifiedAtUtc)</strong></article>
                    <article><span>Unresolved requirements</span><strong>@item.UnresolvedCriticalFindings critical</strong></article>
                </section>

                <section class="verification-progress" aria-labelledby="@ProgressHeadingId(item)">
                    <h3 id="@ProgressHeadingId(item)">Verification progress</h3>
                    <ol>
                        @ProgressStep("Domain added", true, item, 0)
                        @ProgressStep("DNS verified", item.DnsVerifiedAtUtc is not null, item, 1)
                        @ProgressStep("Website verified", item.WebsiteVerifiedAtUtc is not null, item, 2)
                        @ProgressStep("Identity completed", item.IdentityCompletedAtUtc is not null, item, 3)
                        @ProgressStep("Security review completed", item.SecurityReviewCompletedAtUtc is not null, item, 4)
                        @ProgressStep("Certificate issued", item.CertificateId is not null, item, 5)
                        @ProgressStep("Monitoring active", item.EnrollmentStatus == DomainEnrollmentStatus.Monitored, item, 6)
                    </ol>
                </section>

                <footer class="owner-certificate-actions">
                    @if (item.EnrollmentStatus == DomainEnrollmentStatus.PendingOwnership && item.DnsVerifiedAtUtc is null)
                    {
                        <button class="btn btn-primary" type="button" disabled="@(_checkingEnrollmentId is not null)"
                                @onclick="() => CheckDnsAsync(item)">
                            @(_checkingEnrollmentId == item.EnrollmentId ? "Checking…" : "Check DNS")
                        </button>
                    }
                    @if (item.EnrollmentStatus == DomainEnrollmentStatus.OwnershipVerified &&
                         item.DnsVerifiedAtUtc is not null &&
                         item.WebsiteVerifiedAtUtc is null)
                    {
                        <button class="btn btn-primary" type="button" disabled="@(_preparingWebsiteEnrollmentId is not null)"
                                @onclick="() => PrepareWebsiteVerificationAsync(item)">
                            @(_preparingWebsiteEnrollmentId == item.EnrollmentId ? "Preparing…" : "Prepare website file")
                        </button>
                        @if (_websiteEnrollmentId == item.EnrollmentId && _websiteDocumentJson is not null)
                        {
                            <div class="website-verification-instructions">
                                <p>Download this public challenge file and publish it at <code>https://@item.Domain/.well-known/hip.json</code>.</p>
                                <a class="btn" href="@WebsiteDocumentDownloadUrl()" download="hip.json">Download hip.json</a>
                                <button class="btn btn-primary" type="button" disabled="@(_checkingWebsiteEnrollmentId is not null)"
                                        @onclick="() => CheckWebsiteAsync(item)">
                                    @(_checkingWebsiteEnrollmentId == item.EnrollmentId ? "Checking…" : "Check website")
                                </button>
                            </div>
                        }
                    }
                    @if (item.CertificateId is not null)
                    {
                        <a class="btn btn-primary" href="@($"/certificate/{Uri.EscapeDataString(item.CertificateId)}")">View public certificate</a>
                    }
                    <span>Verification and lifecycle actions appear only when the stored state permits them.</span>
                </footer>
            </article>
        }
    }
</main>

@code {
    private IReadOnlyList<OwnerDomainCertificateSummary> _items = [];
    private bool _loading = true;
    private string? _accessError;

    private string _domain = string.Empty;
    private string _displayName = string.Empty;
    private bool _starting;
    private string? _enrollmentMessage;
    private string? _enrollmentError;
    private DomainCertificateEnrollmentStartResult? _challenge;
    private string? _checkingEnrollmentId;
    private string? _preparingWebsiteEnrollmentId;
    private string? _checkingWebsiteEnrollmentId;
    private string? _websiteEnrollmentId;
    private string? _websiteDocumentJson;
    private string? _certificateActionMessage;
    private string? _certificateActionError;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _loading = true;
        _accessError = null;
        var access = await HipConsumerPageAccess.ExecuteAsync(
            authenticationState.User,
            consumerId => CertificateQuery.ListForOwnerAsync(
                consumerId,
                offset: 0,
                limit: 50,
                CancellationToken.None));
        if (!access.Succeeded)
        {
            _accessError = HipConsumerPageAccess.AccessUnavailableMessage;
        }
        else
        {
            _items = access.Value ?? [];
        }

        _loading = false;
    }

    private async Task StartVerificationAsync()
    {
        _starting = true;
        _enrollmentError = null;
        _enrollmentMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.StartAsync(
                    consumerId,
                    new DomainCertificateEnrollmentStartRequest(
                        _domain,
                        _displayName,
                        VerificationMethod.DnsTxt),
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _enrollmentError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            _challenge = access.Value;
            if (_challenge.Status is DomainCertificateEnrollmentStartStatus.Started or
                DomainCertificateEnrollmentStartStatus.Existing)
            {
                _enrollmentMessage = "Enrollment saved. Add the DNS record below, then return to check verification.";
                await LoadAsync();
            }
            else
            {
                _enrollmentError = _challenge.Status == DomainCertificateEnrollmentStartStatus.InvalidRequest
                    ? "Enter a valid public domain and display name."
                    : "HIP could not start this enrollment. The domain may already be claimed or storage may be unavailable.";
            }
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task CopyDnsRecordAsync()
    {
        if (_challenge?.Domain is null || _challenge.ChallengeToken is null)
        {
            return;
        }

        var record = $"_hip.{_challenge.Domain} TXT \"hip-site-verification={_challenge.ChallengeToken}\"";
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", record);
        _enrollmentMessage = "DNS record copied.";
    }

    private async Task CheckDnsAsync(OwnerDomainCertificateSummary item)
    {
        _checkingEnrollmentId = item.EnrollmentId;
        _enrollmentError = null;
        _enrollmentMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.CheckDnsAsync(
                    consumerId,
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _enrollmentError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateDnsCheckStatus.Verified)
            {
                _enrollmentMessage = "DNS domain control verified. HIP recorded the ownership transition.";
                await LoadAsync();
            }
            else if (access.Value.Status == DomainCertificateDnsCheckStatus.Pending)
            {
                _enrollmentMessage = "HIP did not find the matching DNS record yet. DNS propagation can take time.";
            }
            else
            {
                _enrollmentError = "HIP could not verify this DNS record right now. The stored challenge was not changed.";
            }
        }
        finally
        {
            _checkingEnrollmentId = null;
        }
    }
    private async Task PrepareWebsiteVerificationAsync(OwnerDomainCertificateSummary item)
    {
        _preparingWebsiteEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.PrepareWebsiteVerificationAsync(
                    consumerId,
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateWebsitePrepareStatus.Ready && access.Value.Document is not null)
            {
                _websiteEnrollmentId = item.EnrollmentId;
                _websiteDocumentJson = JsonSerializer.Serialize(
                    access.Value.Document,
                    new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });
                _certificateActionMessage = "Website challenge ready. Publish the downloaded file, then check the website.";
            }
            else
            {
                _certificateActionError = access.Value.Status == DomainCertificateWebsitePrepareStatus.NotReady
                    ? "Complete DNS verification before preparing the website challenge."
                    : "HIP could not prepare the website challenge right now.";
            }
        }
        finally
        {
            _preparingWebsiteEnrollmentId = null;
        }
    }

    private async Task CheckWebsiteAsync(OwnerDomainCertificateSummary item)
    {
        _checkingWebsiteEnrollmentId = item.EnrollmentId;
        _certificateActionError = null;
        _certificateActionMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipConsumerPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                ConsumerPolicies.CanUseConsumerPortal,
                consumerId => EnrollmentService.CheckWebsiteAsync(
                    consumerId,
                    item.Domain,
                    CancellationToken.None));
            if (!access.Succeeded || access.Value is null)
            {
                _certificateActionError = HipConsumerPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status == DomainCertificateWebsiteCheckStatus.Verified)
            {
                _certificateActionMessage = "HTTPS website control verified. HIP moved this enrollment to security review.";
                _websiteEnrollmentId = null;
                _websiteDocumentJson = null;
                await LoadAsync();
            }
            else if (access.Value.Status == DomainCertificateWebsiteCheckStatus.Pending)
            {
                _certificateActionMessage = "HIP did not find the matching challenge file yet. Confirm the fixed HTTPS path and try again.";
            }
            else
            {
                _certificateActionError = "HIP could not verify the website right now. The enrollment was not advanced.";
            }
        }
        finally
        {
            _checkingWebsiteEnrollmentId = null;
        }
    }

    private string WebsiteDocumentDownloadUrl() =>
        $"data:application/hip+json;charset=utf-8,{Uri.EscapeDataString(_websiteDocumentJson ?? string.Empty)}";

    private static RenderFragment ProgressStep(
        string label,
        bool complete,
        OwnerDomainCertificateSummary item,
        int index) => builder =>
    {
        var state = complete ? "complete" : IsFailed(item) ? "failed" : IsCurrent(item, index) ? "current" : "pending";
        builder.OpenElement(0, "li");

        builder.AddAttribute(1, "class", $"progress-step progress-{state}");
        builder.AddAttribute(2, "aria-label", $"{label}: {state}");
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.AddContent(5, complete ? "✓" : index + 1);
        builder.CloseElement();
        builder.AddContent(6, label);
        builder.CloseElement();
    };

    private static bool IsCurrent(OwnerDomainCertificateSummary item, int index)
    {
        var completed = new[]
        {
            true,
            item.DnsVerifiedAtUtc is not null,
            item.WebsiteVerifiedAtUtc is not null,
            item.IdentityCompletedAtUtc is not null,
            item.SecurityReviewCompletedAtUtc is not null,
            item.CertificateId is not null,
            item.EnrollmentStatus == DomainEnrollmentStatus.Monitored
        };
        return !completed[index] && Array.FindIndex(completed, value => !value) == index;
    }

    private static bool IsFailed(OwnerDomainCertificateSummary item) =>
        item.EnrollmentStatus is DomainEnrollmentStatus.Suspended or DomainEnrollmentStatus.Revoked ||
        item.CertificateStatus is DomainCertificateStatus.Suspended or DomainCertificateStatus.Revoked;

    private static string StatusClass(OwnerDomainCertificateSummary item) => IsFailed(item)
        ? "domain-certificate-critical"
        : item.CertificateStatus == DomainCertificateStatus.Active
            ? "domain-certificate-active"
            : item.EnrollmentStatus is DomainEnrollmentStatus.PendingOwnership or DomainEnrollmentStatus.PendingSecurityReview
                ? "domain-certificate-caution"
                : "domain-certificate-inactive";

    private static string OwnershipStatus(OwnerDomainCertificateSummary item) =>
        item.DnsVerifiedAtUtc is not null || item.WebsiteVerifiedAtUtc is not null
            ? "Verified"
            : item.EnrollmentStatus.ToString();

    private static string CertificateStatus(OwnerDomainCertificateSummary item) =>
        item.CertificateStatus?.ToString() ?? "Not issued";

    private static string MonitoringStatus(OwnerDomainCertificateSummary item) =>
        item.EnrollmentStatus == DomainEnrollmentStatus.Monitored
            ? $"Active · {FormatDate(item.LastMonitoringAtUtc)}"
            : item.LastMonitoringAtUtc is null ? "Not active" : $"Last checked {FormatDate(item.LastMonitoringAtUtc)}";

    private static string FormatDate(DateTimeOffset? timestamp) => timestamp?.ToString("u") ?? "Not available";
    private static string HeadingId(OwnerDomainCertificateSummary item) => $"certificate-{SafeId(item.EnrollmentId)}";
    private static string ProgressHeadingId(OwnerDomainCertificateSummary item) => $"progress-{SafeId(item.EnrollmentId)}";
    private static string SafeId(string value) => string.Concat(value.Select(character => char.IsLetterOrDigit(character) ? character : '-'));
}
