@page "/developers"
@page "/dev"
@attribute [AllowAnonymous]
@layout MarketingLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Developers — Open Source Trust Scoring | HIP</PageTitle>
<HeadContent>
  <meta name="description" content="Read every detection rule, query scores from your own product, self-host the scanner, or propose a rule. HIP is open source because trust cannot be proprietary." />
  <link rel="canonical" href="https://guardwithhip.com/developers" />
  <meta property="og:title" content="Developers — Open Source Trust Scoring | HIP" />
  <meta property="og:description" content="Read every detection rule, query scores from your own product, self-host the scanner, or propose a rule. HIP is open source because trust cannot be proprietary." />
</HeadContent>

<main style="max-width:1240px;margin:0 auto;padding:clamp(56px,6vw,80px) clamp(16px,3vw,32px) 110px">
  <div style="max-width:680px;margin-bottom:60px">
    <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:16px">DEVELOPERS</div>
    <h1 style="font-size:clamp(36px,4.6vw,52px);line-height:1.06;letter-spacing:-.03em;font-weight:800;margin:0 0 18px;text-wrap:balance">Open source, because trust cannot be proprietary.</h1>
    <p style="font-size:19px;line-height:1.6;color:var(--muted);margin:0 0 30px;text-wrap:pretty">Run your own instance, read every rule, integrate scores into your product, or propose a detection that catches something we missed.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer" style="padding:12px 20px;background:var(--action);color:var(--action-ink);border-radius:10px;font-size:15px;font-weight:700" data-h="h-bright">View on GitHub</a>
      <a href="https://github.com/daCodez/HIP/blob/master/README.md" target="_blank" rel="noopener noreferrer" style="padding:12px 20px;border:1px solid var(--border);background:var(--surface);border-radius:10px;font-size:15px;font-weight:600;color:var(--text)" data-h="h-bd-nu">Contributing guide</a>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;margin-bottom:24px">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:34px">
      <h2 style="font-size:22px;font-weight:700;margin:0 0 8px;letter-spacing:-.02em">Query a score</h2>
      <p style="font-size:15px;line-height:1.6;color:var(--muted);margin:0 0 20px">Read-only results, with the full finding list. Rate-limited and cacheable.</p>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.85;overflow:auto">
        <div><span style="color:var(--action)">GET</span> /api/v1/public/lookup/domain/example.com</div>
        <div style="height:10px"></div>
        <div style="color:var(--muted)">{</div>
        <div>&nbsp;&nbsp;"domain": "example.com",</div>
        <div>&nbsp;&nbsp;"score": <span style="color:var(--action)">94</span>,</div>
        <div>&nbsp;&nbsp;"status": <span style="color:var(--ok)">"verified"</span>,</div>
        <div>&nbsp;&nbsp;"scanned_at": "2026-07-30T09:12Z",</div>
        <div>&nbsp;&nbsp;"findings": [</div>
        <div>&nbsp;&nbsp;&nbsp;&nbsp;{ "id": "mail.auth_partial",</div>
        <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"severity": <span style="color:var(--warn)">"medium"</span>, "weight": -6 }</div>
        <div>&nbsp;&nbsp;]</div>
        <div style="color:var(--muted)">}</div>
      </div>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:34px">
      <h2 style="font-size:22px;font-weight:700;margin:0 0 8px;letter-spacing:-.02em">Write a detection rule</h2>
      <p style="font-size:15px;line-height:1.6;color:var(--muted);margin:0 0 20px">Rules are declarative and reviewed in the open. Every rule needs a human-readable reason.</p>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.85;overflow:auto">
        <div style="color:var(--muted)"># rules/page/credential_form.yml</div>
        <div><span style="color:var(--violet)">id</span>: form.credentials_insecure</div>
        <div><span style="color:var(--violet)">when</span>:</div>
        <div>&nbsp;&nbsp;- form.has_password_field: <span style="color:var(--ok)">true</span></div>
        <div>&nbsp;&nbsp;- form.action_scheme: <span style="color:var(--danger)">http</span></div>
        <div><span style="color:var(--violet)">severity</span>: <span style="color:var(--danger)">critical</span></div>
        <div><span style="color:var(--violet)">weight</span>: <span style="color:var(--action)">-35</span></div>
        <div><span style="color:var(--violet)">reason</span>: "A password field submits over</div>
        <div>&nbsp;&nbsp;an unencrypted connection."</div>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-bottom:24px">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px">
      <h3 style="font-size:17.5px;font-weight:700;margin:0 0 9px">Self-host</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">Run the scanner and portal on your own infrastructure with your own rule set and provider keys.</p>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px">
      <h3 style="font-size:17.5px;font-weight:700;margin:0 0 9px">Extension source</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">The browser extension is in the same repository — including exactly what it sends and when.</p>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px">
      <h3 style="font-size:17.5px;font-weight:700;margin:0 0 9px">Data minimisation</h3>
      <p style="font-size:14.5px;line-height:1.6;color:var(--muted);margin:0">HIP is designed to check content without storing private conversations or unnecessary personal data.</p>
    </div>
  </div>

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:34px;display:flex;gap:20px;align-items:flex-start">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.9" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.2h.01"></path></svg>
    <div>
      <h3 style="font-size:18px;font-weight:700;margin:0 0 8px">What HIP does not claim</h3>
      <p style="font-size:15.5px;line-height:1.65;color:var(--muted);margin:0;max-width:720px;text-wrap:pretty">HIP does not prevent every threat, and a high score is not a guarantee of safety — it means the checks HIP ran, on the date it ran them, found no significant problems. Scores are evidence to reason with, not a verdict to outsource judgement to.</p>
    </div>
  </div>
</main>

@code {
    private void GoScan() => Nav.NavigateTo("/#scan");
}
