  </section>
</main>



@code {
    // Hero direction: "a" (split) or "b" (centered). Both layouts ship; pick one.
    private string HeroVariant = "a";

    private string Domain = "";
    private bool Scanning;
    private bool ScanDone;

    private string DisplayDomain => string.IsNullOrWhiteSpace(Domain) ? "example.com" : Domain.Trim();
    private int ScorePanel => 82;
    private string StatusPanel => "Mostly Trusted";
    private List<Finding> PanelFindings => SiteData.Findings.Take(4).ToList();

    // Doubled so the marquee can loop seamlessly.
    private record SignalItem(string Label);

    private static readonly List<SignalItem> SignalsLoop =
        SiteData.Signals.Concat(SiteData.Signals).Select(x => new SignalItem(x)).ToList();

    // --- spot the fake ---
    private int RoundIndex;
    private string? Pick;
    private SpotRound Round => SiteData.Rounds[RoundIndex % SiteData.Rounds.Count];
    private bool SpotRevealed => Pick is not null;
    private bool SpotCorrect => SpotRevealed && Pick != Round.FakeId;

    private List<SpotOptionView> SpotOptions => Round.Options.Select(o => new SpotOptionView(o, Round, Pick, id =>
    {
        Pick = id;
        StateHasChanged();
    })).ToList();

    private void SpotNext()
    {
        RoundIndex++;
        Pick = null;
    }

    // --- faq ---
    private int FaqOpen;
    private List<FaqView> Faqs => SiteData.Faqs
        .Select((f, i) => new FaqView(f.Q, f.A, FaqOpen == i, () =>
        {
            FaqOpen = FaqOpen == i ? -1 : i;
            StateHasChanged();
        }))
        .ToList();

    // --- scan demo ---
    private void RunScan()
    {
        var input = (Domain ?? string.Empty).Trim();
        if (input.Length == 0)
        {
            Nav.NavigateTo("/lookup");
            return;
        }

        var candidate = input.Contains("://", StringComparison.Ordinal) ? input : $"https://{input}";
        var domain = Uri.TryCreate(candidate, UriKind.Absolute, out var uri) ? uri.Host : input;
        Nav.NavigateTo($"/lookup/{Uri.EscapeDataString(domain)}");
    }

    private void ScanFinished()
    {
        Scanning = false;
        ScanDone = true;
    }

    private void ResetScan()
    {
        Scanning = false;
        ScanDone = false;
    }

    private void OnDomainKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RunScan();
    }

    private async Task RunXray() => await JS.InvokeVoidAsync("hip.xray");

    private void GoScan() => Nav.NavigateTo("/#scan");
    private void GoVerify() => Nav.NavigateTo("/verification");
    private void GoDev() => Nav.NavigateTo("/developers");
    private void GoPlatform() => Nav.NavigateTo("/platform");
}
