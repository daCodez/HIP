@page "/"
@attribute [AllowAnonymous]
@layout MarketingLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HipPortalLinks PortalLinks

<PageTitle>HIP Website Trust Scanner | Explainable Security &amp; Risk Scores</PageTitle>
<HeadContent>
  <meta name="description" content="Scan a website for HTTPS, certificate, DNS, reputation and page-risk signals. HIP explains every trust score in plain language." />
  <meta property="og:title" content="HIP Website Trust Scanner | Explainable Security &amp; Risk Scores" />
  <meta property="og:description" content="Scan a website for HTTPS, certificate, DNS, reputation and page-risk signals. HIP explains every trust score in plain language." />
  <meta property="og:image" content="https://guardwithhip.com/images/public/marketing/og-image.png" />
  <link rel="canonical" href="https://guardwithhip.com/" />
  <script type="application/ld+json">
    {
      "\u0040context": "https://schema.org",
      "\u0040type": "Organization",
      "\u0040id": "https://guardwithhip.com/#organization",
      "name": "HIP",
      "alternateName": "Human-Interactive Protocol",
      "url": "https://guardwithhip.com/",
      "description": "HIP (Human-Interactive Protocol) is an open-source website trust and risk-scoring platform at guardwithhip.com.",
      "sameAs": ["https://github.com/daCodez/HIP"]
    }
  </script>
</HeadContent>

<nav hidden aria-hidden="true"><a href="@PortalLinks.Consumer("/")">Consumer app</a><a href="@PortalLinks.Admin("/")">Admin portal</a></nav>

<main>

  <!-- HERO A -->
  @if (HeroVariant == "a") {
  <section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border);min-height:92vh;display:flex;align-items:center">
    <div data-px="0.14" style="position:absolute;inset:-14% -2%;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(900px 560px at 24% 34%,#000,transparent);will-change:transform"></div>
    <div data-px="0.34" style="position:absolute;top:-220px;left:-160px;width:760px;height:760px;background:radial-gradient(circle,var(--tint),transparent 66%);pointer-events:none;animation:hipAurora 26s ease-in-out infinite;will-change:transform"></div>
    <div data-px="0.22" style="position:absolute;bottom:-260px;right:-140px;width:640px;height:640px;background:radial-gradient(circle,rgba(31,111,235,.16),transparent 68%);pointer-events:none;animation:hipAurora 34s ease-in-out infinite reverse;will-change:transform"></div>
    <canvas data-globe style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.95"></canvas>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:clamp(64px,8vw,104px) clamp(16px,3vw,32px) clamp(60px,7vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:clamp(40px,5vw,72px);align-items:center">
      <div>
        <div style="display:inline-flex;align-items:center;gap:9px;padding:6px 13px 6px 9px;border:1px solid var(--border);background:var(--surface);border-radius:999px;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:26px">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--action);animation:hipPulse 2.4s ease-in-out infinite"></span>
          Open source · Apache-2.0 · independently developed
        </div>
        <h1 data-words style="font-size:clamp(40px,5.6vw,68px);line-height:1.03;letter-spacing:-.032em;font-weight:800;margin:0 0 22px;text-wrap:balance">Trust is your<br />strongest signal.</h1>
        <p style="font-size:19.5px;line-height:1.6;color:var(--muted);margin:0 0 34px;max-width:530px;text-wrap:pretty">Paste a web address and HIP checks for trust and risk signals, then explains what it found — in words anyone can read.</p>
        <div style="display:flex;flex-direction:column;gap:12px;max-width:520px">
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <div style="flex:1 1 0;min-width:0;display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:0 14px">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18"></path></svg>
              <input @bind="Domain" @bind:event="oninput" @onkeydown="OnDomainKey" placeholder="yourdomain.com" style="flex:1 1 0;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:15.5px;padding:14px 0;font-family:'JetBrains Mono',monospace" />
            </div>
            <button @onclick="RunScan" data-magnet style="padding:0 22px;background:var(--action);color:var(--action-ink);border:0;border-radius:11px;font-size:15px;font-weight:700;cursor:pointer;white-space:nowrap" data-h="h-bright">Check my domain</button>
          </div>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <button @onclick="RunXray" data-magnet style="display:inline-flex;align-items:center;gap:10px;padding:13px 20px;background:var(--surface);border:1px solid var(--action);border-radius:11px;font-size:15px;font-weight:700;color:var(--action);cursor:pointer;font-family:inherit;white-space:nowrap" data-h="h-tint">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18"></path><path d="M6.5 7.5h11M6.5 16.5h11"></path></svg>
              X-ray this page
            </button>
            <span style="font-size:13px;line-height:1.5;color:var(--muted);max-width:250px">Watch HIP scan the page you are on, right now.</span>
          </div>
          <div style="display:flex;align-items:center;gap:16px;font-size:13px;color:var(--muted)">
            <span>No account needed for a first scan.</span>
            <a href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer" style="font-weight:600">View on GitHub →</a>
          </div>
        </div>
      </div>
      <div data-px="-0.09" style="position:relative;will-change:transform;min-height:640px;display:flex;align-items:center">
        <div data-tilt aria-label="Illustrative example result" style="position:relative;width:100%;transform-style:preserve-3d;transition:none"><span style="position:absolute;top:12px;right:12px;z-index:3;padding:5px 9px;border-radius:999px;background:var(--elev);border:1px solid var(--border);font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted)">ILLUSTRATIVE EXAMPLE</span>@if (Scanning)
        {
          <ScanTheatre Domain="@DisplayDomain" OnDone="ScanFinished" />
        }
        else
        {
          <ResultPanel Score="@ScorePanel" Status="@StatusPanel" Findings="@PanelFindings" Domain="@DisplayDomain" OnReset="@(ScanDone ? EventCallback.Factory.Create(this, ResetScan) : default)" />
        }</div>
        <div data-px="-0.22" style="position:absolute;top:-34px;right:6px;z-index:2;display:flex;align-items:center;gap:9px;padding:9px 14px;background:var(--surface);border:1px solid var(--border);border-radius:999px;box-shadow:0 12px 34px rgba(0,0,0,.28);font-size:12.5px;font-weight:600;color:var(--text);animation:hipFloat 7s ease-in-out infinite">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--ok)"></span>Connection is encrypted
        </div>
        <div data-px="-0.3" style="position:absolute;bottom:-30px;left:-34px;z-index:2;display:flex;align-items:center;gap:9px;padding:9px 14px;background:var(--surface);border:1px solid var(--border);border-radius:999px;box-shadow:0 12px 34px rgba(0,0,0,.28);font-size:12.5px;font-weight:600;color:var(--text);animation:hipFloat 9s ease-in-out infinite 1.4s">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--warn)"></span>Weak email protection
        </div>
      </div>
    </div>
  </section>
  }

  <!-- HERO B -->
  @if (HeroVariant == "b") {
  <section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border)">
    <div data-px="0.16" style="position:absolute;inset:-12% 0;background-image:radial-gradient(var(--grid) 1.1px,transparent 1.1px);background-size:26px 26px;mask-image:radial-gradient(760px 500px at 50% 6%,#000,transparent);will-change:transform"></div>
    <div data-px="0.3" style="position:absolute;top:-280px;left:50%;width:900px;height:700px;margin-left:-450px;background:radial-gradient(ellipse at center,var(--tint),transparent 65%);pointer-events:none;animation:hipAurora 30s ease-in-out infinite;will-change:transform"></div>
    <canvas data-globe style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.85"></canvas>
    <div style="position:relative;max-width:900px;margin:0 auto;padding:clamp(72px,8vw,110px) clamp(16px,3vw,32px) 0;text-align:center">
      <div style="display:inline-flex;align-items:center;gap:9px;padding:6px 13px 6px 9px;border:1px solid var(--border);background:var(--surface);border-radius:999px;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--action);animation:hipPulse 2.4s ease-in-out infinite"></span>
        An open trust layer for the web
      </div>
      <h1 data-words style="font-size:clamp(38px,5.2vw,62px);line-height:1.05;letter-spacing:-.032em;font-weight:800;margin:0 0 20px;text-wrap:balance">Every score comes<br />with its reasons.</h1>
      <p style="font-size:19.5px;line-height:1.6;color:var(--muted);margin:0 auto 36px;max-width:600px;text-wrap:pretty">HIP checks a website for the things that make it safe or risky, then explains what it found and what to do about it — in plain words, not security jargon.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;max-width:560px;margin:0 auto 14px">
        <div style="flex:1 1 0;min-width:0;display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:0 14px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18"></path></svg>
          <input @bind="Domain" @bind:event="oninput" @onkeydown="OnDomainKey" placeholder="yourdomain.com" style="flex:1 1 0;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:15.5px;padding:15px 0;font-family:'JetBrains Mono',monospace" />
        </div>
        <button @onclick="RunScan" data-magnet style="padding:0 22px;background:var(--action);color:var(--action-ink);border:0;border-radius:11px;font-size:15px;font-weight:700;cursor:pointer;white-space:nowrap" data-h="h-bright">Check my domain</button>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:16px;margin-bottom:56px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center">
          <button @onclick="RunXray" data-magnet style="display:inline-flex;align-items:center;gap:10px;padding:13px 20px;background:var(--surface);border:1px solid var(--action);border-radius:11px;font-size:15px;font-weight:700;color:var(--action);cursor:pointer;font-family:inherit;white-space:nowrap" data-h="h-tint">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18"></path><path d="M6.5 7.5h11M6.5 16.5h11"></path></svg>
              X-ray this page
            </button>
          <span style="font-size:13px;color:var(--muted)">Watch HIP scan the page you are on, right now.</span>
        </div>
        <span style="font-size:13px;color:var(--muted)">Free, no account. Or <a href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer" style="font-weight:600">view the source on GitHub</a>.</span>
      </div>
    </div>
    <div data-px="-0.07" style="position:relative;max-width:1040px;margin:0 auto;padding:0 clamp(16px,3vw,32px);transform:translateY(1px);will-change:transform"><div data-tilt aria-label="Illustrative example result" style="transform-style:preserve-3d;transition:none"><span style="position:absolute;top:12px;right:12px;z-index:3;padding:5px 9px;border-radius:999px;background:var(--elev);border:1px solid var(--border);font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted)">ILLUSTRATIVE EXAMPLE</span>@if (Scanning)
        {
          <ScanTheatre Domain="@DisplayDomain" OnDone="ScanFinished" />
        }
        else
        {
          <ResultPanel Score="@ScorePanel" Status="@StatusPanel" Findings="@PanelFindings" Domain="@DisplayDomain" OnReset="@(ScanDone ? EventCallback.Factory.Create(this, ResetScan) : default)" />
        }</div></div>
  </section>
  }

  <!-- SIGNAL STRIP -->
  <section style="border-bottom:1px solid var(--border);background:var(--surface)">
    <div style="display:flex;align-items:center;gap:22px;padding:22px 0 22px 32px;overflow:hidden">
      <span style="font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--muted);flex-shrink:0">SIGNALS CHECKED</span>
      <div style="position:relative;flex:1;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 4%,#000 88%,transparent)">
        <div data-signal-marquee style="display:flex;width:max-content;animation:hipMarquee 34s linear infinite">
          <div style="display:flex;gap:10px;padding-right:10px">
            @foreach (var s in SignalsLoop) {
              <span style="padding:7px 14px;border:1px solid var(--border);border-radius:999px;font-size:13px;color:var(--text);background:var(--bg);white-space:nowrap">@(s.Label)</span>
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPOT THE FAKE -->
  <section data-rise style="position:relative;overflow:hidden;border-bottom:1px solid var(--border)">
    <div data-px="0.14" style="position:absolute;inset:-14% -3%;background:radial-gradient(680px 420px at 18% 20%,var(--tint),transparent 70%),radial-gradient(620px 420px at 84% 80%,rgba(239,68,68,.10),transparent 70%);pointer-events:none;will-change:transform"></div>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:clamp(64px,7vw,100px) clamp(16px,3vw,32px)">
      <div style="max-width:660px;margin-bottom:44px">
        <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:14px">TRY IT YOURSELF</div>
        <h2 data-words style="font-size:clamp(30px,3.4vw,40px);line-height:1.12;letter-spacing:-.025em;font-weight:800;margin:0 0 16px;text-wrap:balance">One of these two pages is fake. Which one?</h2>
        <p style="font-size:17px;line-height:1.65;color:var(--muted);margin:0;text-wrap:pretty">Both are fictional, and both were built to look convincing. Pick the one you would trust with your password — then see what HIP saw.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:24px;margin-bottom:28px">
        @foreach (var o in SpotOptions) {
          <div style="display:flex;flex-direction:column;gap:14px">
            <div style="border:1px solid var(--border);border-radius:16px;overflow:hidden;background:var(--surface);box-shadow:0 18px 50px rgba(0,0,0,.26)">
              <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border);background:var(--elev)">
                <span style="display:grid;place-items:center;width:20px;height:20px;border-radius:6px;background:var(--bg);border:1px solid var(--border);font-size:10.5px;font-weight:800;color:var(--muted);flex-shrink:0">@(o.Letter)</span>
                <div style="flex:1;min-width:0;display:flex;align-items:center;gap:8px;padding:6px 11px;background:var(--bg);border:1px solid var(--border);border-radius:999px">
                  @if (o.Secure) {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" style="flex-shrink:0"><rect x="4" y="10.5" width="16" height="10" rx="2.5"></rect><path d="M8 10.5V7.5a4 4 0 018 0v3"></path></svg>
                  }
                  @if (o.Insecure) {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" style="flex-shrink:0"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 8v4.5M12 16h.01"></path></svg>
                  }
                  <span style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(o.Url)</span>
                </div>
              </div>
              <div style="padding:30px 26px 32px;display:flex;flex-direction:column;gap:14px">
                <div style="display:flex;align-items:center;gap:10px">
                  <span style="width:26px;height:26px;border-radius:7px;background:var(--tint);display:grid;place-items:center;flex-shrink:0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--action)" stroke-width="2.2" stroke-linecap="round"><path d="M4 20V9l8-5 8 5v11"></path></svg></span>
                  <span style="font-size:15.5px;font-weight:800;letter-spacing:-.01em;color:var(--text)">@(o.Brand)</span>
                </div>
                <div style="font-size:13.5px;color:var(--muted)">@(o.Tagline)</div>
                @if (o.HasUrgency) {
                  <div style="font-size:12.5px;line-height:1.5;color:var(--text);background:var(--bg);border:1px solid var(--border);border-radius:9px;padding:10px 12px">@(o.Urgency)</div>
                }
                <div style="height:38px;border:1px solid var(--border);border-radius:9px;background:var(--bg);display:flex;align-items:center;padding:0 12px;font-size:13px;color:var(--muted)">Email address</div>
                <div style="height:38px;border:1px solid var(--border);border-radius:9px;background:var(--bg);display:flex;align-items:center;padding:0 12px;font-size:13px;color:var(--muted)">Password</div>
                <div style="height:38px;border-radius:9px;background:var(--action);display:grid;place-items:center;font-size:13.5px;font-weight:700;color:var(--action-ink)">Sign in</div>
              </div>
            </div>

            @if (o.Pending) {
              <button @onclick="o.Pick" style="padding:13px 18px;border:1px solid var(--border);background:var(--surface);border-radius:11px;font-size:14.5px;font-weight:700;color:var(--text);cursor:pointer;font-family:inherit" data-h="h-bd-fg">I would trust @(o.Letter)</button>
            }

            @if (o.Revealed) {
              <div style="border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:20px">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px">
                  <div style="display:flex;align-items:baseline;gap:9px">
                    <span style="font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:800;letter-spacing:-.03em;color:@(o.VerdictFg)">@(o.Score)</span>
                    <span style="font-size:13px;color:var(--muted)">/ 100</span>
                  </div>
                  <span style="padding:5px 12px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap;background:@(o.VerdictBg);color:@(o.VerdictFg)">@(o.Verdict)</span>
                </div>
                <div style="height:5px;border-radius:3px;background:var(--elev);overflow:hidden;margin-bottom:16px">
                  <div style="height:100%;width:@(o.BarWidth);background:@(o.VerdictFg)"></div>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px">
                  @foreach (var sg in o.Signals) {
                    <div style="display:flex;align-items:flex-start;gap:10px">
                      <span style="width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:6px;background:@(sg.Dot)"></span>
                      <span style="flex:1;min-width:0">
                        <span style="display:block;font-size:13.5px;font-weight:600;color:var(--text);line-height:1.35">@(sg.Label)</span>
                        <span style="display:block;font-size:12.5px;color:var(--muted);line-height:1.45;margin-top:2px">@(sg.Plain)</span>
                      </span>
                    </div>
                  }
                </div>
                <div style="font-size:12px;font-weight:600;color:var(--action);margin-top:14px;min-height:16px">@(o.ChosenLabel)</div>
              </div>
            }
          </div>
        }
      </div>

      @if (!SpotRevealed) {
        <p style="font-size:14px;color:var(--muted);margin:0;max-width:560px">Look as long as you like. The difference is not in the design.</p>
      }

      @if (SpotRevealed) {
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:22px 26px;border:1px solid var(--border);border-radius:16px;background:var(--surface)">
          @if (SpotRevealed && SpotCorrect) {
            <span style="font-size:16px;font-weight:700;color:var(--ok)">You picked the safe one.</span>
          }
          @if (SpotRevealed && !SpotCorrect) {
            <span style="font-size:16px;font-weight:700;color:var(--warn)">That was the fake one.</span>
          }
          <span style="flex:1;min-width:240px;font-size:15px;line-height:1.6;color:var(--muted)">Design is the one thing an attacker can copy perfectly. Certificates, domain age and where a form sends your password are not — and those are what HIP reads.</span>
          <button @onclick="SpotNext" style="padding:11px 18px;border:0;border-radius:10px;background:var(--action);color:var(--action-ink);font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;flex-shrink:0" data-h="h-bright">Try another pair</button>
        </div>
      }
    </div>
  </section>

  <LookalikeDetector />

  <!-- WHO IT IS FOR -->
  <section data-rise style="max-width:1240px;margin:0 auto;padding:clamp(64px,7vw,92px) clamp(16px,3vw,32px) 20px">
    <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:14px">WHO IT IS FOR</div>
    <h2 data-words style="font-size:clamp(30px,3.4vw,40px);line-height:1.12;letter-spacing:-.025em;font-weight:800;margin:0 0 16px;max-width:640px;text-wrap:balance">Four ways people use HIP.</h2>
    <p style="font-size:17px;line-height:1.6;color:var(--muted);margin:0 0 44px;max-width:600px;text-wrap:pretty">One shared trust layer, seen from four sides.</p>
    <div data-cards style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;overflow:hidden;display:flex;flex-direction:column">
        <div class="img-slot" style="width:100%;height:180px" data-slot="hip-who-visitor"><span>Photo: everyday visitor</span></div>
        <div style="padding:26px;display:flex;flex-direction:column;flex:1">
