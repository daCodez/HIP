@page "/admin/certificates"
@attribute [Authorize(Policy = AdminPolicies.CanViewReviews)]
@rendermode InteractiveServer
@implements IDisposable
@using HIP.Application.Certificates
@using HIP.Domain.Certificates
@inject IDomainCertificateAdminQuery CertificateQuery
@inject IDomainCertificateLifecycleService LifecycleService
@inject IDomainCertificateApplicationService ApplicationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IHostEnvironment HostEnvironment
@inject HipPortalLinks PortalLinks

<PageTitle>HIP Certificate Operations</PageTitle>

<main class="admin-rule-page admin-certificate-page">
    <section class="admin-rule-header">
        <div>
            <p class="eyebrow">HIP Admin · certificate operations</p>
            <h1>Domain Trust Certificates</h1>
            <p>Review persisted enrollment and signed certificate state. Domain control and signatures are evidence, not automatic safety claims.</p>
        </div>
    </section>

    @if (_error is not null)
    {
        <p class="admin-error" role="alert">@_error</p>
    }
    @if (_statusMessage is not null)
    {
        <p class="admin-message" role="status">@_statusMessage</p>
    }
    @if (_error is null && _loading)
    {
        <p class="admin-message" role="status">Loading certificate operations…</p>
    }
    else if (_error is null)
    {
        <section class="dashboard-grid" aria-label="Certificate operation counts">
            <article class="score-card"><span>Pending certificate reviews</span><strong>@PendingReviews.Count</strong><p>Policy or evidence requires an authorized decision.</p></article>
            <article class="score-card"><span>Recently issued certificates</span><strong>@RecentlyIssued.Count</strong><p>Current signed certificates in this page.</p></article>
            <article class="score-card"><span>Recently revoked certificates</span><strong>@RecentlyRevoked.Count</strong><p>Current certificates whose live lifecycle is revoked.</p></article>
            <article class="score-card"><span>Failed verification attempts</span><strong>Open</strong><p><a href="/identity/websites">Open domain verification operations</a></p></article>
        </section>

        <section class="lookup-result certificate-review-explainer" aria-labelledby="security-review-explainer-title">
            <div>
                <p class="eyebrow">After application approval</p>
                <h2 id="security-review-explainer-title">What the security review does</h2>
                <p>Approval records the reviewer decision; it does not issue a certificate. The authenticated domain owner starts the next step from their Certificates page.</p>
            </div>
            <ol>
                <li><strong>Scan</strong><span>HIP scans the fixed HTTPS origin and collects configured provider and TLS evidence.</span></li>
                <li><strong>Evaluate</strong><span>HIP applies the versioned certificate policy and stores the score, findings count, and evidence digest.</span></li>
                <li><strong>Issue</strong><span>If every required check passes, HIP signs and stores the certificate automatically. Otherwise, the case remains pending without a trust assertion.</span></li>
            </ol>
        </section>

        <section class="lookup-result">
            <header class="certificate-queue-heading">
                <div>
                    <h2>Current certificate operations</h2>
                    <p>Identity conflicts, suspicious registrations, renewal reviews, badge misuse, and suspension or revocation requests remain visible through their persisted lifecycle and review records.</p>
                </div>
            </header>
            @if (_items.Count == 0)
            {
                <p class="admin-message">No domain certificate enrollments are stored yet.</p>
            }
            else
            {
                <div class="table-scroll certificate-table-scroll" tabindex="0" aria-label="Domain certificate operations table">
                    <table class="certificate-operations-table">
                        <thead>
                            <tr>
                                <th scope="col">Domain</th>
                                <th scope="col">Enrollment</th>
                                <th scope="col">Application</th>
                                <th scope="col">Certificate</th>
                                <th scope="col">HIP score</th>
                                <th scope="col">Findings</th>
                                <th scope="col">Policy</th>
                                <th scope="col">Updated</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td class="certificate-domain"><strong>@item.Domain</strong></td>
                                    <td><span class="certificate-state">@EnrollmentLabel(item.EnrollmentStatus)</span></td>
                                    <td><span class="certificate-state">@ApplicationLabel(item.ApplicationStatus)</span></td>
                                    <td>
                                        <span class="certificate-state">@CertificateLabel(item)</span>
                                        @if (item.BadgeLevel is not null)
                                        {
                                            <small>@item.BadgeLevel badge</small>
                                        }
                                    </td>
                                    <td>@(item.CurrentScore is null ? "-" : $"{item.CurrentScore}/100")</td>
                                    <td>@item.UnresolvedCriticalFindings critical</td>
                                    <td><code>@item.PolicyVersion</code></td>
                                    <td><time datetime="@item.UpdatedAtUtc.ToString("O")">@item.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></td>
                                    <td>
                                        <div class="certificate-row-actions">
                                            <a href="@($"/identity/websites?domain={Uri.EscapeDataString(item.Domain)}")">Verification</a>
                                            @if (item.ApplicationStatus == DomainCertificateApplicationStatus.Submitted)
                                            {
                                                <button type="button" class="hip-secondary-action" @onclick="() => BeginApplicationDecision(item, DomainCertificateApplicationStatus.Approved)" disabled="@_submitting">Approve</button>
                                                <button type="button" class="hip-secondary-action" @onclick="() => BeginApplicationDecision(item, DomainCertificateApplicationStatus.ChangesRequested)" disabled="@_submitting">Request changes</button>
                                                <button type="button" class="danger-button" @onclick="() => BeginApplicationDecision(item, DomainCertificateApplicationStatus.Denied)" disabled="@_submitting">Deny</button>
                                            }
                                            else if (item.ApplicationStatus == DomainCertificateApplicationStatus.Approved &&
                                                     item.CertificateId is null)
                                            {
                                                <span class="certificate-next-step">Owner can run security review and issuance</span>
                                            }
                                            @if (item.CertificateId is not null)
                                            {
                                                <a href="@PortalLinks.Public($"/certificate/{Uri.EscapeDataString(item.CertificateId)}")" data-enhance-nav="false">Public certificate</a>
                                                @if (item.CertificateStatus == DomainCertificateStatus.Active)
                                                {
                                                    <button type="button" class="hip-secondary-action" @onclick="() => BeginAction(item, DomainCertificateStatus.Suspended)" disabled="@_submitting">Suspend</button>
                                                }
                                                @if (item.CertificateStatus == DomainCertificateStatus.Suspended)
                                                {
                                                    <button type="button" class="hip-secondary-action" @onclick="() => BeginAction(item, DomainCertificateStatus.Active)" disabled="@_submitting">Reinstate</button>
                                                }
                                                @if (item.CertificateStatus is DomainCertificateStatus.Active or DomainCertificateStatus.Suspended)
                                                {
                                                    <button type="button" class="danger-button" @onclick="() => BeginAction(item, DomainCertificateStatus.Revoked)" disabled="@_submitting">Revoke</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (_selectedItem is not null && _targetStatus is not null)
        {
            <section class="lookup-result certificate-action-confirmation" aria-labelledby="certificate-action-title">
                <h2 id="certificate-action-title">Confirm certificate action</h2>
                <p>
                    <strong>@ActionLabel(_targetStatus.Value)</strong>
                    the live certificate for <strong>@_selectedItem.Domain</strong>.
                    The signed issuance record remains unchanged and this action is permanently audited.
                </p>
                @if (_targetStatus == DomainCertificateStatus.Revoked)
                {
                    <p role="alert"><strong>Revocation is permanent.</strong> This certificate cannot be reinstated.</p>
                }
                <div class="form-group">
                    <label for="certificate-action-reason">Reason</label>
                    <textarea id="certificate-action-reason"
                              @bind="_reason"
                              maxlength="500"
                              rows="4"
                              required
                              aria-describedby="certificate-action-reason-help"></textarea>
                    <p id="certificate-action-reason-help">Enter 5–500 privacy-safe characters. Do not include secrets or private evidence.</p>
                </div>
                <div class="service-client-actions">
                    <button type="button"
                            class="@(_targetStatus == DomainCertificateStatus.Revoked ? "danger-button" : "hip-primary-action")"
                            @onclick="ConfirmActionAsync"
                            disabled="@(_submitting || !ReasonIsValid)">
                        @(_submitting ? "Saving…" : $"Confirm {ActionLabel(_targetStatus.Value).ToLowerInvariant()}")
                    </button>
                    <button type="button" class="hip-secondary-action" @onclick="CancelAction" disabled="@_submitting">Cancel</button>
                </div>
            </section>
        }

        @if (_selectedItem is not null && _targetApplicationStatus is not null)
        {
            <section class="lookup-result certificate-action-confirmation" aria-labelledby="application-decision-title">
                <h2 id="application-decision-title">Confirm application decision</h2>
                <p><strong>@ApplicationDecisionLabel(_targetApplicationStatus.Value)</strong> the authenticated certificate application for <strong>@_selectedItem.Domain</strong>.</p>
                <p>The decision, reviewer identity, reason, attestation digest, and timestamp are permanently audited.</p>
                <div class="form-group">
                    <label for="application-decision-reason">Decision reason</label>
                    <textarea id="application-decision-reason" @bind="_reason" maxlength="500" rows="4" required></textarea>
                    <p>Enter 5–500 privacy-safe characters. Do not include private evidence or secrets.</p>
                </div>
                <div class="service-client-actions">
                    <button type="button"
                            class="@(_targetApplicationStatus == DomainCertificateApplicationStatus.Denied ? "danger-button" : "hip-primary-action")"
                            @onclick="ConfirmApplicationDecisionAsync"
                            disabled="@(_submitting || !ReasonIsValid)">
                        @(_submitting ? "Saving…" : $"Confirm {ApplicationDecisionLabel(_targetApplicationStatus.Value).ToLowerInvariant()}")
                    </button>
                    <button type="button" class="hip-secondary-action" @onclick="CancelApplicationDecision" disabled="@_submitting">Cancel</button>
                </div>
            </section>
        }
    }
</main>

@code {
    private IReadOnlyList<AdminDomainCertificateSummary> _items = [];
    private readonly CancellationTokenSource _pageCancellation = new();
    private bool _loading = true;
    private bool _submitting;
    private string? _error;
    private string? _statusMessage;
    private AdminDomainCertificateSummary? _selectedItem;
    private DomainCertificateStatus? _targetStatus;
    private DomainCertificateApplicationStatus? _targetApplicationStatus;
    private string _reason = string.Empty;
    private string? _operationId;

    private IReadOnlyList<AdminDomainCertificateSummary> PendingReviews => _items
        .Where(item => item.EnrollmentStatus == DomainEnrollmentStatus.PendingSecurityReview ||
                       item.CertificateStatus == DomainCertificateStatus.PendingReview)
        .ToArray();
    private IReadOnlyList<AdminDomainCertificateSummary> RecentlyIssued => _items
        .Where(item => item.IssuedAtUtc is not null)
        .OrderByDescending(item => item.IssuedAtUtc)
        .Take(10)
        .ToArray();
    private IReadOnlyList<AdminDomainCertificateSummary> RecentlyRevoked => _items
        .Where(item => item.CertificateStatus == DomainCertificateStatus.Revoked)
        .OrderByDescending(item => item.UpdatedAtUtc)
        .Take(10)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await CertificateQuery.ListForAdminAsync(0, 100, _pageCancellation.Token);
            _error = null;
        }
        catch (OperationCanceledException) when (_pageCancellation.IsCancellationRequested)
        {
        }
        catch
        {
            _error = "HIP could not load certificate operations right now.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginAction(AdminDomainCertificateSummary item, DomainCertificateStatus targetStatus)
    {
        _selectedItem = item;
        _targetStatus = targetStatus;
        _targetApplicationStatus = null;
        _reason = string.Empty;
        _operationId = Guid.NewGuid().ToString("N");
        _error = null;
        _statusMessage = null;
    }

    private void BeginApplicationDecision(
        AdminDomainCertificateSummary item,
        DomainCertificateApplicationStatus targetStatus)
    {
        _selectedItem = item;
        _targetStatus = null;
        _targetApplicationStatus = targetStatus;
        _reason = string.Empty;
        _error = null;
        _statusMessage = null;
    }

    private void CancelApplicationDecision()
    {
        _selectedItem = null;
        _targetApplicationStatus = null;
        _reason = string.Empty;
    }

    private void CancelAction()
    {
        _selectedItem = null;
        _targetStatus = null;
        _reason = string.Empty;
        _operationId = null;
    }

    private async Task ConfirmActionAsync()
    {
        if (_selectedItem?.CertificateId is not { } certificateId ||
            _targetStatus is not { } targetStatus ||
            _operationId is not { } operationId ||
            !ReasonIsValid)
        {
            _error = "Enter a privacy-safe reason of at least 5 characters.";
            return;
        }

        _submitting = true;
        _error = null;
        _statusMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            IReadOnlyCollection<string> policies = targetStatus == DomainCertificateStatus.Revoked
                ? [AdminPolicies.CanRevokeDomainVerifications, AdminPolicies.RecentPrivilegedAuthentication]
                : [AdminPolicies.CanManageDomainVerifications];
            var access = await HipAdminPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                HostEnvironment,
                policies,
                (actorId, cancellationToken) => LifecycleService.ChangeStatusAsync(
                    new DomainCertificateLifecycleRequest(
                        certificateId,
                        targetStatus,
                        _reason,
                        operationId,
                        actorId),
                    cancellationToken),
                _pageCancellation.Token);
            if (!access.Succeeded)
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            var result = access.Value;
            if (result is null)
            {
                _error = "HIP could not change the certificate status right now.";
                return;
            }
            if (result.Status is DomainCertificateLifecycleChangeStatus.Changed or
                DomainCertificateLifecycleChangeStatus.Existing)
            {
                var domain = _selectedItem.Domain;
                CancelAction();
                _statusMessage = $"{domain} is now {targetStatus.ToString().ToLowerInvariant()}.";
                await LoadAsync();
                return;
            }

            _error = result.Status switch
            {
                DomainCertificateLifecycleChangeStatus.InvalidRequest => "The certificate action or reason is invalid.",
                DomainCertificateLifecycleChangeStatus.NotFound => "The current signed certificate no longer exists.",
                DomainCertificateLifecycleChangeStatus.Conflict => "The certificate changed before this action completed. Refresh and review its current status.",
                _ => "HIP could not change the certificate status right now."
            };
        }
        catch (OperationCanceledException) when (_pageCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ConfirmApplicationDecisionAsync()
    {
        if (_selectedItem is null || _targetApplicationStatus is not { } targetStatus || !ReasonIsValid)
        {
            _error = "Enter a privacy-safe decision reason of at least 5 characters.";
            return;
        }

        _submitting = true;
        _error = null;
        _statusMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var access = await HipAdminPageAccess.ExecuteAuthorizedAsync(
                authenticationState.User,
                AuthorizationService,
                HostEnvironment,
                [AdminPolicies.CanManageDomainVerifications],
                (actorId, cancellationToken) => ApplicationService.DecideAsync(
                    _selectedItem.EnrollmentId,
                    targetStatus,
                    _reason,
                    actorId,
                    cancellationToken),
                _pageCancellation.Token);
            if (!access.Succeeded || access.Value is null)
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            if (access.Value.Status is DomainCertificateApplicationDecisionStatus.Approved or
                DomainCertificateApplicationDecisionStatus.ChangesRequested or
                DomainCertificateApplicationDecisionStatus.Denied or
                DomainCertificateApplicationDecisionStatus.Existing)
            {
                var domain = _selectedItem.Domain;
                CancelApplicationDecision();
                _statusMessage = targetStatus == DomainCertificateApplicationStatus.Approved
                    ? $"{domain} application approved. The owner can now run the security review and, if eligible, HIP will issue the certificate automatically."
                    : $"{domain} application decision saved.";
                await LoadAsync();
                return;
            }

            _error = "HIP could not save the application decision right now.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private bool ReasonIsValid
    {
        get
        {
            var trimmed = _reason.Trim();
            return trimmed.Length is >= 5 and <= 500 && !trimmed.Any(char.IsControl);
        }
    }

    private static string EnrollmentLabel(DomainEnrollmentStatus status) => status switch
    {
        DomainEnrollmentStatus.PendingOwnership => "Ownership pending",
        DomainEnrollmentStatus.OwnershipVerified => "Ownership verified",
        DomainEnrollmentStatus.PendingSecurityReview => "Security review pending",
        DomainEnrollmentStatus.Verified => "Verified",
        DomainEnrollmentStatus.Monitored => "Monitoring active",
        DomainEnrollmentStatus.Suspended => "Suspended",
        DomainEnrollmentStatus.Revoked => "Revoked",
        _ => "Draft"
    };

    private static string ApplicationLabel(DomainCertificateApplicationStatus status) => status switch
    {
        DomainCertificateApplicationStatus.Submitted => "Awaiting review",
        DomainCertificateApplicationStatus.ChangesRequested => "Changes requested",
        DomainCertificateApplicationStatus.Approved => "Approved",
        DomainCertificateApplicationStatus.Denied => "Denied",
        _ => "Draft"
    };

    private static string CertificateLabel(AdminDomainCertificateSummary item) =>
        item.CertificateStatus?.ToString() ?? "Not issued";
    private static string ApplicationDecisionLabel(DomainCertificateApplicationStatus targetStatus) => targetStatus switch
    {
        DomainCertificateApplicationStatus.Approved => "Approve",
        DomainCertificateApplicationStatus.ChangesRequested => "Request changes for",
        DomainCertificateApplicationStatus.Denied => "Deny",
        _ => "Decide"
    };

    private static string ActionLabel(DomainCertificateStatus targetStatus) => targetStatus switch
    {
        DomainCertificateStatus.Suspended => "Suspend",
        DomainCertificateStatus.Active => "Reinstate",
        DomainCertificateStatus.Revoked => "Revoke",
        _ => "Change"
    };

    public void Dispose()
    {
        _pageCancellation.Cancel();
        _pageCancellation.Dispose();
    }
}
