@page "/admin/roles"
@attribute [Authorize(Policy = AdminPolicies.CanViewAdminUsers)]
@rendermode InteractiveServer
@inject IAdminAccessService AccessService
@inject IAdminAccessRequestService RequestService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IHostEnvironment HostEnvironment
@inject HipPortalLinks PortalLinks

<PageTitle>HIP Users and Roles</PageTitle>

<main class="admin-rule-page">
    <section class="admin-rule-header">
        <p class="eyebrow">Access control</p>
        <h1>Users and roles</h1>
        <p>Manage who can administer HIP and what each person can do. Your identity provider still controls sign-in and passwords.</p>
    </section>

    @if (_loading)
    {
        <p role="status">Loading administrator access…</p>
    }
    else if (_directory is null)
    {
        <section class="service-client-message error" role="alert">
            <strong>Administrator access unavailable</strong>
            <p>@_error</p>
            <button type="button" class="hip-secondary-action" @onclick="LoadAsync">Retry</button>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="service-client-message" role="status">@_message</p>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="service-client-message error" role="alert">@_error</p>
        }

        <section class="rule-builder-panel" aria-labelledby="pending-access-heading">
            <h2 id="pending-access-heading">Pending access requests</h2>
            <p>HIP captures each requester's privacy-safe actor ID from their authenticated session. Review the stated need, choose the least-privileged role, and confirm or leave the request pending.</p>
            @if (_requests.Count == 0)
            {
                <p>No administrator access requests are waiting for review.</p>
            }
            else
            {
                <div class="table-scroll" tabindex="0" aria-label="Pending administrator access requests">
                    <table class="admin-rule-table">
                        <thead><tr><th scope="col">Requester</th><th scope="col">Reason</th><th scope="col">Submitted UTC</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                            @foreach (var request in _requests)
                            {
                                <tr>
                                    <td><strong>@request.DisplayLabel</strong></td>
                                    <td>@request.Reason</td>
                                    <td>@request.CreatedAtUtc.ToString("u")</td>
                                    <td><button type="button" class="hip-secondary-action" @onclick="() => BeginRequestReview(request)" disabled="@_busy">Review</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="rule-builder-panel" aria-labelledby="admin-users-heading">
            <div class="service-client-heading">
                <div>
                    <h2 id="admin-users-heading">Administrator access</h2>
                    <p>Disabled assignments remain in the encrypted directory and audit trail. HIP stores only a privacy-safe actor ID and operator label.</p>
                    <p>New administrators request access from <a href="@PortalLinks.Public("/access")" data-enhance-nav="false">their access status page</a>; actor IDs are transferred automatically.</p>
                </div>

            </div>
            <div class="table-scroll" tabindex="0" aria-label="HIP administrator assignments">
                <table class="admin-rule-table">
                    <thead>
                        <tr><th scope="col">Operator</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Updated UTC</th><th scope="col">Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in _directory.Assignments)
                        {
                            <tr>
                                <td><strong>@assignment.DisplayLabel</strong><br /><code>@assignment.ActorId</code></td>
                                <td>@assignment.Role</td>
                                <td>@assignment.Status</td>
                                <td>@assignment.UpdatedAtUtc.ToString("u")</td>
                                <td><button type="button" class="hip-secondary-action" @onclick="() => BeginEdit(assignment)" disabled="@_busy">Manage</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (_editing)
        {
            <section class="rule-builder-panel" aria-labelledby="access-change-heading">
                <h2 id="access-change-heading">@(_selectedRequest is not null ? "Approve access request" : "Change administrator access")</h2>
                <p>@(_existing is null ? "This actor ID was captured from the requester's authenticated HIP session." : "Change the existing assignment while preserving its authenticated actor binding.")</p>
                <div class="rule-form-grid">
                    <label for="admin-actor-id">HIP actor ID</label>
                    <input id="admin-actor-id" @bind="_targetActorId" maxlength="160" required disabled autocomplete="off" aria-describedby="admin-actor-help" />
                    <small id="admin-actor-help">HIP binds this identifier automatically; it cannot be edited here.</small>

                    <label for="admin-label">Operator label</label>
                    <input id="admin-label" @bind="_displayLabel" maxlength="80" required disabled="@_busy" autocomplete="off" />
                    <small>Use a team-facing label, not an email address.</small>

                    <label for="admin-role">Role</label>
                    <select id="admin-role" @bind="_role" disabled="@_busy">
                        @foreach (var role in AdminRoleCatalog.Roles)
                        {
                            <option value="@role.Role">@role.Role — @role.Description</option>
                        }
                    </select>

                    <label for="admin-status">Access status</label>
                    <select id="admin-status" @bind="_status" disabled="@_busy">
                        <option value="@AdminAccessStatus.Active">Active</option>
                        <option value="@AdminAccessStatus.Disabled">Disabled</option>
                    </select>

                    <label for="admin-change-reason">Reason</label>
                    <textarea id="admin-change-reason" @bind="_reason" maxlength="500" rows="4" required disabled="@_busy" aria-describedby="admin-reason-help"></textarea>
                    <small id="admin-reason-help">Required, 5–500 privacy-safe characters. The reason supports the audit decision but must not contain secrets or personal data.</small>
                </div>
                <div class="service-client-actions">
                    <button type="button" class="hip-primary-action" @onclick="ReviewChange" disabled="@(_busy || !FormValid)">Review approval</button>
                    @if (_selectedRequest is not null)
                    {
                        <button type="button" class="hip-secondary-action" @onclick="ReviewDenial" disabled="@(_busy || !FormValid)">Review denial</button>
                    }
                    <button type="button" class="hip-secondary-action" @onclick="CancelEdit" disabled="@_busy">Cancel</button>
                </div>
            </section>
        }

        @if (_confirming)
        {
            <section class="lookup-result certificate-action-confirmation" aria-labelledby="confirm-access-heading">
                <h2 id="confirm-access-heading">Confirm administrator access</h2>
                <p>Set <strong>@_displayLabel</strong> to <strong>@_role</strong> with <strong>@_status</strong> access.</p>
                <p>This change affects HIP authorization, is version-checked, and is permanently audited. HIP will reject removal of the last active Owner.</p>
                <div class="service-client-actions">
                    <button type="button" class="hip-primary-action" @onclick="SaveAsync" disabled="@_busy">@(_busy ? "Saving…" : "Confirm change")</button>
                    <button type="button" class="hip-secondary-action" @onclick="CancelConfirmation" disabled="@_busy">Back</button>
                </div>
            </section>
        }

        @if (_denying && _selectedRequest is not null)
        {
            <section class="lookup-result certificate-action-confirmation" aria-labelledby="deny-access-heading">
                <h2 id="deny-access-heading">Confirm access denial</h2>
                <p>Deny the request from <strong>@_selectedRequest.DisplayLabel</strong>.</p>
                <p>The decision and privacy-safe reason are permanently audited. No administrator access will be granted.</p>
                <div class="service-client-actions">
                    <button type="button" class="hip-primary-action" @onclick="DenyAsync" disabled="@_busy">@(_busy ? "Saving…" : "Confirm denial")</button>
                    <button type="button" class="hip-secondary-action" @onclick="CancelConfirmation" disabled="@_busy">Back</button>
                </div>
            </section>
        }
        <section class="rule-builder-panel" aria-labelledby="role-reference-heading">
            <h2 id="role-reference-heading">Role reference</h2>
            <table class="admin-rule-table">
                <thead><tr><th scope="col">Role</th><th scope="col">Purpose</th><th scope="col">Permissions</th></tr></thead>
                <tbody>
                    @foreach (var role in AdminRoleCatalog.Roles)
                    {
                        <tr><td>@role.Role</td><td>@role.Description</td><td>@string.Join(", ", role.Permissions)</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
</main>

@code {
    private AdminAccessDirectory? _directory;
    private IReadOnlyCollection<AdminAccessRequestRecord> _requests = [];
    private AdminAccessRequestRecord? _selectedRequest;
    private AdminAccessAssignment? _existing;
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private bool _confirming;
    private bool _denying;
    private string _currentRole = string.Empty;
    private string _targetActorId = string.Empty;
    private string _displayLabel = string.Empty;
    private string _role = AdminAccessRoleNames.ReadOnly;
    private AdminAccessStatus _status = AdminAccessStatus.Active;
    private string _reason = string.Empty;
    private string? _message;
    private string? _error;

    private bool FormValid =>
        _targetActorId.Trim().Length is >= 2 and <= 160 &&
        _displayLabel.Trim().Length is >= 2 and <= 80 &&
        !_displayLabel.Contains('@') &&
        _reason.Trim().Length is >= 5 and <= 500;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!TryResolveIdentity(state.User, out var actorId, out _currentRole))
            {
                _directory = null;
                _error = "HIP could not bind this page to one administrator identity.";
                return;
            }

            _directory = await AccessService.GetDirectoryAsync(actorId, _currentRole, CancellationToken.None);
            _requests = await RequestService.ListPendingAsync(actorId, _currentRole, CancellationToken.None);
        }
        catch
        {
            _directory = null;
            _error = "HIP could not load administrator access right now.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginRequestReview(AdminAccessRequestRecord request)
    {
        _selectedRequest = request;
        _existing = null;
        _targetActorId = request.ActorId;
        _displayLabel = request.DisplayLabel;
        _role = AdminAccessRoleNames.ReadOnly;
        _status = AdminAccessStatus.Active;
        _reason = string.Empty;
        _editing = true;
        _confirming = false;
        _denying = false;
        _message = null;
        _error = null;
    }
    private void BeginEdit(AdminAccessAssignment assignment)
    {
        _selectedRequest = null;
        _existing = assignment;
        _targetActorId = assignment.ActorId;
        _displayLabel = assignment.DisplayLabel;
        _role = assignment.Role;
        _status = assignment.Status;
        _reason = string.Empty;
        _editing = true;
        _confirming = false;
        _denying = false;
        _message = null;
        _error = null;
    }

    private void ReviewDenial()
    {
        if (_selectedRequest is null || !FormValid)
        {
            _error = "Enter a privacy-safe decision reason before reviewing the denial.";
            return;
        }

        _editing = false;
        _confirming = false;
        _denying = true;
        _error = null;
    }
    private void ReviewChange()
    {
        if (!FormValid)
        {
            _error = "Complete every field with privacy-safe values before reviewing the change.";
            return;
        }

        _editing = false;
        _confirming = true;
        _denying = false;
        _error = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _confirming = false;
        _denying = false;
    }

    private void CancelConfirmation()
    {
        _confirming = false;
        _denying = false;
        _editing = true;
    }

    private async Task DenyAsync()
    {
        if (_selectedRequest is null || !FormValid)
        {
            return;
        }

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!TryResolveIdentity(state.User, out var actorId, out _currentRole))
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            var access = await HipAdminPageAccess.ExecuteAuthorizedAsync(
                state.User,
                AuthorizationService,
                HostEnvironment,
                [AdminPolicies.CanManageAdmins],
                (authenticatedActorId, cancellationToken) => RequestService.DenyAsync(
                    authenticatedActorId,
                    _currentRole,
                    _selectedRequest.ActorId,
                    _selectedRequest.Version,
                    _reason.Trim(),
                    cancellationToken),
                CancellationToken.None);
            if (!access.Succeeded || access.Value is null)
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            var result = access.Value;
            if (result.Status == AdminAccessRequestMutationStatus.Saved)
            {
                _requests = await RequestService.ListPendingAsync(actorId, _currentRole, CancellationToken.None);
                _selectedRequest = null;
                _message = result.Message;
                _editing = false;
                _denying = false;
            }
            else
            {
                _error = result.Message;
                _denying = false;
                _editing = result.Status != AdminAccessRequestMutationStatus.Conflict;
            }
        }
        catch
        {
            _error = "HIP could not deny the access request. No authorization change was made.";
        }
        finally
        {
            _busy = false;
        }
    }
    private async Task SaveAsync()
    {
        if (_directory is null || !FormValid)
        {
            return;
        }

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!TryResolveIdentity(state.User, out var actorId, out _currentRole))
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            var request = new AdminAccessChangeRequest(
                _targetActorId.Trim(),
                _displayLabel.Trim(),
                _role,
                _status,
                _directory.Version,
                _reason.Trim());
            var access = await HipAdminPageAccess.ExecuteAuthorizedAsync(
                state.User,
                AuthorizationService,
                HostEnvironment,
                [AdminPolicies.CanManageAdmins],
                (actorId, cancellationToken) => AccessService.ChangeAsync(actorId, _currentRole, request, cancellationToken),
                CancellationToken.None);
            if (!access.Succeeded || access.Value is null)
            {
                _error = HipAdminPageAccess.AccessUnavailableMessage;
                return;
            }

            var result = access.Value;
            if (result.Status == AdminAccessChangeStatus.Saved && result.Directory is not null)
            {
                _directory = result.Directory;
                _requests = await RequestService.ListPendingAsync(actorId, _currentRole, CancellationToken.None);
                _selectedRequest = null;
                _message = result.Message;
                _editing = false;
                _confirming = false;
            }
            else
            {
                _directory = result.Directory ?? _directory;
                _error = result.Message;
                _confirming = false;
                _editing = result.Status != AdminAccessChangeStatus.Conflict;
            }
        }
        catch
        {
            _error = "HIP could not save administrator access. No authorization change was made.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool TryResolveIdentity(ClaimsPrincipal principal, out string actorId, out string role)
    {
        role = string.Empty;
        if (!HipAuthenticatedIdentity.TryResolveUniqueClaim(principal, HipAuthenticationClaimTypes.ActorId, out actorId))
        {
            return false;
        }

        var roles = principal.FindAll(ClaimTypes.Role)
            .Select(claim => claim.Value)
            .Where(AdminAccessRoleNames.All.Contains)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (roles.Length == 1)
        {
            role = roles[0];
            return true;
        }

        actorId = string.Empty;
        return false;
    }
}
