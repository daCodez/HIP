@inherits LayoutComponentBase
@inject NavigationManager Nav

<BrandDefs />

<div class="hip-marketing-site" data-theme="dark" data-register="plain" data-motion="full" style="background:var(--bg);color:var(--text);min-height:100vh;font-family:Satoshi,sans-serif">

  <div aria-hidden="true" class="grain"></div>
  <div class="progress-track"><div data-progress class="progress-bar"></div></div>

  <header style="position:sticky;top:0;z-index:50;background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--border)">
    <div style="max-width:1240px;margin:0 auto;padding:14px clamp(16px,3vw,32px);display:flex;align-items:center;gap:clamp(10px,1.4vw,22px)">

      <a href="/" style="display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0">
        <img src="/images/public/marketing/hip-logo.png" alt="HIP" style="height:40px;width:auto;display:block;flex-shrink:0" />
        <span data-brand-copy style="display:flex;flex-direction:column;line-height:1">
          <span style="font-size:22px;font-weight:800;letter-spacing:-.01em;color:var(--text);white-space:nowrap">HIP</span>
          <span style="font-size:9.5px;font-weight:600;letter-spacing:.06em;color:var(--muted);margin-top:5px;white-space:nowrap">Human-Interactive Protocol</span>
        </span>
      </a>

      <select data-nav-compact aria-label="Marketing page" style="display:none;flex-shrink:0;padding:8px 10px;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:9px;font-size:14px;font-weight:600;cursor:pointer">
        @foreach (var (href, label) in NavItems)
        {
          <option value="@href" selected="@(Current == href)">@label</option>
        }
      </select>

      <nav data-nav-full style="display:flex;align-items:center;gap:2px;margin-left:4px;flex-shrink:0">
        @foreach (var (href, label) in NavItems.Skip(1))
        {
          <a href="@href" data-h="h-elev" style="padding:8px 10px;border-radius:8px;font-size:14.5px;font-weight:500;white-space:nowrap;text-decoration:none;color:@(Current == href ? "var(--text)" : "var(--muted)")">@label</a>
        }
      </nav>

      <div style="flex:1"></div>

      <button data-theme-toggle type="button" title="Toggle theme" data-h="h-bd-fg" style="width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--border);background:var(--surface);border-radius:9px;cursor:pointer;color:var(--muted);flex-shrink:0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6.3 6.3L4.9 4.9M19.1 19.1l-1.4-1.4M17.7 6.3l1.4-1.4M4.9 19.1l1.4-1.4"></path><circle cx="12" cy="12" r="4.2"></circle></svg>
      </button>

      <a data-github-link href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer" data-h="h-bd-nu" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--border);background:var(--surface);border-radius:9px;font-size:14px;font-weight:600;color:var(--text);text-decoration:none;flex-shrink:0">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 00-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.14.46.55.38A8 8 0 008 0z"></path></svg>
        <span data-gh-label>GitHub</span>
      </a>

      <a data-domain-cta href="/website-trust-scanner" data-h="h-bright" style="padding:10px 16px;background:var(--action);color:var(--action-ink);border-radius:9px;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;flex-shrink:0">Scan a website</a>
    </div>
  </header>

  @Body

  <SiteFooter />

</div>

@if (IsCanonicalPublicHost)
{
  <div data-hip-badge="guardwithhip.com"></div>
  <script src="/api/v1/badge/guardwithhip.com/script" async></script>
}

@code {
    private static readonly (string Href, string Label)[] NavItems =
    {
        ("/", "Home"),
        ("/website-trust-scanner", "Scanner"),
        ("/platform", "Platform"),
        ("/tools/lookalike-detector", "Lookalikes"),
        ("/browser-extension", "Extension"),
        ("/domain-verification", "Verification"),
        ("/methodology", "Methodology")
    };

    private string Current => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0].Split('?')[0].TrimEnd('/');

    private bool IsCanonicalPublicHost =>
        Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri) &&
        uri.Host.Equals("guardwithhip.com", StringComparison.OrdinalIgnoreCase);
}
