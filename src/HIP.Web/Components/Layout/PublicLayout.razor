@inherits LayoutComponentBase
@inject HipPortalLinks PortalLinks
@inject NavigationManager Navigation

@if (IsMarketingRoute)
{
    <div class="hip-reference-page">
        @Body
    </div>
}
else
{
<div class="public-site-shell">
    <a class="public-skip-link" href="#main-content">Skip to content</a>
    <header class="public-header">
        <a class="public-brand" href="/" aria-label="HIP home">
            <img src="/hip-logo.svg?v=87b1fcee" alt="" width="40" height="40" />
            <span><strong>HIP</strong><small>Human-Interactive Protocol</small></span>
        </a>

        <nav class="public-navigation public-navigation-wide" aria-label="Main navigation">
            <a href="/platform">Platform</a>
            <a href="/how-it-works">How it works</a>
            <a href="/verification">Verification</a>
            <a href="/developers">Developers</a>
            <a href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="public-cta" href="/lookup">Check my domain</a>
        </nav>

        <details class="public-menu">
            <summary>Menu</summary>
            <nav class="public-navigation" aria-label="Mobile navigation">
                <a href="/platform">Platform</a>
                <a href="/how-it-works">How it works</a>
                <a href="/verification">Verification</a>
                <a href="/developers">Developers</a>
                <a href="https://github.com/daCodez/HIP" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="/lookup">Check my domain</a>
            </nav>
        </details>
    </header>

    <div id="main-content" class="public-content">
        @Body
    </div>

    <footer class="public-footer">
        <div class="public-footer-brand">
            <img src="/hip-logo.svg?v=87b1fcee" alt="" width="34" height="34" />
            <p><strong>HIP</strong><span>Trust and identity protection.</span></p>
        </div>
        <nav aria-label="Footer navigation">
            <a href="/platform">Platform</a>
            <a href="/how-it-works">How it works</a>
            <a href="/verification">Verification</a>
            <a href="/developers">Developers</a>
            <a href="/methodology">Methodology</a>
            <a href="/signals">Signals</a>
            <a href="/score-interpretation">Score guide</a>
            <a href="/evidence-providers">Evidence providers</a>
            <a href="/lookup">Public lookup</a>
            <a href="/privacy">Privacy</a>
            <a href="/appeals">Appeals</a>
            <a href="@PortalLinks.Consumer("/")">Consumer app</a>
            <a href="@PortalLinks.Admin("/")">Admin portal</a>
        </nav>
        <p class="public-footer-note">Verification confirms control or identity evidence. It does not automatically mean safe.</p>
    </footer>
</div>
}

@if (IsCanonicalPublicHost)
{
    <div data-hip-badge="guardwithhip.com"></div>
    <script src="/api/v1/badge/guardwithhip.com/script" async></script>
}

@code {
    private static readonly HashSet<string> MarketingRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "/",
        "/platform",
        "/how",
        "/how-it-works",
        "/verify",
        "/verification",
        "/dev",
        "/developers"
    };

    private bool IsMarketingRoute
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            var normalizedPath = relativePath.Length == 0 ? "/" : $"/{relativePath}";
            return MarketingRoutes.Contains(normalizedPath);
        }
    }

    /// <summary>
    /// Limits HIP's self-badge to the exact certificate-bound public hostname so local development and alternate hosts
    /// do not render a misleading domain-mismatch state.
    /// </summary>
    private bool IsCanonicalPublicHost =>
        Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri) &&
        uri.Host.Equals("guardwithhip.com", StringComparison.OrdinalIgnoreCase);
}
