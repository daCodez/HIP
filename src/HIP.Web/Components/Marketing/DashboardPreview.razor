@using HIP.Web.Marketing.Data
@implements IDisposable
@inject MarketingRegisterState Register

<div style="background:var(--elev);border:1px solid var(--border);border-radius:22px;padding:18px;box-shadow:0 24px 70px rgba(0,0,0,.24)">
  <div style="display:flex;align-items:center;gap:14px;padding:6px 10px 18px">
    <div style="display:flex;gap:7px">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </div>
    <span style="font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--muted)">portal.hip · example.com</span>
    <span style="flex:1"></span>
    <span style="display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted)">
      <span class="pulse-dot"></span>Live
    </span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:14px">
    @foreach (var m in Metrics)
    {
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:22px">
        <div style="font-size:11px;font-weight:800;letter-spacing:.16em;color:var(--muted);margin-bottom:14px">@m.Label</div>
        <div data-count="@m.Value" style="font-family:'JetBrains Mono',monospace;font-size:34px;font-weight:800;letter-spacing:-.03em;color:var(--text);margin-bottom:8px">@m.Value</div>
        <div style="font-size:12.5px;color:@m.NoteColor">@m.Note</div>
      </div>
    }
  </div>

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;border-bottom:1px solid var(--border)">
      <span style="font-size:15px;font-weight:700;color:var(--text)">Findings</span>
      <span style="font-size:12.5px;color:var(--muted)">Illustrative rule set · example scan</span>
    </div>
    @foreach (var (f, i) in SiteData.Findings.Select((f, i) => (f, i)))
    {
      <div style="display:grid;grid-template-columns:minmax(190px,1fr) minmax(84px,150px) 106px 62px;gap:16px;align-items:center;padding:15px 20px;border-top:@(i == 0 ? "0" : "1px solid var(--hairline)")">
        <div>
          <div style="font-size:14.5px;color:var(--text);margin-bottom:4px;line-height:1.4">@f.Label</div>
          <div style="font-size:12.5px;color:var(--muted);margin-bottom:4px;line-height:1.45">@f.Explain(Register.Technical)</div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--muted)">@f.Id</div>
        </div>
        <span style="font-size:13px;color:var(--muted)">@f.Category</span>
        <span style="justify-self:start;padding:4px 11px;border-radius:999px;font-size:11.5px;font-weight:700;background:@f.StatusBg;color:@f.StatusFg">@f.Status</span>
        <span style="justify-self:end;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:@f.StatusFg">@f.Delta</span>
      </div>
    }
  </div>
</div>

@code {
    protected override void OnInitialized() => Register.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Register.Changed -= Refresh;

    private record Metric(string Label, string Value, string Note, string NoteColor);

    private static readonly Metric[] Metrics =
    {
        new("TRUST SCORE", "82", "\u2197 6 pts since last scan", "var(--ok)"),
        new("SIGNALS CHECKED", "38", "across 6 families", "var(--muted)"),
        new("NEEDS REVIEW", "2", "1 medium severity", "var(--warn)"),
        new("CERTIFICATE", "74d", "renews automatically", "var(--muted)")
    };
}
