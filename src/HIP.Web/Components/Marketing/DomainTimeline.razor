
<section data-rise style="position:relative;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div data-px="0.16" style="position:absolute;inset:-16% -3%;background:radial-gradient(700px 440px at 25% 30%,var(--tint),transparent 70%);pointer-events:none;will-change:transform"></div>

  <div style="position:relative;max-width:1240px;margin:0 auto;padding:clamp(64px,7vw,100px) clamp(16px,3vw,32px)">
    <div style="max-width:680px;margin-bottom:40px">
      <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--action);margin-bottom:14px">TIME MACHINE</div>
      <h2 data-words style="font-size:clamp(30px,3.4vw,40px);line-height:1.12;letter-spacing:-.025em;font-weight:800;margin:0 0 16px;text-wrap:balance">A domain's history is its strongest signal.</h2>
      <p style="font-size:17px;line-height:1.65;color:var(--muted);margin:0;text-wrap:pretty">Age is not proof of good behaviour — but a domain registered four days ago has no history to check, and HIP says so out loud rather than guessing.</p>
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;max-width:560px;margin-bottom:36px">
      <div style="flex:1 1 0;min-width:0;display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:0 14px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" style="flex-shrink:0"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5.5l3.5 2"></path></svg>
        <input @bind="Domain" @bind:event="oninput" placeholder="yourdomain.com" aria-label="Domain to place on the timeline"
               style="flex:1 1 0;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:15.5px;padding:14px 0;font-family:'JetBrains Mono',monospace" />
      </div>
    </div>

    <div style="background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:clamp(22px,3vw,34px)">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:30px">
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--muted);margin-bottom:8px">@CleanDomain</div>
          <div style="display:flex;align-items:baseline;gap:10px">
            <span style="font-family:'JetBrains Mono',monospace;font-size:44px;font-weight:800;letter-spacing:-.03em;line-height:1;color:@AgeFg">@AgeValue</span>
            <span style="font-size:16px;color:var(--muted)">@AgeUnit old</span>
          </div>
        </div>
        <span style="padding:6px 13px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap;background:@AgeBg;color:@AgeFg">@AgeVerdict</span>
      </div>

      <div style="position:relative;height:3px;background:var(--elev);border-radius:2px;margin:0 0 8px">
        <div style="position:absolute;left:0;top:0;height:100%;border-radius:2px;width:@(FillPercent)%;background:linear-gradient(90deg,var(--blue),var(--action))"></div>
        @foreach (var e in Events)
        {
          <span style="position:absolute;top:50%;left:@(e.Percent)%;transform:translate(-50%,-50%);width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid @e.Color"></span>
        }
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:18px;margin-top:26px">
        @foreach (var e in Events)
        {
          <div style="border-left:2px solid @e.Color;padding-left:14px">
            <div style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--muted);margin-bottom:6px">@e.When</div>
            <div style="font-size:14.5px;font-weight:700;color:var(--text);margin-bottom:4px">@e.Title</div>
            <div data-register-copy data-plain="@e.Plain" data-technical="@e.Technical" style="font-size:13px;line-height:1.5;color:var(--muted)">@e.Plain</div>
          </div>
        }
      </div>

      <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--border);font-size:13.5px;line-height:1.6;color:var(--muted)">
        Illustrative timeline generated in your browser from the name you typed — HIP does not look this domain up from this page. A real scan reads registration and certificate dates directly.
      </div>
    </div>
  </div>
</section>

@code {
    private string Domain = "northgate-bank.com";

    private record Ev(string When, string Title, string Plain, string Technical, string Color, int Percent);

    private string CleanDomain
    {
        get
        {
            var d = (Domain ?? "").Trim().ToLowerInvariant().Replace("https://", "").Replace("http://", "").TrimStart('/');
            var slash = d.IndexOf('/');
            if (slash > 0) d = d[..slash];
            return string.IsNullOrWhiteSpace(d) ? "yourdomain.com" : d;
        }
    }

    /// <summary>Stable pseudo-age so the same name always tells the same story.</summary>
    private int AgeDays
    {
        get
        {
            unchecked
            {
                var h = 17;
                foreach (var c in CleanDomain) h = h * 31 + c;
                var v = Math.Abs(h);
                // Short names with a hyphen skew young — the pattern attackers actually use.
                var ceiling = CleanDomain.Contains('-') ? 900 : 6200;
                return 3 + v % ceiling;
            }
        }
    }

    private DateTime Registered => DateTime.Today.AddDays(-AgeDays);

    private string AgeValue => AgeDays >= 365 ? (AgeDays / 365).ToString() : AgeDays.ToString();
    private string AgeUnit => AgeDays >= 365 ? (AgeDays / 365 == 1 ? "year" : "years") : (AgeDays == 1 ? "day" : "days");

    private string AgeVerdict => AgeDays < 30
        ? "No history to check"
        : AgeDays < 365
            ? "Limited history"
            : AgeDays < 1095
                ? "Some history"
                : "Established";

    private Tone AgeTone => AgeDays < 30 ? Tone.Risk : AgeDays < 365 ? Tone.Warn : Tone.Ok;

    private string AgeFg => ToneColors.Fg(AgeTone);
    private string AgeBg => ToneColors.Bg(AgeTone);

    private int FillPercent => Math.Clamp((int)(Math.Log10(Math.Max(3, AgeDays)) / Math.Log10(6200) * 100), 6, 100);

    private List<Ev> Events => new()
    {
        new(Registered.ToString("d MMM yyyy"), "Domain registered",
            AgeDays < 30 ? "Days before this page appeared — nothing about it can be corroborated yet." : "The clock on this domain's reputation started here.",
            $"whois.created = {Registered:yyyy-MM-dd} \u00b7 age {AgeDays}d", AgeFg, 0),

        new(Registered.AddDays(Math.Min(2, AgeDays)).ToString("d MMM yyyy"), "Certificate first issued",
            "A certificate proves the connection is private. It does not prove who is behind it.",
            "x509.notBefore \u00b7 issuer chain validated", ToneColors.Fg(Tone.Ok), Math.Min(18, FillPercent)),

        new(DateTime.Today.AddDays(-Math.Min(AgeDays, 90)).ToString("d MMM yyyy"), "First seen by HIP",
            "The first time this domain appeared in a scan, giving HIP its own record to compare against.",
            "hip.first_seen \u00b7 illustrative rule set", ToneColors.Fg(Tone.Ok), Math.Max(30, FillPercent - 25)),

        new("Today", "Most recent scan",
            "Scores describe one moment. This one is current — anything older is shown with its date.",
            "hip.last_scan \u00b7 illustrative rule set", "var(--action)", 100)
    };

}
