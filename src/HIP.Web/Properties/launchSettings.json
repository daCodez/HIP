{
  "$schema": "https://json.schemastore.org/launchsettings.json",
    "profiles": {
      "http": {
        "commandName": "Project",
        "hotReloadEnabled": false,
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "applicationUrl": "http://localhost:5123",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "https": {
        "commandName": "Project",
        "hotReloadEnabled": false,
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "applicationUrl": "https://localhost:7053;http://localhost:5123",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "maintenance": {
        "commandName": "Project",
        "hotReloadEnabled": false,
        "dotnetRunMessages": false,
        "launchBrowser": false,
        "commandLineArgs": "--maintenance=consumer-history-owner-index-backfill --confirm=APPLY-CONSUMER-HISTORY-OWNER-INDEX",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "DOTNET_ENVIRONMENT": "Development"
        }
      }
    }
  }
