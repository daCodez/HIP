{$HIP_PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @consumerPortal path /consumer /consumer/*
    redir @consumerPortal https://{$HIP_CONSUMER_HOST}{uri} 302

    @adminPortal path /admin /admin/*
    redir @adminPortal https://{$HIP_ADMIN_HOST}{uri} 302

    @publicRoot path /
    redir @publicRoot /lookup 302

    reverse_proxy web:8080 {
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
        header_up -X-HIP-Trusted-Staging-Proxy
    }
}

{$HIP_CONSUMER_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @adminPortal path /admin /admin/*
    redir @adminPortal https://{$HIP_ADMIN_HOST}{uri} 302

    @publicExperience path /lookup /lookup/* /certificate /certificate/* /access /access/* /safety /safety/*
    redir @publicExperience https://{$HIP_PUBLIC_HOST}{uri} 302

    @portalRoot path /
    redir @portalRoot /consumer 302

    reverse_proxy consumer-web:8080 {
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
        header_up -X-HIP-Trusted-Staging-Proxy
    }
}

{$HIP_ADMIN_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    @consumerPortal path /consumer /consumer/*
    redir @consumerPortal https://{$HIP_CONSUMER_HOST}{uri} 302

    @publicExperience path /lookup /lookup/* /certificate /certificate/* /access /access/* /safety /safety/*
    redir @publicExperience https://{$HIP_PUBLIC_HOST}{uri} 302

    @portalRoot path /
    redir @portalRoot /admin 302

    reverse_proxy consumer-web:8080 {
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
        header_up -X-HIP-Trusted-Staging-Proxy
    }
}

{$HIP_API_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    @consumerPortal path /consumer /consumer/*
    redir @consumerPortal https://{$HIP_CONSUMER_HOST}{uri} 302

    @adminPortal path /admin /admin/*
    redir @adminPortal https://{$HIP_ADMIN_HOST}{uri} 302

    @publicExperience path /lookup /lookup/* /certificate /certificate/* /access /access/* /safety /safety/*
    redir @publicExperience https://{$HIP_PUBLIC_HOST}{uri} 302

    reverse_proxy api:8080 {
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
        header_up -X-HIP-Trusted-Staging-Proxy
    }
}

{$HIP_IDENTITY_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy keycloak:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
        header_up X-Forwarded-Host {host}
    }
}
