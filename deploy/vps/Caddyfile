    @adminUi not path /api/* /auth /auth/* /signin-oidc /signout-callback-oidc /login /forbidden /step-up /not-found /Error /_framework/* /_blazor /_blazor/* /_content/* /js/* /lib/* /*.css /*.js /favicon.png /hip-logo.svg /hip-logo-original.png
