{
    servers {
        protocols h1 h2
    }
}

www.{$HIP_PUBLIC_HOST} {
    redir https://{$HIP_PUBLIC_HOST}{uri} permanent
}

{$HIP_DNS_HOST} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    handle /dns-query {
        reverse_proxy api:8080 {
            header_up -Authorization
            header_up -Cookie
            header_up -X-HIP-API-Key
            header_up -X-HIP-Signer
            header_up -X-HIP-Instance-Id
            header_up -X-HIP-Admin-Role
            header_up -X-HIP-Admin-User
            header_up -X-HIP-Consumer-Id
            header_up -X-HIP-Trusted-Staging-Proxy
        }
    }

    handle {
        respond "HIP encrypted DNS endpoint. Use https://{$HIP_DNS_HOST}/dns-query for DNS-over-HTTPS or {$HIP_DNS_HOST}:853 for DNS-over-TLS." 200
    }
}

{$HIP_PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @verificationAlias path /verification /verify
    redir @verificationAlias /domain-verification permanent

    @howAlias path /how
    redir @howAlias /how-it-works permanent

    @developersAlias path /dev
    redir @developersAlias /developers permanent

    @legacyConsumerPortal path_regexp legacyConsumerPortal ^/consumer(?:/(.*))?$
    redir @legacyConsumerPortal https://{$HIP_CONSUMER_HOST}/{re.legacyConsumerPortal.1} 302

    @legacyAdminPortal path_regexp legacyAdminPortal ^/admin(?:/(.*))?$
    redir @legacyAdminPortal https://{$HIP_ADMIN_HOST}/{re.legacyAdminPortal.1} 302

    reverse_proxy web:8080 {
        header_up X-HIP-Trusted-Staging-Proxy {$HIP_DEVELOPMENT_PROXY_SECRET}
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
    }
}

{$HIP_CONSUMER_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @legacyConsumerPortal path_regexp legacyConsumerPortal ^/consumer(?:/(.*))?$
    redir @legacyConsumerPortal https://{$HIP_CONSUMER_HOST}/{re.legacyConsumerPortal.1} 302

    @legacyAdminPortal path_regexp legacyAdminPortal ^/admin(?:/(.*))?$
    redir @legacyAdminPortal https://{$HIP_ADMIN_HOST}/{re.legacyAdminPortal.1} 302

    @publicExperience path /platform /how /how-it-works /verify /verification /dev /developers /lookup /lookup/* /certificate /certificate/* /access /access/* /safety /safety/*
    redir @publicExperience https://{$HIP_PUBLIC_HOST}{uri} 302

    @consumerUi not path /api/* /auth /auth/* /signin-oidc /signout-callback-oidc /login /forbidden /step-up /not-found /Error /_framework/* /_blazor /_blazor/* /_content/* /js/* /lib/* /*.css /*.js /favicon.png /hip-logo.svg /hip-logo-original.png
    rewrite @consumerUi /consumer{uri}

    reverse_proxy consumer-web:8080 {
        header_up -X-HIP-Admin-Role
        header_up -X-HIP-Admin-User
        header_up -X-HIP-Consumer-Id
        header_up -X-HIP-Trusted-Staging-Proxy
    }
}

